{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shanforge.local/schemas/design-artifact-manifest.schema.json",
  "title": "DesignArtifactManifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "id",
    "title",
    "status",
    "document_id",
    "source",
    "pages",
    "components",
    "tokens_file",
    "exports"
  ],
  "properties": {
    "schema_id": {
      "const": "DesignArtifactManifest/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^DESIGN-ASSET-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "awaiting_penpot_connection",
        "draft",
        "ready",
        "deprecated"
      ]
    },
    "document_id": {
      "type": "string",
      "pattern": "^DESIGN-[A-Z0-9-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "file",
        "connection_required"
      ],
      "properties": {
        "format": {
          "const": "penpot"
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))design/ux-ui/[A-Za-z0-9._/-]+\\.penpot$"
        },
        "connection_required": {
          "type": "boolean"
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "tokens_file": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))design/ux-ui/[A-Za-z0-9._/-]+\\.json$"
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/export"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting_penpot_connection"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "file": {
                "const": null
              },
              "connection_required": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "deprecated"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))design/ux-ui/[A-Za-z0-9._/-]+\\.penpot$"
              },
              "connection_required": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UI-PAGE-[A-Z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "purpose",
        "states"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UI-COMPONENT-[A-Z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "default",
              "loading",
              "empty",
              "error",
              "disabled",
              "focus",
              "hover",
              "pressed",
              "success",
              "blocked"
            ]
          }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "subject_id",
        "file",
        "format",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "page",
            "component",
            "asset"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))design/ux-ui/exports/[A-Za-z0-9._/-]+$"
        },
        "format": {
          "enum": [
            "svg",
            "png",
            "webp",
            "pdf"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
