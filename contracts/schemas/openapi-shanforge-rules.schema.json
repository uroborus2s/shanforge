{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shanforge.local/schemas/openapi-shanforge-rules.schema.json",
  "title": "OpenAPIShanforgeOperationRules/v1",
  "description": "Shanforge OpenAPI operation 扩展字段的稳定规则。",
  "type": "object",
  "required": [
    "operationId",
    "summary",
    "description",
    "responses",
    "x-shanforge-id",
    "x-shanforge-requirements",
    "x-shanforge-tests",
    "x-shanforge-owner"
  ],
  "properties": {
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "[\\u3400-\\u9fff]"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "allOf": [
        {
          "pattern": "[\\u3400-\\u9fff]"
        },
        {
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        }
      ]
    },
    "responses": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {
        "pattern": "^(?:[1-5][0-9]{2}|default)$"
      },
      "allOf": [
        {
          "not": {
            "propertyNames": {
              "not": {
                "pattern": "^[23][0-9]{2}$"
              }
            }
          }
        },
        {
          "not": {
            "propertyNames": {
              "not": {
                "pattern": "^[45][0-9]{2}$"
              }
            }
          }
        }
      ]
    },
    "x-shanforge-id": {
      "type": "string",
      "pattern": "^API-[A-Z0-9-]+$"
    },
    "x-shanforge-requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(REQ|NFR)-[A-Z0-9-]+$"
      }
    },
    "x-shanforge-tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TEST-[A-Z0-9-]+$"
      }
    },
    "x-shanforge-owner": {
      "type": "string",
      "minLength": 1
    }
  }
}
