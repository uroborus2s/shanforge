{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shanforge.local/schemas/test-case-catalog.schema.json",
  "title": "TestCaseCatalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "id", "title", "version", "status", "cases"],
  "properties": {
    "schema_id": {"const": "TestCaseCatalog/v1"},
    "id": {"type": "string", "pattern": "^TEST-CATALOG-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1, "pattern": "[\\u3400-\\u9fff]"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "active", "deprecated", "retired"]},
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "acceptance_criteria",
        "designs",
        "ui_pages",
        "api_operations",
        "tasks"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(REQ|NFR)-[A-Z0-9-]+$"}
        },
        "acceptance_criteria": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(REQ|NFR)-[A-Z0-9-]+-AC-[0-9]+$"}
        },
        "designs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^DESIGN-[A-Z0-9-]+$"}
        },
        "ui_pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^UI-PAGE-[A-Z0-9-]+$"}
        },
        "api_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^API-[A-Z0-9-]+$"}
        },
        "tasks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9]+)+$"}
        }
      },
      "anyOf": [
        {"properties": {"acceptance_criteria": {"minItems": 1}}},
        {"properties": {"designs": {"minItems": 1}}},
        {"properties": {"ui_pages": {"minItems": 1}}},
        {"properties": {"api_operations": {"minItems": 1}}},
        {"properties": {"tasks": {"minItems": 1}}}
      ]
    },
    "test_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "sensitive"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {
          "anyOf": [
            {"type": ["string", "number", "boolean", "null"]},
            {"type": "object"}
          ]
        },
        "sensitive": {"type": "boolean"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "expected"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1}
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entrypoint"],
      "properties": {
        "status": {"enum": ["manual", "planned", "automated", "partial"]},
        "entrypoint": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"enum": ["automated", "partial"]}},
            "required": ["status"]
          },
          "then": {
            "properties": {"entrypoint": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "definition_status",
        "objective",
        "type",
        "level",
        "priority",
        "risk",
        "owner",
        "traceability",
        "preconditions",
        "test_data",
        "steps",
        "postconditions",
        "environment",
        "automation",
        "tags"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^TEST-[A-Z0-9-]+$"},
        "version": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1, "pattern": "[\\u3400-\\u9fff]"},
        "definition_status": {"enum": ["draft", "active", "deprecated", "retired"]},
        "objective": {"type": "string", "minLength": 1, "pattern": "[\\u3400-\\u9fff]"},
        "type": {
          "enum": [
            "unit",
            "contract",
            "integration",
            "system",
            "acceptance",
            "usability",
            "accessibility",
            "security",
            "performance",
            "regression"
          ]
        },
        "level": {"enum": ["unit", "component", "integration", "system", "acceptance"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "owner": {"type": "string", "minLength": 1},
        "traceability": {"$ref": "#/$defs/traceability"},
        "preconditions": {"$ref": "#/$defs/string_array"},
        "test_data": {"type": "array", "items": {"$ref": "#/$defs/test_data"}},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "postconditions": {"$ref": "#/$defs/string_array"},
        "environment": {"type": "string", "minLength": 1},
        "automation": {"$ref": "#/$defs/automation"},
        "tags": {"$ref": "#/$defs/string_array"}
      }
    }
  }
}
