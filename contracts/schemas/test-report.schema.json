{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shanforge.local/schemas/test-report.schema.json",
  "title": "TestReport/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "id",
    "run_id",
    "title",
    "generated_at",
    "result_refs",
    "summary"
  ],
  "properties": {
    "schema_id": {"const": "TestReport/v1"},
    "id": {"type": "string", "pattern": "^TEST-REPORT-[A-Z0-9-]+$"},
    "run_id": {"type": "string", "pattern": "^RUN-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "result_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/result_ref"}
    },
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "status": {
      "enum": ["passed", "failed", "error", "blocked", "skipped", "not_run", "cancelled"]
    },
    "result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "test_case_id", "status", "evidence_path", "sha256"],
      "properties": {
        "result_id": {"type": "string", "pattern": "^RUN-RESULT-[A-Z0-9-]+$"},
        "test_case_id": {"type": "string", "pattern": "^TEST-[A-Z0-9-]+$"},
        "status": {"$ref": "#/$defs/status"},
        "evidence_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "error",
        "blocked",
        "skipped",
        "not_run",
        "cancelled"
      ],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "not_run": {"type": "integer", "minimum": 0},
        "cancelled": {"type": "integer", "minimum": 0}
      }
    }
  }
}
