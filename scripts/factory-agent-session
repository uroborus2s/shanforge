#!/usr/bin/env python3

import argparse
import json
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    CLOSED_STATUSES,
    active_roles_for_stage,
    collect_items,
    file_readiness,
    inspect_project_lock,
    latest_dir_id,
    load_project_config,
    project_lock,
    read_recent_log_lines,
    read_risks,
    refresh_ai_memory,
    save_project_config,
    stage_reference_docs,
    tech_required_skill_records,
    write_text,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="生成给 Codex / Gemini 会话直接读取的项目会话入口。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--owner", default="会话协调者", help="会话负责人。")
    parser.add_argument("--focus", default="", help="当前会话焦点。")
    parser.add_argument("--top", type=int, default=5, help="展示的重点条目数量。")
    parser.add_argument("--skip-refresh-memory", action="store_true", help="跳过会话前的 AI 记忆刷新。")
    return parser.parse_args()


def relative_strings(project_root: Path, paths: list[Path]) -> list[str]:
    result: list[str] = []
    for path in paths:
        try:
            result.append(str(path.relative_to(project_root)))
        except Exception:
            result.append(str(path))
    return result


def recommended_reads(project_root: Path, stage: str) -> list[str]:
    fixed = [
        ".factory/memory/runtime-brief.md",
        ".factory/memory/role-charter.project.md",
        ".factory/project.json",
        ".factory/memory/current-state.md",
        ".factory/memory/motivation-state.md",
        ".factory/memory/autonomy-rules.md",
        ".factory/memory/evolution-baseline.md",
        ".factory/memory/tech-stack.summary.md",
        ".factory/memory/design-assets.summary.md",
        ".factory/memory/tasks.summary.md",
    ]
    stage_docs = stage_reference_docs(stage)
    ordered = fixed + stage_docs
    seen = set()
    result = []
    for relative in ordered:
        if relative in seen:
            continue
        seen.add(relative)
        if (project_root / relative).exists():
            result.append(relative)
    return result


def recommended_commands(project_root: Path, stage: str, owner: str, focus: str, blocked_count: int) -> list[str]:
    root = str(project_root)
    commands = [
        f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch board --project "{root}" --owner "{owner}" --focus "{focus.strip() or "刷新角色协作视图"}"'
    ]
    if stage == "BRAINSTORM":
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch prd-bootstrap --project "{root}" --owner "{owner}"'
        )
    if stage in {"REQUIREMENTS", "ANALYSIS"}:
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch requirements-verify --project "{root}" --owner "{owner}"'
        )
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch design --project "{root}" --owner "{owner}"'
        )
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch tech --project "{root}" --owner "{owner}"'
        )
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch doc --project "{root}" --doc docs/02-requirements/prd.md --summary "补充需求细节"'
        )
    if stage == "DESIGN":
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch tech --project "{root}" --preset stratix-admin --owner "{owner}"'
        )
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch design-assets --project "{root}" --title "关键页面参考图" --images "/absolute/path/to/mockup.png" --owner "{owner}"'
        )
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch plan --project "{root}" --iteration "迭代 1" --owner "{owner}" --create-items'
        )
    if stage in {"PLAN", "IMPLEMENTATION"}:
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch run --project "{root}" --item TASK-001 --work-block WB-001-01 --status 进行中 --owner "{owner}"'
        )
    if stage in {"TESTING", "ACCEPTANCE"}:
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch workflow --project "{root}" --workflow pre_gate --owner "{owner}"'
        )
    if stage in {"RELEASE", "MAINTENANCE"}:
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch release --project "{root}" --owner "{owner}"'
        )
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch handover --project "{root}" --owner "{owner}"'
        )
    if blocked_count:
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch risk --project "{root}" --title "处理阻塞项" --owner "{owner}"'
        )
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch recovery --project "{root}" --owner "{owner}"'
        )
    commands.append(
        f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch motivation --project "{root}" --owner "{owner}" --focus "{focus.strip() or "维持当前推进节奏"}"'
    )
    commands.append(
        f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch evolution --project "{root}" --owner "{owner}" --note "{focus.strip() or "刷新项目最佳实践"}"'
    )
    commands.append(
        f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch memory --project "{root}"'
    )
    commands.append(
        f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch chat --project "{root}" --tool generic --role coordinator --owner "{owner}" --focus "{focus.strip() or "继续当前工作"}"'
    )
    if focus.strip():
        commands.append(
            f'python3 /Users/uroborus/shanforge/scripts/factory-dispatch daily --project "{root}" --owner "{owner}" --focus "{focus.strip()}"'
        )
    deduped = []
    seen = set()
    for item in commands:
        if item in seen:
            continue
        seen.add(item)
        deduped.append(item)
    return deduped[:8]


def summarize_doc_readiness(project_root: Path, stage: str) -> list[str]:
    lines = []
    for relative in stage_reference_docs(stage):
        status, reason = file_readiness(project_root / relative)
        lines.append(f"- `{relative}`：{status}，{reason}")
    return lines or ["- 当前阶段暂无额外参考文档。"]


def build_session_markdown(
    project_root: Path,
    config: dict,
    owner: str,
    focus: str,
    top: int,
    lock_info: dict,
) -> tuple[str, dict]:
    tasks = collect_items(project_root, ".factory/workitems/implementation", "TASK")
    changes = collect_items(project_root, ".factory/workitems/changes", "CR")
    bugs = collect_items(project_root, ".factory/workitems/bugs", "BUG")
    all_items = tasks + changes + bugs
    active_items = [item for item in all_items if item["status"] not in CLOSED_STATUSES]
    blocked_items = [item for item in active_items if item["status"] == "阻塞"]
    open_risks, _ = read_risks(project_root)
    recent_logs = read_recent_log_lines(project_root, max(1, top))
    stage = config.get("stage", "未知")
    stage_roles = active_roles_for_stage(config, stage)
    tech_skill_lines = [
        f"- `{item['name']}`：{item.get('purpose', '无说明')}" + (" | 当前缺失" if item.get("missing") else "")
        for item in tech_required_skill_records(config)
    ] or ["- 当前技术画像未额外要求专用 skills。"]
    reads = recommended_reads(project_root, stage)
    commands = recommended_commands(project_root, stage, owner, focus, len(blocked_items))
    doc_lines = summarize_doc_readiness(project_root, stage)
    role_lines = [
        f"- `{role['title']}` | 工具：{' / '.join(role.get('preferred_tools', [])) or '无'}"
        for role in stage_roles[:top]
    ] or ["- 当前没有明确的阶段角色。"]

    recent_active = [
        f"- `{item['id']}` {item['title']} | 状态：{item['status']} | 负责人：{item['owner']}"
        for item in active_items[:top]
    ] or ["- 当前无活跃工作项。"]
    blocked_lines = [
        f"- `{item['id']}` {item['title']} | 负责人：{item['owner']}" for item in blocked_items[:top]
    ] or ["- 当前无阻塞工作项。"]
    risk_lines = open_risks[:top] or ["- 当前无开放风险。"]
    log_lines = recent_logs[:3] or ["- 暂无最近执行记录。"]
    read_lines = [f"- `{item}`" for item in reads] or ["- 无"]
    command_lines = [f"- `{item}`" for item in commands[:5]] or ["- 无"]
    lock_payload = lock_info.get("payload", {})
    lock_line = (
        f"- 当前存在项目锁：原因={lock_payload.get('reason', '无')}，时间={lock_payload.get('locked_at', '无')}"
        if lock_info.get("locked")
        else "- 当前无项目锁。"
    )

    lines = [
        "# Agent 会话卡",
        "",
        f"- 生成时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 会话负责人：{owner}",
        f"- 项目名称：{config.get('project_name', '未命名项目')}",
        f"- 当前阶段：{stage}",
        f"- 当前模式：{config.get('active_mode', '未知')}",
        f"- 当前焦点：{focus or '无'}",
        f"- 活跃工作项：{len(active_items)}",
        f"- 阻塞项：{len(blocked_items)}",
        f"- 开放风险：{len(open_risks)}",
        f"- 最近发布包：{latest_dir_id(project_root, 'releases', 'REL-')}",
        f"- 最近交接包：{latest_dir_id(project_root, 'handover', 'HO-')}",
        f"- 最近快照：{latest_dir_id(project_root, 'snapshots', 'SNAP-')}",
        "",
        "## 先读",
        "",
        *read_lines,
        "",
        "## 当前角色与规则",
        "",
        *role_lines,
        *tech_skill_lines,
        "- 当前默认补充读取：`.factory/memory/motivation-state.md`、`.factory/memory/autonomy-rules.md`、`.factory/memory/evolution-baseline.md`",
        lock_line,
        "",
        "## 当前关注项",
        "",
        *recent_active,
        *blocked_lines,
        *risk_lines,
        "",
        "## 阶段文档就绪度",
        "",
        *doc_lines,
        "",
        "## 最近记录",
        "",
        *log_lines,
        "",
        "## 下一步命令",
        "",
        *command_lines,
    ]

    payload = {
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "owner": owner,
        "project_name": config.get("project_name", "未命名项目"),
        "stage": stage,
        "active_mode": config.get("active_mode", "未知"),
        "focus": focus or "",
        "reads": reads,
        "recommended_commands": commands,
        "active_items": [item["id"] for item in active_items[:top]],
        "blocked_items": [item["id"] for item in blocked_items[:top]],
        "open_risks": risk_lines,
        "recent_logs": log_lines,
        "lock": lock_info,
    }
    return "\n".join(lines).rstrip() + "\n", payload


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    lock_info = inspect_project_lock(project_root)

    try:
        with project_lock(project_root, reason="生成 agent session"):
            if not args.skip_refresh_memory:
                refresh_ai_memory(project_root)
            config = load_project_config(project_root)
            session_markdown, payload = build_session_markdown(
                project_root,
                config,
                args.owner.strip(),
                args.focus.strip(),
                max(1, args.top),
                lock_info,
            )

            write_text(project_root / ".factory" / "memory" / "agent-session.md", session_markdown)
            write_text(
                project_root / ".factory" / "agent-session.json",
                json.dumps(payload, ensure_ascii=False, indent=2),
            )

            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_agent_session_at"] = now_text
            config["last_agent_session_owner"] = args.owner.strip()
            config["last_agent_session_focus"] = args.focus.strip()
            save_project_config(project_root, config)
    except Exception as exc:
        print(f"生成 agent session 失败：{exc}", file=sys.stderr)
        return 1

    print(f"已生成 agent session：{project_root / '.factory' / 'memory' / 'agent-session.md'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
