#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import append_log_line, load_project_config, parse_list, project_lock, run_script, save_project_config


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="在工作项更新后自动完成同步、关单、日报和快照。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--item", required=True, help="工作项编号，例如 CR-001、BUG-001、TASK-001。")
    parser.add_argument("--owner", default="待记录", help="发起人。")
    parser.add_argument("--docs", default="", help="关联文档，逗号分隔。")
    parser.add_argument("--tests", default="", help="关联测试，逗号分隔。")
    parser.add_argument("--code", default="", help="关联代码文件，逗号分隔。")
    parser.add_argument("--summary", default="", help="本次自动同步总结。")
    parser.add_argument("--status", default="已同步", help="同步状态。")
    parser.add_argument("--close", action="store_true", help="同步后自动关单。")
    parser.add_argument("--result", default="已完成", help="关单结果。")
    parser.add_argument("--daily-focus", default="", help="若传入则自动生成每日报告。")
    parser.add_argument("--snapshot", action="store_true", help="同步后自动生成项目快照。")
    parser.add_argument("--note", default="", help="补充说明。")
    return parser.parse_args()
def build_steps(project_root: Path, args: argparse.Namespace) -> list[tuple[str, list[str], str]]:
    project = str(project_root)
    steps: list[tuple[str, list[str], str]] = []
    item = args.item.strip()
    docs = ",".join(parse_list(args.docs))
    tests = ",".join(parse_list(args.tests))
    code = ",".join(parse_list(args.code))
    note = args.note.strip() or args.summary.strip() or "workflow-runner: auto-sync"

    if item.startswith("CR-") or item.startswith("BUG-"):
        steps.append(
            (
                "factory-sync-change",
                [
                    "--project",
                    project,
                    "--item",
                    item,
                    "--docs",
                    docs,
                    "--tests",
                    tests,
                    "--code",
                    code,
                    "--note",
                    note,
                    "--status",
                    args.status.strip(),
                ],
                "同步变更",
            )
        )

    if args.close:
        steps.append(
            (
                "factory-close-workitem",
                [
                    "--project",
                    project,
                    "--item",
                    item,
                    "--result",
                    args.result.strip(),
                    "--owner",
                    args.owner.strip(),
                    "--summary",
                    args.summary.strip() or note,
                    "--docs",
                    docs,
                    "--tests",
                    tests,
                    "--code",
                    code,
                    "--note",
                    note,
                ],
                "关闭工作项",
            )
        )

    steps.append(("factory-refresh-memory", ["--project", project], "刷新 AI 记忆"))

    if args.daily_focus.strip():
        steps.append(
            (
                "factory-daily-status",
                [
                    "--project",
                    project,
                    "--owner",
                    args.owner.strip(),
                    "--focus",
                    args.daily_focus.strip(),
                ],
                "生成每日报告",
            )
        )

    if args.snapshot:
        steps.append(
            (
                "factory-project-snapshot",
                [
                    "--project",
                    project,
                    "--owner",
                    args.owner.strip(),
                    "--note",
                    args.note.strip() or f"auto-sync after {item}",
                ],
                "生成项目快照",
            )
        )

    return steps


def write_report(path: Path, item: str, owner: str, result: str, steps: list[dict], history_line: str) -> None:
    if path.exists():
        lines = path.read_text(encoding="utf-8").splitlines()
    else:
        lines = ["# 自动同步记录", ""]

    latest_lines = [
        f"- 工作项：{item}",
        f"- 自动同步结果：{result}",
        f"- 发起人：{owner}",
        f"- 运行时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
    ]
    step_lines = []
    for step in steps:
        step_lines.append(f"- {step['label']}：{'成功' if step['returncode'] == 0 else f'失败({step['returncode']})'}")
        if step["stdout"]:
            step_lines.append(f"  输出：{step['stdout']}")
        if step["stderr"]:
            step_lines.append(f"  错误：{step['stderr']}")

    sections = {
        "## 最新运行": latest_lines,
        "## 步骤结果": step_lines or ["- 无"],
    }
    for header, content in sections.items():
        if header in lines:
            start = lines.index(header)
            end = len(lines)
            for index in range(start + 1, len(lines)):
                if lines[index].startswith("## "):
                    end = index
                    break
            lines = lines[: start + 1] + [""] + content + [""] + lines[end:]
        else:
            if lines and lines[-1] != "":
                lines.append("")
            lines.extend([header, "", *content, ""])

    history_header = "## 历史运行记录"
    if history_header in lines:
        start = lines.index(history_header)
        insert_at = start + 2 if start + 1 < len(lines) and lines[start + 1] == "" else start + 1
        if history_line not in lines:
            lines.insert(insert_at, history_line)
    else:
        if lines and lines[-1] != "":
            lines.append("")
        lines.extend([history_header, "", history_line, ""])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def write_summary(path: Path, item: str, result: str, steps: list[dict]) -> None:
    lines = [
        "# 自动同步摘要",
        "",
        f"- 工作项：{item}",
        f"- 结果：{result}",
        f"- 运行时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        "",
        "## 步骤结果",
        "",
    ]
    for step in steps:
        lines.append(f"- {step['label']}：{'成功' if step['returncode'] == 0 else f'失败({step['returncode']})'}")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    today = datetime.now().strftime("%Y-%m-%d")

    try:
        with project_lock(project_root, reason=f"自动同步 {args.item.strip()}"):
            load_project_config(project_root)
            steps = [run_script(script_name, *command_args, label=label) for script_name, command_args, label in build_steps(project_root, args)]
            result = "完成" if all(step["returncode"] == 0 for step in steps) else "失败"
            history_line = f"- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: 自动同步 `{args.item.strip()}`，结果：{result}，发起人：{args.owner.strip()}。"

            write_report(
                project_root / ".factory" / "process" / "auto-sync.md",
                item=args.item.strip(),
                owner=args.owner.strip(),
                result=result,
                steps=steps,
                history_line=history_line,
            )
            write_summary(project_root / ".factory" / "memory" / "auto-sync.summary.md", args.item.strip(), result, steps)

            config = load_project_config(project_root)
            config.setdefault("auto_sync_history", []).append(
                {
                    "item": args.item.strip(),
                    "result": result,
                    "owner": args.owner.strip(),
                    "ran_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                }
            )
            config["last_auto_sync_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_auto_sync_item"] = args.item.strip()
            save_project_config(project_root, config)

            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {today}: 自动同步 `{args.item.strip()}`，结果：{result}，发起人：{args.owner.strip()}。",
            )
    except Exception as exc:
        print(f"自动同步失败：{exc}", file=sys.stderr)
        return 1

    print(f"已自动同步：{args.item.strip()} -> {result}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
