#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import append_log_line, find_item_file, parse_list, project_lock, refresh_ai_memory, replace_section


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="记录工作项的影响分析，并同步到变更文档与 AI 记忆。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--item", required=True, help="工作项编号，例如 CR-001、BUG-001、TASK-001。")
    parser.add_argument("--summary", default="", help="影响分析结论。")
    parser.add_argument("--docs", default="", help="受影响文档，逗号分隔。")
    parser.add_argument("--code", default="", help="受影响代码文件，逗号分隔。")
    parser.add_argument("--tests", default="", help="受影响测试文件或测试项，逗号分隔。")
    parser.add_argument("--memory", default="", help="受影响的 AI 记忆文件，逗号分隔。")
    parser.add_argument("--risks", default="", help="主要风险说明。")
    parser.add_argument("--owner", default="待记录", help="分析人。")
    parser.add_argument("--status", default="已分析", help="分析状态。")
    return parser.parse_args()
def upsert_record_section(path: Path, item_id: str, summary: str, status: str, owner: str) -> None:
    header = "## 影响分析记录"
    line = (
        f"- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: `{item_id}` 完成影响分析，状态：`{status}`，"
        f"分析人：{owner}，结论：{summary or '无'}"
    )
    lines = path.read_text(encoding="utf-8").splitlines()
    if header in lines:
        start = lines.index(header)
        insert_at = start + 2 if start + 1 < len(lines) and lines[start + 1] == "" else start + 1
        lines.insert(insert_at, line)
    else:
        try:
            before_header = lines.index("## 完成定义")
        except ValueError:
            before_header = len(lines)
        block = [header, "", line, ""]
        lines = lines[:before_header] + block + lines[before_header:]
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")
def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    docs = parse_list(args.docs)
    code = parse_list(args.code)
    tests = parse_list(args.tests)
    memory = parse_list(args.memory)
    today = datetime.now().strftime("%Y-%m-%d")
    now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    try:
        with project_lock(project_root, reason=f"更新影响分析 {args.item.strip()}"):
            item_id = args.item.strip()
            item_file = find_item_file(project_root, item_id)
            replace_section(
                item_file,
                "## 影响范围",
                [
                    f"- 分析结论：{args.summary.strip() or '无'}",
                    f"- 状态：{args.status.strip()}",
                    f"- 分析人：{args.owner.strip()}",
                    f"- 分析时间：{now_text}",
                    f"- 代码：{'、'.join(code) if code else '无'}",
                    f"- 文档：{'、'.join(docs) if docs else '无'}",
                    f"- 测试：{'、'.join(tests) if tests else '无'}",
                    f"- AI 记忆：{'、'.join(memory) if memory else '无'}",
                    f"- 风险：{args.risks.strip() or '无'}",
                ],
            )
            upsert_record_section(
                item_file,
                item_id=item_id,
                summary=args.summary.strip(),
                status=args.status.strip(),
                owner=args.owner.strip(),
            )
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                (
                    f"- {today}: 完成 `{item_id}` 的影响分析，文档 {len(docs)} 项，代码 {len(code)} 项，"
                    f"测试 {len(tests)} 项，AI 记忆 {len(memory)} 项。"
                ),
            )
            append_log_line(
                project_root / "docs" / "09-evolution" / "retrospective.md",
                (
                    f"- {today}: `{item_id}` 影响分析已更新，状态：{args.status.strip()}，"
                    f"风险：{args.risks.strip() or '无'}。"
                ),
            )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"更新影响分析失败：{exc}", file=sys.stderr)
        return 1

    print(f"已更新影响分析：{item_id}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
