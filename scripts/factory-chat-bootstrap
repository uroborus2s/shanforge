#!/usr/bin/env python3

import argparse
import json
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    collect_active_items,
    ensure_role_catalog,
    frontend_prompt_examples,
    group_items_by_role,
    load_project_config,
    load_frontend_profiles,
    prepend_history_entry,
    project_lock,
    refresh_ai_memory,
    resolve_frontend_profile,
    resolve_role,
    role_document_reads,
    role_recommended_commands,
    save_project_config,
    tech_required_skill_records,
    upsert_section,
    write_text,
)


def parse_args() -> argparse.Namespace:
    supported_tools = sorted(load_frontend_profiles().keys())
    parser = argparse.ArgumentParser(description="生成给 Codex / Gemini CLI 直接读取的角色化对话启动入口。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument(
        "--tool",
        default="generic",
        help=f"目标工具。支持已登记前台、其别名或 generic。当前已登记：{', '.join(supported_tools) if supported_tools else '无'}。",
    )
    parser.add_argument("--role", default="coordinator", help="要扮演的角色。")
    parser.add_argument("--owner", default="会话协调者", help="启动入口负责人。")
    parser.add_argument("--focus", default="", help="当前对话焦点。")
    parser.add_argument("--top", type=int, default=5, help="展示的重点条目数量。")
    parser.add_argument("--skip-refresh-memory", action="store_true", help="跳过启动前的 AI 记忆刷新。")
    return parser.parse_args()


def tool_label(profile: dict) -> str:
    return str(profile.get("label", "")).strip() or "通用 CLI 模型"


def primary_rule_file(profile: dict) -> str:
    files = [str(item).strip() for item in profile.get("primary_rule_files", []) if str(item).strip()]
    if not files:
        return "AGENTS.md 与 GEMINI.md"
    if len(files) == 1:
        return files[0]
    return " 与 ".join(files)


def example_prompts(role_title: str, tool: str, focus: str) -> list[str]:
    return frontend_prompt_examples(tool, role_title, focus)


def build_markdown(profile: dict, config: dict, role: dict, focus: str, reads: list[str], commands: list[str], items: list[dict]) -> str:
    item_lines = [
        f"- `{item['id']}` {item['title']} | 状态：{item['status']} | 负责人：{item['owner']}" for item in items
    ] or ["- 当前没有直接分配给该角色的活跃工作项。"]
    skill_lines = [
        f"- `{skill['name']}`：{skill.get('purpose', '无说明')} ({skill.get('path', '无路径')})"
        for skill in role.get("skills", [])
    ] or ["- 当前角色没有额外共享 skills。"]
    required_skill_lines = [
        f"- `{skill['name']}`：{skill.get('purpose', '无说明')}" + (" | 当前缺失" if skill.get("missing") else "")
        for skill in tech_required_skill_records(config, role["id"])
    ] or ["- 当前技术画像未额外要求专用 skills。"]
    read_lines = [f"- `{item}`" for item in reads] or ["- 无"]
    command_lines = [f"- `{item}`" for item in commands] or ["- 无"]
    prompt_lines = [f"- {item}" for item in example_prompts(role["title"], profile["id"], focus)]

    lines = [
        f"# {tool_label(profile)} 对话启动入口",
        "",
        f"- 生成时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 项目名称：{config.get('project_name', '未命名项目')}",
        f"- 当前阶段：{config.get('stage', '未知')}",
        f"- 角色：{role['title']}",
        f"- 焦点：{focus or '无'}",
        f"- 优先规则文件：{primary_rule_file(profile)}",
        "",
        "## 角色说明",
        "",
        f"- 描述：{role.get('description', '无')}",
        f"- 推荐工具：{' / '.join(role.get('preferred_tools', [])) or '无'}",
        "",
        "## 必须先读",
        "",
        *read_lines,
        "",
        "## 当前相关工作项",
        "",
        *item_lines,
        "",
        "## 共享核心能力",
        "",
        *skill_lines,
        "",
        "## 当前技术画像强制技能",
        "",
        *required_skill_lines,
        "",
        "## 操作约束",
        "",
        "- 人类文档与 `.factory/memory/` 记忆必须同步更新。",
        "- 每个变更都要同步代码、文档、测试和追踪关系。",
        "- 继续沿用单文件版本演化方式维护正式文档。",
        "- 当前 V1 只支持本地 CLI 协作，不通过项目 API 平台执行。",
        "- 当用户直接输入 `/技能名` 时，将其解释为立即调用该 skill 的默认工作流，而不是展示 skill 定义。",
        "- slash 触发的 skill 禁止只回复“已收到 skill”之类的占位文本，必须直接进入首个可执行步骤。",
        "",
        "## Slash 技能直调约定",
        "",
        "- 通用展开：`/技能名` = 立即执行该 skill 的默认工作流。",
        "- `gitcommitzh` 展开：先执行 Git 变更审查，输出结构化中文说明和中文提交信息草案；若同条消息明确包含“提交 / commit”，先展示“最终写入 Git 的提交信息原文”，再按这段原文执行本地提交。若暂存区为空且未指定文件子集，则默认自动执行 `git add .` 纳入当前工作区改动，而不是中止。提交成功后还要回显 Git 中实际写入的完整标题和正文，并且只有拿到真实 short hash 后才能写“已提交”。若用户原始消息已经要求提交，则必须在同一轮内交付最终结果。",
        "",
        "## 推荐直接执行的命令",
        "",
        *command_lines,
        "",
        "## 可直接在对话里说",
        "",
        *prompt_lines,
    ]
    return "\n".join(lines).rstrip() + "\n"


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    profile = resolve_frontend_profile(args.tool.strip(), default_id="generic")

    try:
        with project_lock(project_root, reason="生成角色化对话启动入口"):
            if not args.skip_refresh_memory:
                refresh_ai_memory(project_root)
            config = load_project_config(project_root)
            ensure_role_catalog(config)
            role = resolve_role(config, args.role.strip())
            grouped = group_items_by_role(config, collect_active_items(project_root))
            items = grouped.get(role["id"], [])[: max(1, args.top)]
            reads = role_document_reads(project_root, config, role["id"])[: max(6, args.top + 3)]
            commands = role_recommended_commands(
                project_root,
                config,
                role["id"],
                args.owner.strip(),
                args.focus.strip() or f"{role['title']}接手当前工作",
            )

            markdown = build_markdown(
                profile,
                config,
                role,
                args.focus.strip(),
                reads,
                commands[:8],
                items,
            )
            output_path = project_root / ".factory" / "memory" / f"chat-bootstrap.{profile['id']}.{role['id']}.md"
            payload = {
                "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "tool": profile["id"],
                "role": role["id"],
                "owner": args.owner.strip(),
                "focus": args.focus.strip(),
                "output": str(output_path),
                "reads": reads,
                "commands": commands[:8],
                "items": [item["id"] for item in items],
            }

            write_text(output_path, markdown)
            write_text(
                project_root / ".factory" / "memory" / "chat-bootstrap.summary.md",
                "\n".join(
                    [
                        "# 对话启动摘要",
                        "",
                        f"- 时间：{payload['generated_at']}",
                        f"- 工具：{tool_label(profile)}",
                        f"- 角色：{role['title']}",
                        f"- 焦点：{args.focus.strip() or '无'}",
                        f"- 输出文件：`{output_path.relative_to(project_root)}`",
                    ]
                ),
            )
            write_text(
                project_root / ".factory" / "chat-bootstrap.json",
                json.dumps(payload, ensure_ascii=False, indent=2),
            )

            doc_path = project_root / ".factory" / "process" / "chat-bootstrap.md"
            upsert_section(
                doc_path,
                "## 最新启动入口",
                [
                    f"- 时间：{payload['generated_at']}",
                    f"- 工具：{tool_label(profile)}",
                    f"- 角色：{role['title']}",
                    f"- 负责人：{args.owner.strip()}",
                    f"- 焦点：{args.focus.strip() or '无'}",
                    f"- 输出文件：`{output_path.relative_to(project_root)}`",
                    f"- 建议先读：`{primary_rule_file(profile)}`",
                ],
                default_title="# 对话启动记录",
            )
            upsert_section(
                doc_path,
                "## 推荐入口命令",
                [f"- `{item}`" for item in commands[:5]] or ["- 无"],
                default_title="# 对话启动记录",
            )
            upsert_section(
                doc_path,
                "## 建议对话提示",
                [f"- {item}" for item in example_prompts(role["title"], profile["id"], args.focus.strip())],
                default_title="# 对话启动记录",
            )
            prepend_history_entry(
                doc_path,
                "## 历史启动记录",
                (
                    f"- {payload['generated_at']}: 为 `{tool_label(profile)}` 生成 `{role['title']}` 对话入口，"
                    f"负责人：{args.owner.strip()}。"
                ),
                default_title="# 对话启动记录",
            )

            now_text = payload["generated_at"]
            config["last_chat_bootstrap_at"] = now_text
            config["last_chat_bootstrap_tool"] = profile["id"]
            config["last_chat_bootstrap_role"] = role["id"]
            config.setdefault("chat_bootstraps", []).append(
                {
                    "tool": profile["id"],
                    "role": role["id"],
                    "owner": args.owner.strip(),
                    "focus": args.focus.strip(),
                    "output": str(output_path.relative_to(project_root)),
                    "created_at": now_text,
                }
            )
            save_project_config(project_root, config)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                (
                    f"- {datetime.now().strftime('%Y-%m-%d')}: 生成 `{tool_label(profile)}` 的 `{role['title']}` "
                    f"对话启动入口，负责人：{args.owner.strip()}。"
                ),
            )
    except Exception as exc:
        print(f"生成对话启动入口失败：{exc}", file=sys.stderr)
        return 1

    print(f"已生成对话启动入口：{output_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
