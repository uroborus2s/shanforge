#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    find_item_file,
    linked_pr_records,
    load_pr_records,
    parse_list,
    project_lock,
    refresh_ai_memory,
    replace_section,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="关闭工作项，并同步收尾记录、测试记录和 AI 记忆。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--item", required=True, help="工作项编号，例如 TASK-001、CR-001、BUG-001。")
    parser.add_argument("--result", default="已完成", help="关闭结果，例如 已完成/已取消/已驳回。")
    parser.add_argument("--owner", default="待记录", help="关闭人。")
    parser.add_argument("--summary", default="", help="收尾总结。")
    parser.add_argument("--docs", default="", help="本次关闭涉及的文档，逗号分隔。")
    parser.add_argument("--tests", default="", help="本次关闭涉及的测试，逗号分隔。")
    parser.add_argument("--code", default="", help="本次关闭涉及的代码文件，逗号分隔。")
    parser.add_argument("--note", default="", help="补充备注。")
    parser.add_argument("--skip-pr-check", action="store_true", help="跳过关联 PR 合并检查。")
    return parser.parse_args()


def assert_pr_ready(project_root: Path, item_id: str, skip_check: bool) -> None:
    if skip_check:
        return
    records = load_pr_records(project_root)
    linked = linked_pr_records(records, item_id)
    if not linked:
        raise RuntimeError(f"`{item_id}` 缺少关联 PR，请先执行 factory-pr-start。")
    unmerged = [record for record in linked if record.get("status") != "merged"]
    if unmerged:
        pending = "、".join(record.get("id", "未知 PR") for record in unmerged)
        raise RuntimeError(f"`{item_id}` 关联 PR 尚未合并：{pending}")


def update_item(path: Path, result: str, owner: str, summary: str, docs: list[str], tests: list[str], code: list[str], note: str) -> None:
    lines = path.read_text(encoding="utf-8").splitlines()
    updated = []
    top_status_updated = False

    for line in lines:
        if line.startswith("- 状态：") and not top_status_updated:
            updated.append(f"- 状态：{result}")
            top_status_updated = True
            continue
        if result == "已完成" and line.startswith("| WB-"):
            parts = [part.strip() for part in line.split("|")]
            if len(parts) >= 5:
                line = f"| {parts[1]} | {parts[2]} | {parts[3]} | 已完成 |"
        updated.append(line)

    updated = [line for line in updated if line.strip() != "- 待开始。"]

    execution_header = "## 执行记录"
    if execution_header in updated:
        start = updated.index(execution_header)
        insert_at = start + 2 if start + 1 < len(updated) and updated[start + 1] == "" else start + 1
        line = (
            f"- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: 工作项关闭为 `{result}`，关闭人：{owner}，"
            f"总结：{summary or '无'}"
        )
        if note:
            line += f"，备注：{note}"
        updated.insert(insert_at, line)

    path.write_text("\n".join(updated).rstrip() + "\n", encoding="utf-8")
    replace_section(
        path,
        "## 完成定义",
        [
            "- 相关代码已修改并通过验证",
            "- 相关文档已更新为单文件最新版本",
            "- 相关测试已补齐或回归通过",
            "- `/.factory/memory/` 摘要已刷新",
        ],
    )
    upsert_close_section(path, result, owner, summary, docs, tests, code, note)


def upsert_close_section(path: Path, result: str, owner: str, summary: str, docs: list[str], tests: list[str], code: list[str], note: str) -> None:
    header = "## 关闭记录"
    lines = path.read_text(encoding="utf-8").splitlines()
    content = [
        f"- 关闭结果：{result}",
        f"- 关闭时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 关闭人：{owner}",
        f"- 代码：{'、'.join(code) if code else '无'}",
        f"- 文档：{'、'.join(docs) if docs else '无'}",
        f"- 测试：{'、'.join(tests) if tests else '无'}",
        f"- 总结：{summary or '无'}",
        f"- 备注：{note or '无'}",
    ]

    if header in lines:
        start = lines.index(header)
        end = len(lines)
        for index in range(start + 1, len(lines)):
            if lines[index].startswith("## "):
                end = index
                break
        lines = lines[: start + 1] + [""] + content + [""] + lines[end:]
    else:
        try:
            before_header = lines.index("## 完成定义")
        except ValueError:
            before_header = len(lines)
        lines = lines[:before_header] + [header, "", *content, ""] + lines[before_header:]
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")
def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    docs = parse_list(args.docs)
    tests = parse_list(args.tests)
    code = parse_list(args.code)
    today = datetime.now().strftime("%Y-%m-%d")

    try:
        with project_lock(project_root, reason=f"关闭工作项 {args.item.strip()}"):
            item_id = args.item.strip()
            assert_pr_ready(project_root, item_id, args.skip_pr_check)
            item_file = find_item_file(project_root, item_id)
            update_item(
                item_file,
                result=args.result.strip(),
                owner=args.owner.strip(),
                summary=args.summary.strip(),
                docs=docs,
                tests=tests,
                code=code,
                note=args.note.strip(),
            )
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                (
                    f"- {today}: 关闭 `{item_id}`，结果：{args.result.strip()}，代码 {len(code)} 项，"
                    f"文档 {len(docs)} 项，测试 {len(tests)} 项。"
                ),
            )
            append_log_line(
                project_root / "docs" / "04-project-development" / "06-testing-verification" / "test-report.md",
                f"- {today}: `{item_id}` 已关闭，测试项：{'、'.join(tests) if tests else '无'}，结果：{args.result.strip()}。",
            )
            append_log_line(
                project_root / "docs" / "04-project-development" / "07-release-delivery" / "acceptance-checklist.md",
                f"- {today}: `{item_id}` 已关闭，结果：{args.result.strip()}，关闭人：{args.owner.strip()}。",
            )
            if item_id.startswith("CR-") or item_id.startswith("BUG-"):
                append_log_line(
                    project_root / "docs" / "04-project-development" / "03-requirements" / "changelog.md",
                    f"- {today}: `{item_id}` 已关闭，结果：{args.result.strip()}，总结：{args.summary.strip() or '无'}。",
                )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"关闭工作项失败：{exc}", file=sys.stderr)
        return 1

    print(f"已关闭工作项：{item_id}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
