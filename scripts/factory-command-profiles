#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import append_log_line, load_project_config, project_lock, run_script, save_project_config, write_text


PROFILE_DESCRIPTIONS = {
    "requirements-kickoff": "初始化需求阶段骨架、执行一次需求一致性校验，并生成最新 agent session。",
    "design-kickoff": "初始化设计阶段骨架、技术画像占位，并生成最新 agent session。",
    "iteration-kickoff": "初始化迭代计划，可选自动创建任务，并生成最新 agent session。",
    "pre-gate": "执行 Gate 前检查、状态诊断，并生成最新 agent session。",
    "daily-close": "执行日终收尾工作流，并生成最新 agent session。",
    "release-ready": "执行发布前高层动作、状态诊断，并生成最新 agent session。",
    "handover-ready": "执行交接前高层动作、状态诊断，并生成最新 agent session。",
}


def step_result_line(step: dict) -> str:
    result_text = "成功" if step["returncode"] == 0 else f"失败({step['returncode']})"
    return f"- {step['label']}：{result_text}"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="执行高层命令画像 profile。")
    parser.add_argument("profile", nargs="?", help="profile 名称。")
    parser.add_argument("--project", help="项目根目录。")
    parser.add_argument("--owner", default="项目经理", help="执行负责人。")
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--focus", default="", help="会话焦点。")
    parser.add_argument("--iteration", default="迭代 1", help="迭代名称。")
    parser.add_argument("--task-count", type=int, default=5, help="迭代任务数量。")
    parser.add_argument("--days-per-task", type=float, default=1.0, help="每个任务默认人天，最小单位 0.5。")
    parser.add_argument("--hours-per-task", type=float, default=None, help="兼容旧参数：每个任务默认工时。")
    parser.add_argument("--req-count", type=int, default=5, help="需求条目数量。")
    parser.add_argument("--related", default="", help="关联项，逗号分隔。")
    parser.add_argument("--tech-preset", default="", help="在 design-kickoff 中使用的技术画像预设，例如 stratix-admin。")
    parser.add_argument("--create-items", action="store_true", help="在 iteration-kickoff 中自动创建任务。")
    parser.add_argument("--list-profiles", action="store_true", help="列出可用 profile。")
    parser.add_argument("--strict", action="store_true", help="若步骤有失败则返回非 0。")
    return parser.parse_args()


def print_profiles() -> None:
    print("可用 profile：")
    for name, description in PROFILE_DESCRIPTIONS.items():
        print(f"- {name}: {description}")


def build_steps(args: argparse.Namespace) -> list[tuple[str, list[str], str]]:
    project = str(Path(args.project).expanduser().resolve())
    owner = args.owner.strip()
    note = args.note.strip()
    focus = args.focus.strip() or note or "当前 profile 焦点"
    profile = args.profile.strip()

    if profile == "requirements-kickoff":
        return [
            ("factory-prd-bootstrap", ["--project", project, "--owner", owner, "--req-count", str(max(1, args.req_count)), "--note", note], "初始化需求阶段"),
            ("factory-requirements-verify", ["--project", project, "--owner", owner, "--note", note], "执行需求一致性校验"),
            ("factory-agent-session", ["--project", project, "--owner", owner, "--focus", focus], "生成会话入口"),
        ]
    if profile == "design-kickoff":
        return [
            ("factory-design-bootstrap", ["--project", project, "--owner", owner, "--note", note], "初始化设计阶段"),
            ("factory-tech-profile", ["--project", project, "--owner", owner, "--preset", args.tech_preset.strip(), "--note", note], "登记技术画像"),
            ("factory-agent-session", ["--project", project, "--owner", owner, "--focus", focus], "生成会话入口"),
        ]
    if profile == "iteration-kickoff":
        step_args = [
            "--project",
            project,
            "--iteration",
            args.iteration.strip(),
            "--owner",
            owner,
            "--task-count",
            str(max(1, args.task_count)),
            "--days-per-task",
            str(max(0.5, args.days_per_task)),
            "--related",
            args.related.strip(),
            "--note",
            note,
        ]
        if args.hours_per_task is not None:
            step_args.extend(["--hours-per-task", str(max(1, args.hours_per_task))])
        if args.create_items:
            step_args.append("--create-items")
        return [
            ("factory-iteration-plan", step_args, "初始化迭代计划"),
            ("factory-agent-session", ["--project", project, "--owner", owner, "--focus", focus], "生成会话入口"),
        ]
    if profile == "pre-gate":
        return [
            ("factory-workflow-runner", ["--project", project, "--workflow", "pre_gate", "--owner", owner, "--note", note], "执行 pre_gate"),
            ("factory-state-doctor", ["--project", project, "--owner", owner, "--scope", "gate", "--note", note], "执行状态诊断"),
            ("factory-agent-session", ["--project", project, "--owner", owner, "--focus", focus], "生成会话入口"),
        ]
    if profile == "daily-close":
        return [
            ("factory-workflow-runner", ["--project", project, "--workflow", "daily_close", "--owner", owner, "--note", note, "--focus", focus], "执行日终收尾"),
            ("factory-agent-session", ["--project", project, "--owner", owner, "--focus", focus], "生成会话入口"),
        ]
    if profile == "release-ready":
        return [
            ("factory-workflow-runner", ["--project", project, "--workflow", "release_ready", "--owner", owner, "--note", note, "--focus", focus], "执行发布准备"),
            ("factory-state-doctor", ["--project", project, "--owner", owner, "--scope", "delivery", "--note", note], "执行状态诊断"),
            ("factory-agent-session", ["--project", project, "--owner", owner, "--focus", focus], "生成会话入口"),
        ]
    if profile == "handover-ready":
        return [
            ("factory-workflow-runner", ["--project", project, "--workflow", "handover_ready", "--owner", owner, "--note", note, "--focus", focus], "执行交接准备"),
            ("factory-state-doctor", ["--project", project, "--owner", owner, "--scope", "full", "--note", note], "执行状态诊断"),
            ("factory-agent-session", ["--project", project, "--owner", owner, "--focus", focus], "生成会话入口"),
        ]
    raise RuntimeError(f"未知 profile：{profile}")


def write_report(path: Path, profile: str, owner: str, result: str, steps: list[dict], history_line: str) -> None:
    if path.exists():
        lines = path.read_text(encoding="utf-8").splitlines()
    else:
        lines = ["# 命令画像执行记录", ""]

    latest_lines = [
        f"- Profile：{profile}",
        f"- 结果：{result}",
        f"- 发起人：{owner}",
        f"- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
    ]
    step_lines = []
    for step in steps:
        step_lines.append(step_result_line(step))
        if step["stdout"]:
            step_lines.append(f"  输出：{step['stdout']}")
        if step["stderr"]:
            step_lines.append(f"  错误：{step['stderr']}")

    sections = {
        "## 最新执行": latest_lines,
        "## 步骤结果": step_lines or ["- 无"],
    }
    for header, content in sections.items():
        if header in lines:
            start = lines.index(header)
            end = len(lines)
            for index in range(start + 1, len(lines)):
                if lines[index].startswith("## "):
                    end = index
                    break
            lines = lines[: start + 1] + [""] + content + [""] + lines[end:]
        else:
            if lines and lines[-1] != "":
                lines.append("")
            lines.extend([header, "", *content, ""])

    history_header = "## 历史执行记录"
    if history_header in lines:
        start = lines.index(history_header)
        insert_at = start + 2 if start + 1 < len(lines) and lines[start + 1] == "" else start + 1
        if history_line not in lines:
            lines.insert(insert_at, history_line)
    else:
        if lines and lines[-1] != "":
            lines.append("")
        lines.extend([history_header, "", history_line, ""])
    write_text(path, "\n".join(lines))


def main() -> int:
    args = parse_args()
    if args.list_profiles or not args.profile:
        print_profiles()
        return 0 if args.list_profiles else 1
    if not args.project:
        print("执行 profile 时必须传入 --project。", file=sys.stderr)
        return 1

    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason=f"执行命令画像 {args.profile.strip()}"):
            load_project_config(project_root)
            steps = [run_script(script_name, *script_args, label=label) for script_name, script_args, label in build_steps(args)]
            result = "完成" if all(step["returncode"] == 0 for step in steps) else "失败"
            history_line = (
                f"- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: 执行 profile `{args.profile.strip()}`，"
                f"结果：{result}，发起人：{args.owner.strip()}。"
            )

            write_report(
                project_root / ".factory" / "process" / "command-profiles.md",
                args.profile.strip(),
                args.owner.strip(),
                result,
                steps,
                history_line,
            )
            write_text(
                project_root / ".factory" / "memory" / "command-profiles.summary.md",
                "\n".join(
                    [
                        "# 命令画像摘要",
                        "",
                        f"- Profile：{args.profile.strip()}",
                        f"- 结果：{result}",
                        f"- 发起人：{args.owner.strip()}",
                        f"- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                        "",
                        "## 步骤结果",
                        "",
                        *[step_result_line(step) for step in steps],
                    ]
                ),
            )

            config = load_project_config(project_root)
            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_command_profile_at"] = now_text
            config["last_command_profile_name"] = args.profile.strip()
            config["last_command_profile_result"] = result
            config.setdefault("command_profile_runs", []).append(
                {
                    "profile": args.profile.strip(),
                    "result": result,
                    "owner": args.owner.strip(),
                    "note": args.note.strip(),
                    "ran_at": now_text,
                }
            )
            save_project_config(project_root, config)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 执行命令画像 `{args.profile.strip()}`，结果：{result}，负责人：{args.owner.strip()}。",
            )
    except Exception as exc:
        print(f"执行命令画像失败：{exc}", file=sys.stderr)
        return 1

    print(f"已执行命令画像：{args.profile.strip()} -> {result}")
    if args.strict and result != "完成":
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
