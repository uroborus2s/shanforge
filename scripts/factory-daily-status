#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    CLOSED_STATUSES,
    append_log_line,
    collect_items,
    ensure_project,
    latest_dir_id,
    load_project_config,
    prepend_history_entry,
    project_lock,
    read_recent_log_lines,
    refresh_ai_memory,
    save_project_config,
    upsert_section,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="生成项目每日报告，并同步到 docs 与 .factory。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--date", default=datetime.now().strftime("%Y-%m-%d"), help="报告日期，格式 YYYY-MM-DD。")
    parser.add_argument("--owner", default="待记录", help="报告生成人。")
    parser.add_argument("--focus", default="", help="今日重点或补充说明。")
    parser.add_argument("--top", type=int, default=5, help="日报中展示的重点条目数量。")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason="生成每日报告"):
            ensure_project(project_root)
            config = load_project_config(project_root)
            tasks = collect_items(project_root, ".factory/workitems/implementation", "TASK")
            changes = collect_items(project_root, ".factory/workitems/changes", "CR")
            bugs = collect_items(project_root, ".factory/workitems/bugs", "BUG")
            active_items = [item for item in tasks + changes + bugs if item["status"] not in CLOSED_STATUSES]
            blocked_items = [item for item in active_items if item["status"] == "阻塞"]
            recent_logs = read_recent_log_lines(project_root, max(1, args.top), date_prefix=args.date.strip())
            gate_history = config.get("gate_history", [])
            recent_gates = [
                gate for gate in gate_history if gate.get("reviewed_at", "").startswith(args.date.strip())
            ] or gate_history[-3:]
            next_items = active_items[: max(1, args.top)]
            latest_rel = latest_dir_id(project_root, "releases", "REL-")

            report_path = project_root / ".factory" / "process" / "daily-status.md"
            latest_lines = [
                f"- 报告日期：{args.date.strip()}",
                f"- 生成时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                f"- 生成人：{args.owner.strip()}",
                f"- 当前阶段：{config.get('stage', '未知')}",
                f"- 当前模式：{config.get('active_mode', '未知')}",
                f"- 今日重点：{args.focus.strip() or '无'}",
                f"- 活跃工作项：{len(active_items)}",
                f"- 阻塞项：{len(blocked_items)}",
                f"- 最近发布包：{latest_rel}",
            ]
            progress_lines = recent_logs if recent_logs else ["- 今日暂无新的执行日志。"]
            risk_lines = (
                [f"- `{item['id']}` {item['title']} | 负责人：{item['owner']}" for item in blocked_items]
                if blocked_items
                else ["- 当前无阻塞项。"]
            )
            next_lines = (
                [f"- `{item['id']}` {item['title']} | 当前状态：{item['status']}" for item in next_items]
                if next_items
                else ["- 当前无待推进工作项。"]
            )
            gate_lines = (
                [
                    f"- `{gate.get('gate', '未知')}`：{gate.get('result', '未知')} | 评审人：{gate.get('reviewer', '未知')}"
                    for gate in recent_gates
                ]
                if recent_gates
                else ["- 今日暂无 Gate 记录。"]
            )

            upsert_section(report_path, "## 最新日报", latest_lines, default_title="# 每日状态报告")
            upsert_section(report_path, "## 今日进展", progress_lines, default_title="# 每日状态报告")
            upsert_section(report_path, "## 当前风险与阻塞", risk_lines, default_title="# 每日状态报告")
            upsert_section(report_path, "## 今日 Gate 记录", gate_lines, default_title="# 每日状态报告")
            upsert_section(report_path, "## 下一步", next_lines, default_title="# 每日状态报告")
            prepend_history_entry(
                report_path,
                "## 历史日报记录",
                (
                    f"- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: 阶段 `{config.get('stage', '未知')}`，"
                    f"活跃工作项 {len(active_items)}，阻塞项 {len(blocked_items)}，发布包 {latest_rel}。"
                ),
                default_title="# 每日状态报告",
            )

            ai_summary = "\n".join(
                [
                    "# 日报摘要",
                    "",
                    f"- 日期：{args.date.strip()}",
                    f"- 当前阶段：{config.get('stage', '未知')}",
                    f"- 活跃工作项：{len(active_items)}",
                    f"- 阻塞项：{len(blocked_items)}",
                    f"- 最近发布包：{latest_rel}",
                    f"- 今日重点：{args.focus.strip() or '无'}",
                    "",
                    "## 重点工作项",
                    "",
                    *next_lines,
                    "",
                    "## 风险摘要",
                    "",
                    *risk_lines,
                    "",
                    "## 最近进展",
                    "",
                    *progress_lines,
                ]
            ).strip()
            (project_root / ".factory" / "memory" / "daily-status.summary.md").write_text(ai_summary + "\n", encoding="utf-8")

            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {args.date.strip()}: 生成每日报告，生成人：{args.owner.strip()}，活跃工作项 {len(active_items)}。",
            )
            config["last_daily_status_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_daily_status_owner"] = args.owner.strip()
            save_project_config(project_root, config)
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"生成每日报告失败：{exc}", file=sys.stderr)
        return 1

    print(f"已生成每日报告：{report_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
