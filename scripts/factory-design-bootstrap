    req_text = "、".join(req_ids)
    return textwrap.dedent(
        f"""
        # 模块边界文档

        - 文档状态：草稿
        - 当前阶段：DESIGN
        - 最近更新：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
        - 负责人：{owner}
        - 备注：{note or '无'}

        ## 关联需求

        - {req_text}

        ## 模块清单

        - 模块名称：待补充
        - 负责范围：待补充
        - 不负责范围：待补充
        - 拥有数据：待补充
        - 允许依赖：待补充
        - 禁止耦合：待补充

        ## 失败与降级策略

        - 待补充
        """
