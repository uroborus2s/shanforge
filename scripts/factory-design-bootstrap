    sections = []
    for index, db_id in enumerate(db_ids, start=1):
        sections.append(
            textwrap.dedent(
                f"""
                ### {db_id} 数据对象 {index}

                - 实体名称：待补充
                - 主键：待补充
                - 关键字段：待补充
                - 索引：待补充
                - 生命周期：待补充
                """
            ).strip()
        )
    return textwrap.dedent(
        f"""
        # 数据库设计文档

        - 文档状态：草稿
        - 当前阶段：DESIGN
        - 最近更新：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
        - 负责人：{owner}
        - 备注：{note or '无'}

        ## 数据对象

        {"\n\n".join(sections)}

        ## 迁移与回滚策略

        - 待补充。
        """
    ).strip()


def build_ui_design(owner: str, req_ids: list[str], ui_ids: list[str], note: str) -> str:
    sections = []
    for index, ui_id in enumerate(ui_ids, start=1):
        sections.append(
            textwrap.dedent(
                f"""
                ### {ui_id} 页面/交互 {index}

                - 关联需求：{req_ids[min(index - 1, len(req_ids) - 1)]}
                - 页面目标：待补充
                - 关键状态：待补充
                - 异常状态：待补充
                - 可用性要求：待补充
                """
            ).strip()
        )
    lines = [
        "# UX/UI 设计文档",
        "",
        "- 文档状态：草稿",
        "- 当前阶段：DESIGN",
        f"- 最近更新：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 负责人：{owner}",
        f"- 备注：{note or '无'}",
        "",
        "## 用户流程",
        "",
        "- 主用户路径：待补充",
        "- 失败与兜底路径：待补充",
        "",
        "## 页面与交互清单",
        "",
        "\n\n".join(sections),
        "",
        "## 设计交付物",
        "",
        "- 当前未登记可直观看到的设计交付物。需要时使用 `factory-design-assets` 录入图片、HTML 原型、流程图、PDF 或外部原型链接。",
    ]
    return "\n".join(lines).strip()


def build_summary(title: str, prefix: str, count: int) -> str:
    lines = [f"# {title}", "", f"- 生成时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}", ""]
    for index in range(1, count + 1):
        lines.append(f"- `{prefix}-{index:03d}` 待补充一句话描述 | 状态：待完善")
    return "\n".join(lines)


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    targets = [
        canonical_docs_project_path(project_root, "04-project-development/04-design/system-architecture.md"),
        canonical_docs_project_path(project_root, "04-project-development/04-design/technical-selection.md"),
        canonical_docs_project_path(project_root, "04-project-development/04-design/module-boundaries.md"),
        canonical_docs_project_path(project_root, "04-project-development/04-design/api-design.md"),
        canonical_docs_project_path(project_root, "04-project-development/04-design/backend-design.md"),
        canonical_docs_project_path(project_root, "04-project-development/04-design/database-design.md"),
        canonical_docs_project_path(project_root, "04-project-development/04-design/ux-ui-design.md"),
    ]

    try:
        with project_lock(project_root, reason="初始化设计阶段文档"):
            for path in targets:
                ensure_writable(path, args.force)

            config = load_project_config(project_root)
            req_ids = extract_req_ids(project_root)
            arch_ids = id_list("ARCH", args.arch_count)
            api_ids = id_list("API", args.api_count)
            ui_ids = id_list("UI", args.ui_count)
            db_ids = id_list("DB", args.db_count)

            write_text(targets[0], build_architecture(config, args.owner.strip(), req_ids, arch_ids, args.note.strip()))
            write_text(targets[1], build_technical_selection(config, args.owner.strip(), args.note.strip()))
            write_text(targets[2], build_module_boundaries(args.owner.strip(), req_ids, args.note.strip()))
            write_text(targets[3], build_api_design(args.owner.strip(), req_ids, api_ids, args.note.strip()))
            write_text(targets[4], build_backend_design(args.owner.strip(), req_ids, args.note.strip()))
            write_text(targets[5], build_database_design(args.owner.strip(), db_ids, args.note.strip()))
            write_text(targets[6], build_ui_design(args.owner.strip(), req_ids, ui_ids, args.note.strip()))

            write_text(project_root / ".factory" / "memory" / "architecture.summary.md", build_summary("架构摘要", "ARCH", len(arch_ids)))
            write_text(project_root / ".factory" / "memory" / "tech-stack.summary.md", build_summary("技术画像摘要", "TECH", 1))
            write_text(project_root / ".factory" / "memory" / "api.summary.md", build_summary("API 摘要", "API", len(api_ids)))
            write_text(project_root / ".factory" / "memory" / "ui.summary.md", build_summary("界面摘要", "UI", len(ui_ids)))

            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_design_bootstrap_at"] = now_text
            config["last_design_bootstrap_owner"] = args.owner.strip()
            save_project_config(project_root, config)

            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 初始化设计阶段文档，生成 ARCH/API/UI 草稿，负责人：{args.owner.strip()}。",
            )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"初始化设计阶段文档失败：{exc}", file=sys.stderr)
        return 1

    print(f"已初始化设计阶段文档：{canonical_docs_project_path(project_root, '04-project-development/04-design')}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
