def action_metadata(action_id: str) -> dict:
    registry = load_action_registry()
    if action_id in registry:
        return dict(registry[action_id], registered=True)
    if action_id in LEGACY_ACTIONS:
        script_name, description = LEGACY_ACTIONS[action_id]
        aliases = [alias for alias, target in LEGACY_ALIASES.items() if target == action_id]
        return {
            "id": action_id,
            "script_name": script_name,
            "description": description,
            "aliases": aliases,
            "risk_level": "",
            "registered": False,
        }
    raise RuntimeError(f"未知动作：{action_id}")


def all_action_ids() -> list[str]:
    ordered = list(LEGACY_ACTIONS.keys())
    for action_id in load_action_registry().keys():
        if action_id not in LEGACY_ACTIONS:
            ordered.append(action_id)
    return ordered


def parse_args() -> tuple[argparse.Namespace, list[str]]:
    parser = argparse.ArgumentParser(
        description="软件工厂单入口调度器。把统一动作分派给对应的 factory-* 命令。",
        allow_abbrev=False,
    )
    parser.add_argument("action", nargs="?", help="动作名称，例如 prd-bootstrap、workflow-runner、auto-sync。")
    parser.add_argument("--list-actions", action="store_true", help="列出可用动作。")
    return parser.parse_known_args()


def resolve_action(raw: str) -> str:
    action = raw.strip()
    registry = load_action_registry()
    if action in registry:
        return action
    for action_id, spec in registry.items():
        if action in spec.get("aliases", []):
            return action_id
    if action in LEGACY_ACTIONS:
        return action
    if action in LEGACY_ALIASES:
        return LEGACY_ALIASES[action]
    raise RuntimeError(f"未知动作：{raw}")


def print_actions() -> None:
    print("可用动作：")
    for name in all_action_ids():
        metadata = action_metadata(name)
        policy = action_policy(name)
        description = metadata["description"]
        aliases = metadata.get("aliases", [])
        alias_text = f" | 别名：{', '.join(aliases)}" if aliases else ""
        if metadata.get("registered"):
            policy_text = f" [{policy.get('risk_level', 'L3')} | {policy.get('approval', 'explicit_confirm')}]"
        else:
            policy_text = " [未登记]"
        print(f"- {name}{policy_text}: {description}{alias_text}")


def main() -> int:
    args, passthrough = parse_args()

    if args.list_actions or not args.action:
        print_actions()
        return 0 if args.list_actions else 1

    try:
        action = resolve_action(args.action)
        metadata = action_metadata(action)
        result = run_script(metadata["script_name"], *passthrough, label=metadata["description"])
    except Exception as exc:
        print(f"分派失败：{exc}", file=sys.stderr)
        return 1

    if result["stdout"]:
        print(result["stdout"])
    if result["stderr"]:
        print(result["stderr"], file=sys.stderr)
    return result["returncode"]


if __name__ == "__main__":
    raise SystemExit(main())
