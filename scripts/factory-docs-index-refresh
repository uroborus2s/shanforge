#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    EXECUTION_LOG_RELATIVE,
    append_log_line,
    docs_stratego_source_status,
    load_project_config,
    project_lock,
    write_docs_stratego_indexes,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="刷新符合 docs-stratego 标准的 docs 目录 index.md。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--name", default="", help="项目名称；未提供时优先读取 `.factory/project.json`。")
    parser.add_argument("--owner", default="文档管理员", help="执行人。")
    parser.add_argument("--check", action="store_true", help="只检查，不写入。")
    return parser.parse_args()


def detect_project_name(project_root: Path, override: str) -> str:
    if override.strip():
        return override.strip()
    config_path = project_root / ".factory" / "project.json"
    if config_path.exists():
        try:
            return load_project_config(project_root).get("project_name", project_root.name) or project_root.name
        except Exception:
            pass
    return project_root.name


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    if not project_root.exists():
        print(f"项目目录不存在：{project_root}", file=sys.stderr)
        return 1

    project_name = detect_project_name(project_root, args.name)

    if args.check:
        status, lines = docs_stratego_source_status(project_root, project_name)
        print(f"docs-stratego 源文档状态：{status}")
        for line in lines:
            print(line)
        return 0 if status == "就绪" else 1

    config_path = project_root / ".factory" / "project.json"
    if config_path.exists():
        with project_lock(project_root, reason=f"refresh-docs-index:{args.owner.strip()}"):
            written = write_docs_stratego_indexes(project_root, project_name)
            log_path = project_root / EXECUTION_LOG_RELATIVE
            if log_path.exists():
                append_log_line(
                    log_path,
                    f"- {datetime.now().strftime('%Y-%m-%d')}: 刷新 docs-stratego 目录索引，负责人：{args.owner.strip()}。",
                )
    else:
        written = write_docs_stratego_indexes(project_root, project_name)

    print(f"已刷新 docs-stratego 目录索引：{project_root / 'docs'}")
    for item in written:
        print(f"- {project_root / item}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
