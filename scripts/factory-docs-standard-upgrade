#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    EXECUTION_LOG_RELATIVE,
    append_log_line,
    docs_stratego_source_status,
    docs_structure_migration_needed,
    load_project_config,
    project_lock,
    upgrade_docs_source_standard,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="把项目 docs 升级到最新源文档标准，并执行收口校验。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--name", default="", help="项目名称；未提供时优先读取 `.factory/project.json`。")
    parser.add_argument("--owner", default="文档管理员", help="执行人。")
    parser.add_argument("--force", action="store_true", help="迁移旧结构时允许覆盖冲突文件。")
    parser.add_argument("--check", action="store_true", help="只检查当前项目距离最新标准的差距。")
    return parser.parse_args()


def detect_project_name(project_root: Path, override: str) -> str:
    if override.strip():
        return override.strip()
    config_path = project_root / ".factory" / "project.json"
    if config_path.exists():
        try:
            return load_project_config(project_root).get("project_name", project_root.name) or project_root.name
        except Exception:
            pass
    return project_root.name


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    if not project_root.exists():
        print(f"项目目录不存在：{project_root}", file=sys.stderr)
        return 1

    project_name = detect_project_name(project_root, args.name)

    if args.check:
        migration_needed = docs_structure_migration_needed(project_root)
        status, lines = docs_stratego_source_status(project_root, project_name)
        print("docs 源文档标准升级检查：")
        print(f"- 结构迁移：{'需要' if migration_needed else '无需'}")
        print(f"- 源文档状态：{status}")
        for line in lines:
            print(line)
        return 0 if not migration_needed and status == "就绪" else 1

    config_path = project_root / ".factory" / "project.json"
    if config_path.exists():
        with project_lock(project_root, reason=f"upgrade-docs-source-standard:{args.owner.strip()}"):
            result = upgrade_docs_source_standard(project_root, project_name, force=args.force)
            log_path = project_root / EXECUTION_LOG_RELATIVE
            if log_path.exists():
                append_log_line(
                    log_path,
                    f"- {datetime.now().strftime('%Y-%m-%d')}: 升级 docs 到最新源文档标准，负责人：{args.owner.strip()}。",
                )
    else:
        result = upgrade_docs_source_standard(project_root, project_name, force=args.force)

    print(f"已完成 docs 源文档标准升级：{project_root / 'docs'}")
    print(f"- 执行迁移：{'是' if result['migrated'] else '否'}")
    migration = result["migration"]
    if isinstance(migration, dict):
        for key in ["moved", "created", "updated", "removed"]:
            values = migration.get(key) or []
            if not values:
                continue
            print(f"{key}:")
            for item in values:
                print(f"- {item}")
    refreshed = result.get("refreshed") or []
    if refreshed:
        print("refreshed:")
        for item in refreshed:
            print(f"- {project_root / item}")
    print(f"- 最终状态：{result['status']}")
    for line in result.get("lines", []):
        print(line)
    return 0 if result["status"] == "就绪" else 1


if __name__ == "__main__":
    raise SystemExit(main())
