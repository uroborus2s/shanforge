#!/usr/bin/env python3

import argparse
from pathlib import Path
import sys

from factory_core import (
    DOCS_PROFILE_SCAN_SKIP_DIRS,
    docs_stratego_source_status,
    docs_structure_migration_needed,
    load_project_config,
    project_lock,
    upgrade_docs_source_standard,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="批量检查或升级多个项目的 docs 源文档标准。")
    parser.add_argument("--root", action="append", default=[], help="扫描根目录，可重复传入。")
    parser.add_argument("--project", action="append", default=[], help="显式指定项目目录，可重复传入。")
    parser.add_argument("--max-depth", type=int, default=2, help="扫描根目录时的最大递归深度，默认 2。")
    parser.add_argument("--owner", default="文档管理员", help="执行人。")
    parser.add_argument("--force", action="store_true", help="迁移旧结构时允许覆盖冲突文件。")
    parser.add_argument("--check", action="store_true", help="只检查，不执行升级。")
    return parser.parse_args()


def detect_project_name(project_root: Path) -> str:
    config_path = project_root / ".factory" / "project.json"
    if config_path.exists():
        try:
            return load_project_config(project_root).get("project_name", project_root.name) or project_root.name
        except Exception:
            pass
    return project_root.name


def is_managed_project(project_root: Path) -> bool:
    return (project_root / ".factory" / "project.json").exists() and (project_root / "docs").exists()


def discover_upgrade_candidate_projects(roots: list[Path], max_depth: int) -> list[Path]:
    discovered: set[Path] = set()

    def scan(directory: Path, depth: int) -> None:
        if is_managed_project(directory):
            discovered.add(directory.resolve())
            return
        if depth >= max_depth:
            return
        try:
            children = sorted(
                child for child in directory.iterdir()
                if child.is_dir()
                and child.name not in DOCS_PROFILE_SCAN_SKIP_DIRS
                and not child.name.startswith(".")
            )
        except Exception:
            return
        for child in children:
            scan(child, depth + 1)

    for root in roots:
        if root.exists() and root.is_dir():
            scan(root.resolve(), 0)
    return sorted(discovered)


def check_project(project_root: Path) -> dict[str, object]:
    project_name = detect_project_name(project_root)
    migration_needed = docs_structure_migration_needed(project_root)
    status, lines = docs_stratego_source_status(project_root, project_name)
    return {
        "project_root": project_root,
        "project_name": project_name,
        "migrated": False,
        "migration_needed": migration_needed,
        "status": status,
        "lines": lines,
    }


def upgrade_project(project_root: Path, owner: str, force: bool) -> dict[str, object]:
    project_name = detect_project_name(project_root)
    config_path = project_root / ".factory" / "project.json"
    if config_path.exists():
        with project_lock(project_root, reason=f"batch-upgrade-docs-source-standard:{owner.strip()}"):
            result = upgrade_docs_source_standard(project_root, project_name, force=force)
    else:
        result = upgrade_docs_source_standard(project_root, project_name, force=force)
    result["project_root"] = project_root
    result["project_name"] = project_name
    return result


def collect_targets(args: argparse.Namespace) -> list[Path]:
    explicit = [Path(item).expanduser().resolve() for item in args.project]
    scanned = discover_upgrade_candidate_projects([Path(item).expanduser().resolve() for item in args.root], args.max_depth)
    targets = []
    seen: set[Path] = set()
    for path in [*explicit, *scanned]:
        if path in seen:
            continue
        if not path.exists() or not path.is_dir():
            continue
        if not (path / "docs").exists():
            continue
        seen.add(path)
        targets.append(path)
    return targets


def print_check_result(result: dict[str, object]) -> None:
    print(f"[CHECK] {result['project_name']} :: {result['project_root']}")
    print(f"- 结构迁移：{'需要' if result['migration_needed'] else '无需'}")
    print(f"- 源文档状态：{result['status']}")
    for line in result.get("lines", []):
        print(line)


def print_upgrade_result(result: dict[str, object]) -> None:
    print(f"[UPGRADE] {result['project_name']} :: {result['project_root']}")
    print(f"- 执行迁移：{'是' if result.get('migrated') else '否'}")
    print(f"- 最终状态：{result['status']}")
    for line in result.get("lines", []):
        print(line)


def main() -> int:
    args = parse_args()
    targets = collect_targets(args)
    if not targets:
        print("未找到可处理的项目。请传入 --project，或通过 --root 指向包含山海工枢项目的目录。", file=sys.stderr)
        return 1

    failures = 0
    ready = 0
    for project_root in targets:
        try:
            if args.check:
                result = check_project(project_root)
                print_check_result(result)
                ok = (not result["migration_needed"]) and result["status"] == "就绪"
            else:
                result = upgrade_project(project_root, args.owner, args.force)
                print_upgrade_result(result)
                ok = result["status"] == "就绪"
        except Exception as exc:
            failures += 1
            print(f"[ERROR] {project_root}: {exc}", file=sys.stderr)
            continue
        if ok:
            ready += 1
        else:
            failures += 1

    print("汇总：")
    print(f"- 目标项目数：{len(targets)}")
    print(f"- 成功/就绪：{ready}")
    print(f"- 失败/未就绪：{failures}")
    return 0 if failures == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
