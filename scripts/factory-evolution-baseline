#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    EVOLUTION_BASELINE_RELATIVE,
    active_items,
    append_log_line,
    blocked_items,
    collect_items,
    completed_items,
    ensure_role_catalog,
    load_pr_records,
    load_project_config,
    merged_pr_records,
    prepend_history_entry,
    project_lock,
    read_recent_log_lines,
    read_risks,
    refresh_ai_memory,
    save_project_config,
    selected_roles,
    upsert_section,
    write_text,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="根据最近执行证据刷新项目自进化基线。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--owner", default="项目协调者", help="负责人。")
    parser.add_argument("--roles", default="", help="覆盖角色，逗号分隔；默认使用当前阶段活跃角色。")
    parser.add_argument("--period", default="", help="基线周期标签。")
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--top", type=int, default=5, help="展示的重点数量。")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    try:
        with project_lock(project_root, reason="刷新自进化基线"):
            config = load_project_config(project_root)
            ensure_role_catalog(config)
            roles = selected_roles(config, args.roles, stage=config.get("stage", ""))
            items = collect_items(project_root)
            active = active_items(items)
            blocked = blocked_items(items)
            completed = completed_items(items, top=max(1, args.top))
            prs = load_pr_records(project_root)
            merged_prs = merged_pr_records(prs)[-max(1, args.top) :]
            open_risks, _ = read_risks(project_root)
            recent_logs = read_recent_log_lines(project_root, max(1, args.top))
            period = args.period.strip() or config.get("stage", "当前阶段")

            latest_lines = [
                f"- 时间：{now_text}",
                f"- 负责人：{args.owner.strip()}",
                f"- 周期：{period}",
                f"- 当前阶段：{config.get('stage', '未知')}",
                f"- 覆盖角色：{'、'.join(role.get('title', role.get('id', '未知角色')) for role in roles) or '无'}",
                f"- 活跃工作项：{len(active)}",
                f"- 阻塞项：{len(blocked)}",
                f"- 开放风险：{len(open_risks)}",
                f"- 备注：{args.note.strip() or '无'}",
            ]

            baseline_lines = [
                "- 默认先读压缩入口和当前阶段核心文档，再进入执行。",
                "- 需求、设计、实现、测试、发布都以“事实 + 证据 + 同步”作为完成标准。",
                "- 进入实现前先确认技术画像和工程规则；进入收尾前先确认 PR 与 Gate 状态。",
                "- 遇到阻塞、空转或质量漂移时，先执行恢复教练，不靠重复施压硬堆尝试次数。",
                "- 发现问题时优先做模式级扫描，避免只修一个点又在邻近链路复发。",
                "- 任何已接受变更都必须同步代码、文档、测试和 `.factory/memory/`。",
            ]

            evidence_lines = []
            for item in completed:
                evidence_lines.append(f"- 完成项：`{item['id']}` {item['title']} | 状态：{item['status']}")
            for record in merged_prs:
                evidence_lines.append(f"- 已合并 PR：`{record.get('id', '未知')}` {record.get('title', '未命名 PR')}")
            for line in recent_logs[-args.top :]:
                evidence_lines.append(f"- 最近记录：{line[2:]}")
            if not evidence_lines:
                evidence_lines = ["- 当前缺少可支撑的新证据，建议先完成一个小闭环后再刷新基线。"]

            anti_pattern_lines = []
            if blocked:
                anti_pattern_lines.extend(
                    f"- 避免让阻塞项 `{item['id']}` 在无新证据的情况下持续空转。"
                    for item in blocked[: args.top]
                )
            if open_risks:
                anti_pattern_lines.extend(f"- 开放风险待收敛：{line[2:]}" for line in open_risks[: args.top])
            recovery_cases = config.get("recovery_cases", [])[-max(1, args.top) :]
            for case in recovery_cases:
                anti_pattern_lines.append(
                    f"- 最近恢复模式：`{case.get('mode', '未知')}` | 工作项：{case.get('item', '无')} | 时间：{case.get('created_at', '未知时间')}"
                )
            if not anti_pattern_lines:
                anti_pattern_lines = ["- 当前没有新的反模式信号，可继续按现有基线推进。"]

            experiment_lines = [
                "- 每轮需求/设计输出后先做一次结构校验，再进入下一阶段。",
                "- 每轮实现至少留下一条可复用的同类问题检查规则。",
                "- 每轮交付后补一次团队动能与基线刷新，避免知识只停留在单次会话。",
            ]
            if blocked or open_risks:
                experiment_lines.append("- 当前优先做恢复与模式级修复，再刷新下一轮计划。")

            baseline_path = project_root / EVOLUTION_BASELINE_RELATIVE
            upsert_section(baseline_path, "## 最新基线", latest_lines, default_title="# 自进化基线")
            upsert_section(baseline_path, "## 当前默认做法", baseline_lines, default_title="# 自进化基线")
            upsert_section(baseline_path, "## 最近证据", evidence_lines, default_title="# 自进化基线")
            upsert_section(baseline_path, "## 当前反模式", anti_pattern_lines, default_title="# 自进化基线")
            upsert_section(baseline_path, "## 下一轮演进实验", experiment_lines, default_title="# 自进化基线")
            prepend_history_entry(
                baseline_path,
                "## 历史基线记录",
                f"- {now_text}: 刷新 `{period}` 基线，负责人：{args.owner.strip()}。",
                default_title="# 自进化基线",
            )

            config["last_evolution_baseline_at"] = now_text
            config.setdefault("evolution_baselines", []).append(
                {
                    "created_at": now_text,
                    "owner": args.owner.strip(),
                    "period": period,
                    "roles": [role["id"] for role in roles],
                    "note": args.note.strip(),
                }
            )
            save_project_config(project_root, config)
            refresh_ai_memory(project_root)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 刷新自进化基线，周期：{period}，负责人：{args.owner.strip()}。",
            )
    except Exception as exc:
        print(f"刷新自进化基线失败：{exc}", file=sys.stderr)
        return 1

    print(f"已刷新自进化基线：{project_root / EVOLUTION_BASELINE_RELATIVE}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
