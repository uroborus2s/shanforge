#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
from datetime import datetime, timezone
from pathlib import Path
import runpy
import sys
import textwrap

from factory_core import (
    append_log_line,
    detect_docs_profile,
    docs_relative_path_enabled,
    project_lock,
    refresh_ai_memory,
    save_project_config,
    save_tech_profile_state,
    update_publication_policy_for_modern_docs,
    write_text,
    run_script,
)


ROOT = Path(__file__).resolve().parent.parent
INIT_SCRIPT = Path(__file__).resolve().parent / "factory-init"
IGNORED_DIRS = {
    ".factory",
    ".git",
    ".hg",
    ".idea",
    ".next",
    ".venv",
    ".vscode",
    "__pycache__",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "venv",
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="为未纳入软件工厂的历史项目补齐最小治理骨架，并生成首轮维护基线。")
    parser.add_argument("--project", required=True, help="历史项目根目录。")
    parser.add_argument("--owner", default="历史项目纳管负责人", help="纳管负责人。")
    parser.add_argument(
        "--goal",
        default="接手后续 bug 修复、需求变更和维护工作",
        help="这次纳管的目标说明。",
    )
    parser.add_argument("--name", default="", help="项目显示名称，默认取目录名。")
    parser.add_argument("--stack", default="auto", help="技术栈说明，默认自动识别。")
    parser.add_argument("--force", action="store_true", help="允许覆盖软件工厂管理文件。")
    return parser.parse_args()


def init_helpers() -> dict:
    return runpy.run_path(str(INIT_SCRIPT))


def safe_read(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="ignore")


def relative_path(project_root: Path, path: Path) -> str:
    return path.resolve().relative_to(project_root.resolve()).as_posix()


def bullet_lines(items: list[str], empty: str) -> str:
    if not items:
        return f"- {empty}"
    return "\n".join(f"- {item}" for item in items)


def normalize_list(values: list[str]) -> list[str]:
    seen = set()
    result = []
    for value in values:
        item = str(value).strip()
        if not item or item in seen:
            continue
        seen.add(item)
        result.append(item)
    return result


def read_first_paragraph(path: Path) -> str:
    if not path.exists() or not path.is_file():
        return ""
    lines = []
    started = False
    for raw in safe_read(path).splitlines():
        line = raw.strip()
        if not line:
            if started:
                break
            continue
        if line.startswith("#") and not started:
            continue
        if line.startswith("[!") and not started:
            continue
        started = True
        lines.append(line)
        if len(lines) >= 3:
            break
    return " ".join(lines).strip()


def parse_package_json(path: Path) -> tuple[dict, list[str]]:
    if not path.exists():
        return {}, []
    try:
        payload = json.loads(safe_read(path))
        return payload, []
    except Exception as exc:
        return {}, [f"`package.json` 无法解析：{exc}"]


def looks_like_crawler4j_model_project(project_root: Path) -> bool:
    manifest_path = project_root / "module.yaml"
    pyproject_path = project_root / "pyproject.toml"
    if not manifest_path.exists() or not pyproject_path.exists():
        return False
    pyproject_text = safe_read(pyproject_path)
    return "crawler4j-sdk" in pyproject_text or "crawler4j_sdk" in pyproject_text


def looks_like_crawler4j_core_repo(project_root: Path) -> bool:
    return (
        (project_root / "crawler4j_sdk" / "pyproject.toml").exists()
        and (project_root / "crawler4j_contracts" / "pyproject.toml").exists()
    )


def discover_markdown_sources(project_root: Path, limit: int = 12) -> list[str]:
    sources: list[str] = []
    for path in sorted(project_root.rglob("*.md")):
        parts = set(path.parts)
        if parts & IGNORED_DIRS:
            continue
        if ".factory" in parts:
            continue
        try:
            relative = relative_path(project_root, path)
        except Exception:
            continue
        sources.append(relative)
        if len(sources) >= limit:
            break
    return sources


def detect_stack(project_root: Path, stack_override: str) -> dict:
    stack_parts: list[str] = []
    runtime_commands: list[str] = []
    build_commands: list[str] = []
    test_commands: list[str] = []
    deploy_signals: list[str] = []
    fact_sources: list[str] = []
    findings: list[str] = []
    unknowns: list[str] = []
    package_scripts: dict[str, str] = {}
    preset = "custom"

    def add_source(relative: str) -> None:
        if (project_root / relative).exists():
            fact_sources.append(relative)

    for candidate in [
        "README.md",
        "README.zh-CN.md",
        "package.json",
        "pyproject.toml",
        "uv.lock",
        "requirements.txt",
        "go.mod",
        "Cargo.toml",
        "pom.xml",
        "Dockerfile",
        "docker-compose.yml",
        "docker-compose.yaml",
        "Makefile",
    ]:
        add_source(candidate)

    package_json, package_errors = parse_package_json(project_root / "package.json")
    findings.extend(package_errors)
    if package_json:
        stack_parts.append("Node.js")
        package_scripts = {
            key: str(value).strip()
            for key, value in package_json.get("scripts", {}).items()
            if str(value).strip()
        }
        if "dev" in package_scripts:
            runtime_commands.append("npm run dev")
        if "start" in package_scripts:
            runtime_commands.append("npm start")
        if "build" in package_scripts:
            build_commands.append("npm run build")
        if "test" in package_scripts:
            test_commands.append("npm test")
        dependencies = {
            *package_json.get("dependencies", {}).keys(),
            *package_json.get("devDependencies", {}).keys(),
        }
        if any(name.startswith("@stratix/") for name in dependencies):
            preset = "stratix-admin"
            stack_parts.append("Stratix")
        if "react" in dependencies or (project_root / "tsconfig.json").exists():
            stack_parts.append("TypeScript" if (project_root / "tsconfig.json").exists() else "React")
        findings.append("检测到 `package.json`，可按 npm/pnpm 生态继续维护。")

    if (project_root / "pyproject.toml").exists() or (project_root / "requirements.txt").exists():
        stack_parts.append("Python")
        if preset == "custom":
            preset = "python-backend"
        if (project_root / "uv.lock").exists():
            build_commands.append("uv sync")
        findings.append("检测到 Python 依赖或项目元数据文件。")

    if looks_like_crawler4j_model_project(project_root):
        preset = "crawler4j-model"
        stack_parts.append("crawler4j model")
        runtime_commands.append("uv run crawler4j list")
        findings.append("检测到 `module.yaml` 与 `crawler4j-sdk` 依赖，按 crawler4j 标准 model/模块项目纳管。")

    if looks_like_crawler4j_core_repo(project_root):
        preset = "crawler4j-model"
        stack_parts.append("crawler4j Core/SDK")
        build_commands.append("uv run python -m crawler4j_sdk.cli.commands --help")
        findings.append("检测到 `crawler4j_sdk/` 与 `crawler4j_contracts/`，按 crawler4j Core + SDK 仓库纳管，并启用模块开发技能。")

    if (project_root / "go.mod").exists():
        stack_parts.append("Go")
        if preset == "custom":
            preset = "golang-backend"
        build_commands.append("go build ./...")
        test_commands.append("go test ./...")
        findings.append("检测到 `go.mod`。")

    if (project_root / "Cargo.toml").exists():
        stack_parts.append("Rust")
        build_commands.append("cargo build")
        test_commands.append("cargo test")
        findings.append("检测到 `Cargo.toml`。")

    if (project_root / "Dockerfile").exists():
        deploy_signals.append("存在 `Dockerfile`。")
    if (project_root / "docker-compose.yml").exists() or (project_root / "docker-compose.yaml").exists():
        deploy_signals.append("存在 `docker compose` 配置。")
    if (project_root / "Makefile").exists():
        build_commands.append("make build")
        test_commands.append("make test")
        findings.append("检测到 `Makefile`，可优先检查是否已有标准构建目标。")

    top_level_modules = [
        path.name
        for path in sorted(project_root.iterdir())
        if path.is_dir() and path.name not in IGNORED_DIRS and not path.name.startswith(".")
    ][:8]

    fact_sources.extend(discover_markdown_sources(project_root))
    fact_sources = normalize_list(fact_sources)

    readme_summary = read_first_paragraph(project_root / "README.md")
    if not readme_summary:
        readme_summary = f"{project_root.name} 当前缺少清晰 README 摘要，需在纳管后补齐。"

    if not runtime_commands:
        unknowns.append("未自动识别出明确启动命令，需要人工确认本地运行方式。")
    if not build_commands:
        unknowns.append("未自动识别出明确构建命令，需要人工确认构建入口。")
    if not test_commands:
        unknowns.append("未自动识别出明确测试命令，需要人工确认测试与回归方式。")
    if not deploy_signals:
        unknowns.append("未自动识别出明确部署线索，需要人工补充部署与上线方式。")

    if stack_override.strip() and stack_override.strip().lower() != "auto":
        stack_label = stack_override.strip()
    elif stack_parts:
        stack_label = " + ".join(normalize_list(stack_parts))
    else:
        stack_label = "待人工确认"

    return {
        "stack_label": stack_label,
        "preset": preset,
        "runtime_commands": normalize_list(runtime_commands),
        "build_commands": normalize_list(build_commands),
        "test_commands": normalize_list(test_commands),
        "deploy_signals": normalize_list(deploy_signals),
        "fact_sources": fact_sources[:16],
        "findings": normalize_list(findings),
        "unknowns": normalize_list(unknowns),
        "top_level_modules": top_level_modules,
        "readme_summary": readme_summary,
        "package_scripts": package_scripts,
    }


def build_tech_profile(scan: dict, owner: str, applied_at: str) -> dict:
    modules = list(scan["top_level_modules"])
    if scan["runtime_commands"]:
        modules.append("本地运行入口")
    if scan["build_commands"]:
        modules.append("构建入口")
    if scan["test_commands"]:
        modules.append("测试入口")

    record = {
        "preset": scan["preset"],
        "title": "历史项目纳管基线画像",
        "stack": scan["stack_label"],
        "summary": "基于仓库现状自动识别的维护画像，后续应结合真实运行方式继续细化。",
        "projects": ["历史项目维护", "缺陷修复", "需求变更纳管"],
        "modules": normalize_list(modules),
        "rules": [
            "以当前真实实现状态、现有配置和最近可验证的运行结果为基线。",
            "后续缺陷统一走 BUG-*，新增需求统一走 CR-*，工程治理补齐走 TASK-*。",
            "代码、正式文档、测试与 `.factory/memory/` 必须同步更新。",
        ],
        "commands": normalize_list(scan["runtime_commands"] + scan["build_commands"] + scan["test_commands"]),
        "guides": [],
        "owner": owner,
        "note": "自动纳管生成，建议在第一次需求或缺陷处理前人工复核。",
        "applied_at": applied_at,
    }
    return record


def build_project_charter(project_name: str, owner: str, goal: str, now_date: str, scan: dict) -> str:
    return textwrap.dedent(
        f"""
        # 历史项目纳管章程

        - 项目名称：{project_name}
        - 纳管负责人：{owner}
        - 当前阶段：MAINTENANCE
        - 纳管时间：{now_date}
        - 本次目标：{goal}

        ## 项目背景

        这是一个已经开发完成、但原先没有按软件工厂结构治理的历史项目。当前先建立软件工厂接手所需的最小治理骨架，让后续 bug 修复、需求变更和日常维护能进入统一流程。

        ## 本次纳管范围

        - 以当前代码、配置、现有文档和最近可验证状态为事实基线。
        - 补齐 `AGENTS.md`、`GEMINI.md`、`docs/`、`.factory/` 和维护阶段最小文档。
        - 生成首轮 AI 记忆、会话入口和状态诊断报告。

        ## 当前已识别事实

        {bullet_lines(scan["findings"], "尚未识别出稳定技术特征，需要人工补充。")}

        ## 当前事实来源

        {bullet_lines([f"`{item}`" for item in scan["fact_sources"]], "当前仓库缺少明确说明文档，需要补齐。")}

        ## 后续维护规则

        - 缺陷修复统一进入 `BUG-*`。
        - 新增需求或范围变化统一进入 `CR-*`。
        - 若需要系统性治理补齐，单独进入 `TASK-*`。
        """
    ).strip()


def build_discovery_input(project_name: str, goal: str, scan: dict) -> str:
    return textwrap.dedent(
        f"""
        # 历史项目纳管输入

        - 项目名称：{project_name}
        - 纳管目标：{goal}
        - 当前识别技术栈：{scan["stack_label"]}

        ## 读取优先级

        1. 当前源码、配置和可执行入口
        2. 最近可验证的发布或运行结果
        3. 当前仓库已有 README、设计、接口和运维材料

        ## 当前自动识别到的关键信号

        {bullet_lines(scan["findings"], "尚未识别出稳定信号，需人工梳理。")}

        ## 需要继续确认的事项

        {bullet_lines(scan["unknowns"], "当前未发现明显未决项。")}
        """
    ).strip()


def build_current_state_analysis(project_root: Path, project_name: str, goal: str, now_date: str, scan: dict) -> str:
    return textwrap.dedent(
        f"""
        # 当前状态分析

        - 项目名称：{project_name}
        - 仓库路径：`.`
        - 分析时间：{now_date}
        - 当前阶段：历史项目纳管
        - 本次目标：{goal}

        ## 一句话基线

        当前判断：这是一个已交付过的历史项目，软件工厂将以仓库现状与最近可验证状态为基线接手后续维护，而不是把它当成全新项目重建。

        ## 已识别的项目摘要

        {scan["readme_summary"]}

        ## 技术与工程线索

        - 自动识别技术栈：{scan["stack_label"]}
        - 主要目录：{("、".join(f"`{item}`" for item in scan["top_level_modules"]) or "待人工确认")}
        - 可用运行入口：
        {bullet_lines([f"`{item}`" for item in scan["runtime_commands"]], "未自动识别。")}
        - 可用构建入口：
        {bullet_lines([f"`{item}`" for item in scan["build_commands"]], "未自动识别。")}
        - 可用测试入口：
        {bullet_lines([f"`{item}`" for item in scan["test_commands"]], "未自动识别。")}

        ## 事实来源

        {bullet_lines([f"`{item}`" for item in scan["fact_sources"]], "当前仓库缺少可读事实源。")}

        ## 已知缺口

        {bullet_lines(scan["unknowns"], "当前没有额外缺口。")}

        ## 纳管后的默认规则

        - 先保持现状可运行，再做缺陷修复和需求变更。
        - 新需求回写 `docs/04-project-development/03-requirements/` 和 `docs/04-project-development/04-design/`。
        - 变更完成后同步更新 `.factory/memory/current-state.md` 与执行记录。
        """
    ).strip()


def build_prd(project_name: str, goal: str, scan: dict) -> str:
    return textwrap.dedent(
        f"""
        # 历史项目维护 PRD

        - 项目名称：{project_name}
        - 当前阶段：MAINTENANCE
        - 当前维护目标：{goal}
        - 当前技术栈基线：{scan["stack_label"]}

        ## 维护背景

        该项目已经开发完成，但原始交付过程未接入软件工厂。当前要做的是先建立维护基线，再让后续 bug 修复和新增需求进入统一的文档、任务和记忆同步流程。

        ## 当前基线需求

        - `REQ-001`：软件工厂接手后，必须能基于当前真实实现状态继续维护该项目。
        - `REQ-002`：后续缺陷修复统一走 `BUG-*`，并同步代码、测试、正式文档和 AI 记忆。
        - `REQ-003`：后续新增需求统一走 `CR-*`，必要时回写需求与设计文档。

        ## 非功能要求

        - `NFR-001`：接手协作者应能在 10 分钟内定位当前状态、运行入口和下一步动作。
        - `NFR-002`：自动生成的纳管资料必须显式标出事实来源和待确认项。

        ## 当前识别事实

        {bullet_lines(scan["findings"], "当前尚无自动识别结论。")}
        """
    ).strip()


def build_system_architecture(project_name: str, scan: dict) -> str:
    modules = [f"`{item}`" for item in scan["top_level_modules"]]
    return textwrap.dedent(
        f"""
        # 系统架构基线

        - 项目名称：{project_name}
        - 当前阶段：MAINTENANCE
        - 当前技术栈：{scan["stack_label"]}

        ## 架构判断

        当前版本先以仓库目录结构和已存在运行入口作为架构基线，不对业务职责做过度推断。后续如有系统级改造，再进入完整架构重构与设计审批。

        ## 主要组成

        {bullet_lines(modules, "尚未识别出稳定模块目录。")}

        ## 当前维护策略

        - 先保护现有可运行能力。
        - 对变更影响进行最小闭环控制。
        - 逐步把关键模块边界、接口契约和运维约束补齐到正式文档。
        """
    ).strip()


def build_module_boundaries(project_name: str, scan: dict) -> str:
    modules = scan["top_level_modules"] or ["待人工确认模块"]
    lines = [
        "# 模块边界基线",
        "",
        f"- 项目名称：{project_name}",
        f"- 当前技术栈：{scan['stack_label']}",
        "",
        "## 当前边界原则",
        "",
        "- 先以现有目录和实际运行入口作为模块边界参考。",
        "- 未确认职责前，不主动跨目录重组代码。",
        "- 对外接口、配置、脚本和部署入口优先视为高影响边界。",
        "",
        "## 当前目录级边界",
        "",
    ]
    for module in modules:
        lines.append(f"- `{module}`：当前纳管阶段先按现有目录维护，必要时再补充分层职责。")
    return "\n".join(lines)


def build_technical_selection(project_name: str, scan: dict) -> str:
    return textwrap.dedent(
        f"""
        # 技术选型与工程规则

        - 项目名称：{project_name}
        - 当前识别技术栈：{scan["stack_label"]}

        ## 当前事实

        {bullet_lines(scan["findings"], "当前缺少足够技术线索。")}

        ## 默认维护规则

        - 先沿用现有构建与运行方式，不在纳管第一步强制迁移技术栈。
        - 对外行为、配置格式和部署方式变更前，先补齐设计和风险说明。
        - 任何维护动作都要回写正式文档和 `.factory/memory/`。

        ## 已识别命令

        - 运行：
        {bullet_lines([f"`{item}`" for item in scan["runtime_commands"]], "待人工确认。")}
        - 构建：
        {bullet_lines([f"`{item}`" for item in scan["build_commands"]], "待人工确认。")}
        - 测试：
        {bullet_lines([f"`{item}`" for item in scan["test_commands"]], "待人工确认。")}
        """
    ).strip()


def build_api_design(project_name: str, scan: dict) -> str:
    script_lines = [f"`{name}` -> `{command}`" for name, command in sorted(scan["package_scripts"].items())]
    return textwrap.dedent(
        f"""
        # 接口与入口基线

        - 项目名称：{project_name}
        - 当前阶段：MAINTENANCE

        ## 当前约定

        当前纳管版本不自动推断完整业务 API，而是先记录已知运行、构建和测试入口，后续再结合真实代码与接口实现细化契约。

        ## 已识别入口

        {bullet_lines(script_lines, "当前未识别出明确脚本入口。")}

        ## 后续要求

        - 若项目对外提供 HTTP、RPC 或消息接口，应在后续维护中把主要契约补齐到本文件。
        - 对外接口变更必须同时更新需求、设计、测试和发布说明。
        """
    ).strip()


def build_operations_runbook(project_name: str, scan: dict) -> str:
    return textwrap.dedent(
        f"""
        # 维护运行手册

        - 项目名称：{project_name}
        - 当前阶段：MAINTENANCE

        ## 本地运行

        {bullet_lines([f"`{item}`" for item in scan["runtime_commands"]], "当前未识别出稳定本地运行命令。")}

        ## 构建与验证

        - 构建：
        {bullet_lines([f"`{item}`" for item in scan["build_commands"]], "待人工确认。")}
        - 测试：
        {bullet_lines([f"`{item}`" for item in scan["test_commands"]], "待人工确认。")}

        ## 部署与运维线索

        {bullet_lines(scan["deploy_signals"], "当前未自动识别出明确部署线索。")}

        ## 维护注意事项

        - 先确保现有入口仍然可用，再推进功能变更。
        - 任何线上问题先记录 `BUG-*`，再安排修复和回归。
        """
    ).strip()


def build_user_guide(project_name: str, goal: str) -> str:
    return textwrap.dedent(
        f"""
        # 维护者快速使用说明

        - 项目名称：{project_name}
        - 当前阶段：MAINTENANCE
        - 当前目标：{goal}

        ## 新协作者先读什么

        1. `AGENTS.md` / `GEMINI.md`
        2. `.factory/project.json`
        3. `.factory/memory/agent-session.md`
        4. `.factory/memory/current-state.md`
        5. 本目录下的运维手册和追踪矩阵

        ## 后续怎么和 AI 协作

        - 修缺陷时说：`新增一个 BUG，先分析影响，再同步代码、测试、文档和 AI 记忆。`
        - 加需求时说：`新增一个 CR，先补需求和设计，再进入实现。`
        - 不确定下一步时说：`先生成 agent session 和 state doctor，再告诉我最合适的下一步。`

        ## 维护边界

        - 以当前真实实现状态为准，不把项目当成新项目重做。
        - 缺陷走 `BUG-*`，需求走 `CR-*`，治理补齐走 `TASK-*`。
        """
    ).strip()


def build_retrospective(project_name: str, goal: str, scan: dict) -> str:
    return textwrap.dedent(
        f"""
        # 纳管复盘与后续演进

        - 项目名称：{project_name}
        - 当前阶段：MAINTENANCE
        - 当前目标：{goal}

        ## 本次已完成

        - 已补齐软件工厂最小治理骨架。
        - 已生成当前状态分析、维护基线文档和首轮 AI 记忆。
        - 已生成一次 agent session 和状态诊断报告。

        ## 仍需继续补齐

        {bullet_lines(scan["unknowns"], "当前未识别出额外补齐项。")}

        ## 下一步建议

        - 先确认真实运行、测试和部署方式。
        - 再创建首批 `BUG-*`、`CR-*` 或 `TASK-*`，进入正式维护闭环。
        """
    ).strip()


def build_execution_log(owner: str, now_date: str, goal: str) -> str:
    return textwrap.dedent(
        f"""
        # 执行日志

        - {now_date}: 完成历史项目纳管基线初始化，负责人：{owner}，目标：{goal}。
        """
    ).strip()


def build_daily_status(owner: str, now_date: str, goal: str) -> str:
    return textwrap.dedent(
        f"""
        # 每日报告

        - 日期：{now_date}
        - 负责人：{owner}
        - 今日动作：完成历史项目纳管骨架补齐与首轮基线生成。
        - 当前目标：{goal}
        """
    ).strip()


def build_risk_register() -> str:
    return textwrap.dedent(
        """
        # 风险登记册

        | 风险编号 | 风险描述 | 等级 | 状态 | 负责人 | 缓解措施 | 备注 |
        |---|---|---|---|---|---|---|
        """
    ).strip()


def build_motivation_state(goal: str) -> str:
    return textwrap.dedent(
        f"""
        # 动能状态摘要

        - 当前目标：{goal}
        - 当前阶段：MAINTENANCE
        - 当前策略：先保稳定、再补缺口、后推进变更。
        """
    ).strip()


def build_autonomy_rules() -> str:
    return textwrap.dedent(
        """
        # 自治规则摘要

        - 先以事实基线推进，不凭记忆改写历史项目行为。
        - 变更前先确认影响范围。
        - 代码、文档、测试和 AI 记忆必须同步收口。
        """
    ).strip()


def build_evolution_baseline() -> str:
    return textwrap.dedent(
        """
        # 自进化基线

        - 历史项目先纳管再维护。
        - 默认保留已有正式文档和规则文件，避免第一次接手就覆盖事实。
        - 优先把运行入口、测试入口和部署线索补成正式文档。
        """
    ).strip()


def build_workitems_readme(title: str, body: str) -> str:
    return textwrap.dedent(
        f"""
        # {title}

        {body}
        """
    ).strip()


def build_traceability_matrix(owner: str, now_text: str) -> str:
    rows = [
        ("REQ-001", "落点", "docs/04-project-development/02-discovery/current-state-analysis.md", "有效", now_text, owner, "历史项目现状基线"),
        ("REQ-001", "落点", "docs/04-project-development/03-requirements/prd.md", "有效", now_text, owner, "维护基线需求"),
        ("REQ-001", "落点", "docs/04-project-development/04-design/system-architecture.md", "有效", now_text, owner, "当前架构基线"),
        ("REQ-001", "落点", "docs/04-project-development/04-design/module-boundaries.md", "有效", now_text, owner, "目录边界基线"),
        ("REQ-001", "落点", "docs/04-project-development/04-design/technical-selection.md", "有效", now_text, owner, "技术与工程规则"),
        ("REQ-001", "落点", "docs/04-project-development/04-design/api-design.md", "有效", now_text, owner, "入口与接口基线"),
        ("REQ-002", "落点", "docs/04-project-development/08-operations-maintenance/operations-runbook.md", "有效", now_text, owner, "缺陷维护与运维线索"),
        ("REQ-003", "落点", "docs/02-user-guide/user-guide.md", "有效", now_text, owner, "后续协作说明"),
    ]
    lines = [
        "# 需求追踪矩阵",
        "",
        "把纳管基线需求与当前文档落点关联起来，方便后续缺陷修复和需求变更继续扩展。",
        "",
        "## 追踪关系",
        "",
        "| 源项 | 关系 | 目标项 | 状态 | 更新时间 | 负责人 | 备注 |",
        "|---|---|---|---|---|---|---|",
    ]
    for row in rows:
        lines.append("| {0} | {1} | {2} | {3} | {4} | {5} | {6} |".format(*row))
    lines.extend(
        [
            "",
            "## 更新记录",
            "",
            f"- {now_text}: 初始化历史项目纳管追踪关系，维护人：{owner}。",
        ]
    )
    return "\n".join(lines)


def build_traceability_graph(owner: str, now_text: str) -> tuple[dict, str]:
    targets = [
        "docs/04-project-development/02-discovery/current-state-analysis.md",
        "docs/04-project-development/03-requirements/prd.md",
        "docs/04-project-development/04-design/system-architecture.md",
        "docs/04-project-development/04-design/module-boundaries.md",
        "docs/04-project-development/04-design/technical-selection.md",
        "docs/04-project-development/04-design/api-design.md",
        "docs/04-project-development/08-operations-maintenance/operations-runbook.md",
        "docs/02-user-guide/user-guide.md",
    ]
    nodes = [
        {"id": "REQ-001", "type": "REQ"},
        {"id": "REQ-002", "type": "REQ"},
        {"id": "REQ-003", "type": "REQ"},
    ]
    seen = {node["id"] for node in nodes}
    edges = []
    for target in targets:
        if target not in seen:
            nodes.append({"id": target, "type": "ARTIFACT"})
            seen.add(target)
    for target in targets[:6]:
        edges.append(
            {
                "source": "REQ-001",
                "relation": "落点",
                "target": target,
                "status": "有效",
                "owner": owner,
                "note": "历史项目纳管基线",
                "updated_at": now_text,
            }
        )
    edges.append(
        {
            "source": "REQ-002",
            "relation": "落点",
            "target": "docs/04-project-development/08-operations-maintenance/operations-runbook.md",
            "status": "有效",
            "owner": owner,
            "note": "缺陷维护说明",
            "updated_at": now_text,
        }
    )
    edges.append(
        {
            "source": "REQ-003",
            "relation": "落点",
            "target": "docs/02-user-guide/user-guide.md",
            "status": "有效",
            "owner": owner,
            "note": "新增需求协作说明",
            "updated_at": now_text,
        }
    )
    graph = {
        "updated_at": now_text,
        "nodes": nodes,
        "edges": edges,
    }
    summary = textwrap.dedent(
        f"""
        # 追踪摘要

        - 更新时间：{now_text}
        - 节点数：{len(nodes)}
        - 关系数：{len(edges)}

        ## 最新追踪关系

        {bullet_lines([f"`{edge['source']}` --{edge['relation']}--> `{edge['target']}`" for edge in edges], "暂无追踪关系。")}
        """
    ).strip()
    return graph, summary


def build_onboarding_report(project_name: str, owner: str, goal: str, now_text: str, scan: dict, created: list[str], preserved: list[str], updated: list[str]) -> str:
    return textwrap.dedent(
        f"""
        # 历史项目纳管报告

        - 项目名称：{project_name}
        - 纳管负责人：{owner}
        - 纳管时间：{now_text}
        - 当前阶段：MAINTENANCE
        - 本次目标：{goal}

        ## 自动识别结论

        - 技术栈：{scan["stack_label"]}
        - 事实来源：
        {bullet_lines([f"`{item}`" for item in scan["fact_sources"]], "未识别到稳定事实源。")}

        ## 本次写入结果

        - 新建文件：
        {bullet_lines([f"`{item}`" for item in created], "无")}
        - 更新文件：
        {bullet_lines([f"`{item}`" for item in updated], "无")}
        - 保留原文件：
        {bullet_lines([f"`{item}`" for item in preserved], "无")}

        ## 待人工确认项

        {bullet_lines(scan["unknowns"], "当前没有额外确认项。")}

        ## 下一步建议

        - 先阅读 `.factory/memory/agent-session.md` 和 `.factory/process/state-doctor-report.md`。
        - 若已有线上问题，优先创建 `BUG-*`。
        - 若已有新增需求，优先创建 `CR-*` 并补齐需求与设计文档。
        """
    ).strip()


def write_managed_file(
    project_root: Path,
    relative: str,
    content: str,
    *,
    force: bool,
    created: list[str],
    preserved: list[str],
    updated: list[str],
) -> None:
    path = project_root / relative
    existed = path.exists()
    if existed and not force:
        preserved.append(relative)
        return
    write_text(path, content)
    if existed:
        updated.append(relative)
    else:
        created.append(relative)


def ensure_success(result: dict, label: str) -> None:
    if result["returncode"] == 0:
        return
    detail = result["stderr"] or result["stdout"] or "无输出"
    raise RuntimeError(f"{label}失败：{detail}")


def main() -> int:
    args = parse_args()
    helpers = init_helpers()
    load_config = helpers["load_config"]
    build_agents_md = helpers["build_agents_md"]
    build_developer_guide_index = helpers["build_developer_guide_index"]
    build_docs_index = helpers["build_docs_index"]
    build_gemini_md = helpers["build_gemini_md"]
    build_getting_started_index = helpers["build_getting_started_index"]
    build_project_development_index = helpers["build_project_development_index"]
    build_project_config = helpers["build_project_config"]
    build_user_guide_index = helpers["build_user_guide_index"]

    project_root = Path(args.project).expanduser().resolve()
    if not project_root.exists() or not project_root.is_dir():
        print(f"历史项目纳管失败：项目目录不存在：{project_root}", file=sys.stderr)
        return 1
    if not any(project_root.iterdir()):
        print("历史项目纳管失败：目标目录为空，请改用 factory-init 初始化新项目。", file=sys.stderr)
        return 1
    if (project_root / ".factory" / "project.json").exists() and not args.force:
        print("历史项目纳管失败：已经存在软件工厂项目配置，请改用 agent-session/state-doctor 继续维护。", file=sys.stderr)
        return 1

    project_name = args.name.strip() or project_root.name
    goal = args.goal.strip()
    config = load_config()
    scan = detect_stack(project_root, args.stack.strip())
    now = datetime.now(timezone.utc)
    now_text = now.astimezone().strftime("%Y-%m-%d %H:%M:%S")
    now_date = now.astimezone().strftime("%Y-%m-%d")
    onboarding_idea = (
        "历史项目纳管：以当前代码、配置、现有文档和最近可验证状态为基线，"
        f"由软件工厂接手后续维护。当前目标：{goal}"
    )
    docs_profile = detect_docs_profile(
        project_root,
        project_name=project_name,
        idea=onboarding_idea,
        stack=scan["stack_label"],
    )
    created: list[str] = []
    preserved: list[str] = []
    updated: list[str] = []

    try:
        (project_root / ".factory").mkdir(parents=True, exist_ok=True)
        with project_lock(project_root, reason="历史项目纳管初始化"):
            for directory in config["project_scaffold"]["directories"]:
                if not docs_relative_path_enabled(directory, docs_profile, project_root / "docs"):
                    continue
                (project_root / directory).mkdir(parents=True, exist_ok=True)
            project_config = json.loads(
                build_project_config(
                    project_name=project_name,
                    idea=onboarding_idea,
                    stack=scan["stack_label"],
                    owner=args.owner.strip(),
                    target=project_root,
                    config=config,
                    docs_profile=docs_profile,
                )
            )
            project_config["stage"] = "MAINTENANCE"
            tech_profile = build_tech_profile(scan, args.owner.strip(), now_text)
            project_config["technical_profile"] = tech_profile
            project_config["historical_onboarding"] = {
                "enabled": True,
                "goal": goal,
                "fact_sources": scan["fact_sources"],
                "unknowns": scan["unknowns"],
                "onboarded_at": now.isoformat(),
                "onboarded_by": args.owner.strip(),
                "tool": "factory-historical-project-onboarding",
            }

            write_managed_file(
                project_root,
                "AGENTS.md",
                build_agents_md(project_name, project_root, config),
                force=args.force,
                created=created,
                preserved=preserved,
                updated=updated,
            )
            write_managed_file(
                project_root,
                "GEMINI.md",
                build_gemini_md(project_name, project_root, config),
                force=args.force,
                created=created,
                preserved=preserved,
                updated=updated,
            )
            write_managed_file(
                project_root,
                ".factory/project.json",
                json.dumps(project_config, ensure_ascii=False, indent=2),
                force=True,
                created=created,
                preserved=preserved,
                updated=updated,
            )

            managed_docs = {
                "docs/index.md": build_docs_index(project_name, docs_profile),
                "docs/01-getting-started/index.md": build_getting_started_index(),
                "docs/02-user-guide/index.md": build_user_guide_index(),
                "docs/03-developer-guide/index.md": build_developer_guide_index(),
                "docs/04-project-development/index.md": build_project_development_index(),
                "docs/04-project-development/01-governance/project-charter.md": build_project_charter(project_name, args.owner.strip(), goal, now_date, scan),
                "docs/04-project-development/02-discovery/input.md": build_discovery_input(project_name, goal, scan),
                "docs/04-project-development/02-discovery/current-state-analysis.md": build_current_state_analysis(project_root, project_name, goal, now_date, scan),
                "docs/04-project-development/03-requirements/prd.md": build_prd(project_name, goal, scan),
                "docs/04-project-development/04-design/system-architecture.md": build_system_architecture(project_name, scan),
                "docs/04-project-development/04-design/module-boundaries.md": build_module_boundaries(project_name, scan),
                "docs/04-project-development/04-design/technical-selection.md": build_technical_selection(project_name, scan),
                "docs/04-project-development/04-design/api-design.md": build_api_design(project_name, scan),
                "docs/04-project-development/08-operations-maintenance/operations-runbook.md": build_operations_runbook(project_name, scan),
                "docs/02-user-guide/user-guide.md": build_user_guide(project_name, goal),
                "docs/04-project-development/09-evolution/retrospective.md": build_retrospective(project_name, goal, scan),
                ".factory/process/execution-log.md": build_execution_log(args.owner.strip(), now_date, goal),
                ".factory/process/daily-status.md": build_daily_status(args.owner.strip(), now_date, goal),
                ".factory/process/risk-register.md": build_risk_register(),
                ".factory/memory/motivation-state.md": build_motivation_state(goal),
                ".factory/memory/autonomy-rules.md": build_autonomy_rules(),
                ".factory/memory/evolution-baseline.md": build_evolution_baseline(),
                ".factory/workitems/implementation/README.md": build_workitems_readme(
                    "实施任务目录",
                    "后续软件工厂接手后的工程治理、重构或专项维护任务统一进入 `TASK-*`。",
                ),
                ".factory/workitems/changes/README.md": build_workitems_readme(
                    "需求变更目录",
                    "历史项目纳管完成后，新增需求和范围变化统一进入 `CR-*`。",
                ),
                ".factory/workitems/bugs/README.md": build_workitems_readme(
                    "缺陷目录",
                    "历史项目纳管完成后，线上与线下缺陷统一进入 `BUG-*` 并补回归验证。",
                ),
                ".factory/design-assets.json": "[]",
            }
            for relative, content in managed_docs.items():
                if not docs_relative_path_enabled(relative, docs_profile, project_root / "docs"):
                    continue
                write_managed_file(
                    project_root,
                    relative,
                    content,
                    force=args.force,
                    created=created,
                    preserved=preserved,
                    updated=updated,
                )

            update_publication_policy_for_modern_docs(project_root, docs_profile)

            save_tech_profile_state(project_root, tech_profile)
            graph, traceability_summary = build_traceability_graph(args.owner.strip(), now_text)
            write_managed_file(
                project_root,
                ".factory/memory/graph/traceability.json",
                json.dumps(graph, ensure_ascii=False, indent=2),
                force=args.force,
                created=created,
                preserved=preserved,
                updated=updated,
            )
            write_managed_file(
                project_root,
                ".factory/memory/traceability.summary.md",
                traceability_summary,
                force=args.force,
                created=created,
                preserved=preserved,
                updated=updated,
            )
            write_managed_file(
                project_root,
                "docs/04-project-development/10-traceability/requirements-matrix.md",
                build_traceability_matrix(args.owner.strip(), now_text),
                force=args.force,
                created=created,
                preserved=preserved,
                updated=updated,
            )

            refresh_ai_memory(project_root)

            session_result = run_script(
                "factory-agent-session",
                "--project",
                str(project_root),
                "--owner",
                args.owner.strip(),
                "--focus",
                "完成历史项目纳管后的首轮维护入口确认",
                label="生成首轮 agent session",
            )
            ensure_success(session_result, "生成首轮 agent session")

            refresh_ai_memory(project_root)

            doctor_result = run_script(
                "factory-state-doctor",
                "--project",
                str(project_root),
                "--owner",
                args.owner.strip(),
                "--scope",
                "full",
                "--note",
                "历史项目纳管首轮诊断",
                label="执行历史项目纳管首轮诊断",
            )
            ensure_success(doctor_result, "执行历史项目纳管首轮诊断")

            project_config = json.loads((project_root / ".factory" / "project.json").read_text(encoding="utf-8"))
            project_config["historical_onboarding"].update(
                {
                    "created_files": created,
                    "preserved_files": preserved,
                    "updated_files": updated,
                    "report": ".factory/process/historical-project-onboarding-report.md",
                    "session": ".factory/memory/agent-session.md",
                    "doctor_report": ".factory/process/state-doctor-report.md",
                }
            )
            save_project_config(project_root, project_config)

            write_text(
                project_root / ".factory" / "process" / "historical-project-onboarding-report.md",
                build_onboarding_report(
                    project_name,
                    args.owner.strip(),
                    goal,
                    now_text,
                    scan,
                    created,
                    preserved,
                    updated,
                ),
            )
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {now_date}: 完成历史项目纳管报告和维护入口初始化，负责人：{args.owner.strip()}。",
            )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"历史项目纳管失败：{exc}", file=sys.stderr)
        return 1

    print(f"已完成历史项目纳管：{project_root}")
    print(f"- 项目名称：{project_name}")
    print("- 当前阶段：MAINTENANCE")
    print(f"- 自动识别技术栈：{scan['stack_label']}")
    print(f"- 新建文件：{len(created)}")
    print(f"- 更新文件：{len(updated)}")
    print(f"- 保留原文件：{len(preserved)}")
    print(f"- 会话入口：{project_root / '.factory' / 'memory' / 'agent-session.md'}")
    print(f"- 诊断报告：{project_root / '.factory' / 'process' / 'state-doctor-report.md'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
