    written = []
    for relative_path, content in files.items():
        path = target / relative_path
        write_file(path, content, force)
        written.append(str(path))

    return written


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="为 Codex 和 Gemini CLI 初始化一个共享的 AI 软件工厂项目。"
    )
    parser.add_argument("--path", required=True, help="目标项目目录，可使用绝对路径或相对路径。")
    parser.add_argument("--name", required=True, help="项目显示名称。")
    parser.add_argument("--idea", required=True, help="初始项目创意或产品简介。")
    parser.add_argument("--stack", default="auto", help="期望技术栈，例如 react+fastapi。")
    parser.add_argument("--owner", default="user", help="项目负责人或团队名称。")
    parser.add_argument("--force", action="store_true", help="允许写入一个非空目标目录。")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    target = Path(args.path).expanduser().resolve()

    try:
        written = initialize_project(
            target=target,
            project_name=args.name.strip(),
            idea=args.idea.strip(),
            stack=args.stack.strip(),
            owner=args.owner.strip(),
            force=args.force,
        )
    except Exception as exc:
        print(f"初始化失败：{exc}", file=sys.stderr)
        return 1

    print(f"已在 {target} 初始化软件工厂项目")
    print("关键文件：")
    for item in [
        target / "AGENTS.md",
        target / "GEMINI.md",
        target / ".factory/project.json",
        target / "docs/00-governance/project-charter.md",
        target / "docs/01-discovery/input.md",
        target / "docs/02-requirements/prd.md",
    ]:
        print(f"- {item}")
    print(f"共创建 {len(written)} 个文件。")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
