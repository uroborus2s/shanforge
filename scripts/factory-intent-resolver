def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="把自然语言目标解析成已注册动作和风险判定。")
    parser.add_argument("intent", nargs="+", help="自然语言目标，例如：继续下一步、刷新 docs 到最新规范。")
    parser.add_argument("--project", default=".", help="目标项目路径，默认为当前目录。")
    parser.add_argument("--tool", default="generic", help="当前前台工具，例如 codex、gemini、opencode。")
    parser.add_argument("--owner", default="意图协调者", help="执行负责人；仅在 --execute-safe 时使用。")
    parser.add_argument("--note", default="", help="补充说明；仅在 --execute-safe 时使用。")
    parser.add_argument("--focus", default="", help="会话或画像焦点；仅在 --execute-safe 时使用。")
    parser.add_argument("--strict", action="store_true", help="在支持的底层命令中透传严格模式。")
    parser.add_argument("--execute-safe", action="store_true", help="若主推荐动作属于 auto 策略，则直接执行。")
    parser.add_argument("--request-approval", action="store_true", help="若主推荐动作需要确认，则生成审批票据。")
    parser.add_argument("--top", type=int, default=3, help="输出候选动作数量。")
    parser.add_argument("--json", action="store_true", help="以 JSON 输出。")
    return parser.parse_args()


def visible_entry_names(project_root: Path) -> list[str]:
    ignored = {".git", ".DS_Store", ".factory"}
    names = []
    for path in sorted(project_root.iterdir()):
        if path.name in ignored:
            continue
        if path.name.startswith(".") and path.name != "docs":
            continue
        names.append(path.name)
    return names


def inspect_project(project_root: Path) -> dict:
    if not project_root.exists():
        raise RuntimeError(f"目标项目不存在：{project_root}")
    if not project_root.is_dir():
        raise RuntimeError(f"目标路径不是目录：{project_root}")

    managed = (project_root / ".factory" / "project.json").exists()
    docs_exists = (project_root / "docs").is_dir()
    entries = visible_entry_names(project_root)
    project_kind = "empty" if not entries else "historical"
    stage = ""
    project_name = project_root.name
    if managed:
        config = load_project_config(project_root)
        stage = str(config.get("stage", "")).strip()
        project_name = str(config.get("project_name", "")).strip() or project_name
        project_kind = "managed"

    return {
        "path": str(project_root),
        "project_name": project_name,
        "managed": managed,
        "docs_exists": docs_exists,
        "stage": stage,
        "project_kind": project_kind,
        "visible_entries": entries[:12],
    }


def skill_candidate_root(project_root: Path) -> Optional[Path]:
    workspace_root = factory_workspace_root().resolve()
    if project_root.resolve() != workspace_root:
        return None
    governance = skill_change_governance()
    root_name = str(governance.get("candidate_root", "skills-drafts")).strip() or "skills-drafts"
    return project_root / root_name


def load_candidate_json(path: Path) -> dict:
    payload = load_json_document(path)
    return dict(payload) if isinstance(payload, dict) else {}


def inspect_skill_candidates(project_root: Path) -> list[dict]:
    root = skill_candidate_root(project_root)
    if root is None or not root.exists():
        return []

    candidates: list[dict] = []
    for candidate_dir in sorted(root.iterdir()):
        if not candidate_dir.is_dir():
            continue
        proposal = load_candidate_json(candidate_dir / "proposal.json")
        if not proposal:
            continue
        promotion = load_candidate_json(candidate_dir / "promotion.json")
        delete_approval = load_candidate_json(candidate_dir / "delete-approval.json")
        name = str(proposal.get("name", "")).strip() or candidate_dir.name
        target_skill = str(proposal.get("target_skill", "")).strip()
        official_skill_path = (
            str(promotion.get("official_skill_path", "")).strip()
            or str(proposal.get("official_skill_path", "")).strip()
        )
        backup_path = str(promotion.get("backup_path", "")).strip()
        promotion_status = str(proposal.get("promotion_status", "")).strip()
        rollback_status = str(proposal.get("rollback_status", "")).strip()
        delete_decision = str(delete_approval.get("decision", "")).strip()
        official_exists = bool(official_skill_path and (project_root / official_skill_path).exists())
        candidates.append(
            {
                "name": name,
                "candidate_dir": str(candidate_dir.resolve()),
                "candidate_ref": str(candidate_dir.resolve().relative_to(project_root.resolve())),
                "target_skill": target_skill,
                "official_skill_path": official_skill_path,
                "eval_status": str(proposal.get("eval_status", "")).strip(),
                "approval_status": str(proposal.get("approval_status", "")).strip(),
                "delete_approval_status": str(proposal.get("delete_approval_status", "")).strip(),
                "delete_approval_decision": delete_decision,
                "promotion_status": promotion_status,
                "rollback_status": rollback_status,
                "has_backup": bool(backup_path),
                "backup_path": backup_path,
                "first_publish": promotion_status == "promoted" and not bool(backup_path),
                "official_exists": official_exists,
            }
        )
    return candidates


def candidate_matches_intent(candidate: dict, intent_key: str) -> bool:
    names = {
        normalize_key(candidate.get("name", "")),
        normalize_key(candidate.get("target_skill", "")),
    }
    official = str(candidate.get("official_skill_path", "")).strip()
    if official:
        names.add(normalize_key(Path(official).parent.name))
    names.discard("")
    return any(name and name in intent_key for name in names)


def detect_skill_operation(intent_text: str, intent_key: str) -> str:
    for operation, keywords in SKILL_OPERATION_SELECTORS.items():
        if contains_keyword(intent_text, intent_key, keywords):
            return operation
    if contains_keyword(intent_text, intent_key, SKILL_KEYWORDS):
        return "next"
    return ""


def skill_action_for_operation(operation: str, candidate: Optional[dict] = None) -> str:
    if operation == "delete_first_publish":
        if candidate and candidate.get("delete_approval_decision") == "approve":
            return "skill-rollback"
        return "skill-delete-approval"
    if operation == "rollback":
        if candidate and not candidate.get("has_backup") and candidate.get("first_publish", False):
            if candidate.get("delete_approval_decision") == "approve":
                return "skill-rollback"
            return "skill-delete-approval"
        return "skill-rollback"
    return SKILL_OPERATION_ACTIONS.get(operation, "skill-eval")


def candidate_relevant_for_operation(candidate: dict, operation: str) -> bool:
    promotion_status = candidate.get("promotion_status", "")
    rollback_status = candidate.get("rollback_status", "")
    if rollback_status == "rolled_back":
        return False
    if operation == "eval":
        return promotion_status != "promoted"
    if operation == "approval_request":
        return promotion_status != "promoted" and candidate.get("eval_status") == "passed"
    if operation == "promote":
        return (
            promotion_status != "promoted"
            and candidate.get("eval_status") == "passed"
            and candidate.get("approval_status") == "approved"
        )
    if operation == "rollback":
        return promotion_status == "promoted"
    if operation == "delete_first_publish":
        return promotion_status == "promoted" and candidate.get("first_publish", False)
    if operation == "next":
        return True
    return False


def infer_next_skill_operation(candidate: dict) -> str:
    if candidate.get("rollback_status") == "rolled_back":
        return ""
    if candidate.get("promotion_status") == "promoted":
        if candidate.get("has_backup") or candidate.get("delete_approval_decision") == "approve":
            return "rollback"
        return "delete_first_publish"
    if candidate.get("approval_status") == "approved" and candidate.get("eval_status") == "passed":
        return "promote"
    if candidate.get("eval_status") == "passed":
        return "approval_request"
    return "eval"


def select_skill_candidate(candidates: list[dict], intent_key: str, operation: str) -> Tuple[Optional[dict], list[str]]:
    relevant = [item for item in candidates if candidate_relevant_for_operation(item, operation)]
    if operation == "next":
        relevant = [item for item in candidates if infer_next_skill_operation(item)]
    if not relevant:
        return None, [f"当前没有满足 `{operation}` 条件的候选 skill。"]

    explicit = [item for item in relevant if candidate_matches_intent(item, intent_key)]
    if len(explicit) == 1:
        return explicit[0], []
    if len(explicit) > 1:
        names = "，".join(item["name"] for item in explicit)
        return None, [f"意图同时命中了多个候选 skill：{names}；请显式说明 skill 名称。"]
    if len(relevant) == 1:
        return relevant[0], []
    names = "，".join(item["name"] for item in relevant[:5])
    return None, [f"当前存在多个候选 skill：{names}；请显式说明 skill 名称。"]


def resolve_skill_lifecycle(intent_text: str, intent_key: str, project_root: Path) -> Optional[dict]:
    operation = detect_skill_operation(intent_text, intent_key)
    if not operation:
        return None

    candidates = inspect_skill_candidates(project_root)
    if not candidates:
        return {
            "operation": operation,
            "action": skill_action_for_operation(operation),
            "reasons": [f"检测到 skill 生命周期语义 `{operation}`。"],
            "blocked": ["当前工作区没有可用的 `skills-drafts/` 候选 skill。"],
        }

    candidate, blocked = select_skill_candidate(candidates, intent_key, operation)
    if candidate is None:
        return {
            "operation": operation,
            "action": skill_action_for_operation(operation),
            "reasons": [f"检测到 skill 生命周期语义 `{operation}`，但当前无法唯一定位候选 skill。"],
            "blocked": blocked,
        }

    resolved_operation = operation if operation != "next" else infer_next_skill_operation(candidate)
    if not resolved_operation:
        return {
            "operation": operation,
            "candidate": candidate,
            "blocked": [f"候选 skill `{candidate['name']}` 已没有可继续推进的生命周期动作。"],
        }

    reasons = [f"检测到 skill 生命周期语义 `{resolved_operation}`。", f"匹配候选 skill `{candidate['name']}`。"]
    action = skill_action_for_operation(resolved_operation, candidate)
    if resolved_operation == "approval_request":
        reasons.append("候选 skill 已评估通过，下一步应申请审批票据。")
    elif resolved_operation == "promote":
        reasons.append("候选 skill 已评估通过且已批准，下一步应正式晋升。")
    elif resolved_operation == "rollback":
        if candidate.get("has_backup"):
            reasons.append("候选 skill 存在旧版本备份，可直接恢复旧版。")
        elif candidate.get("delete_approval_decision") == "approve":
            reasons.append("首次发布的新 skill 已获删除回退审批，可直接执行删除回退。")
        else:
            reasons.append("首次发布的新 skill 没有旧版本备份，回退前必须先申请删除回退审批。")
    elif resolved_operation == "delete_first_publish":
        if candidate.get("delete_approval_decision") == "approve":
            reasons.append("首次发布的新 skill 已获删除回退审批，下一步应执行删除回退。")
        else:
            reasons.append("首次发布的新 skill 没有旧版本备份，必须先申请删除回退审批。")

    if not action:
        return {"operation": resolved_operation, "candidate": candidate, "blocked": ["未识别出可执行的 skill 生命周期动作。"]}

    return {
        "operation": resolved_operation,
        "candidate": candidate,
        "action": action,
        "blocked": [],
        "reasons": reasons,
    }


def contains_keyword(intent_text: str, intent_key: str, keywords: list[str]) -> bool:
    lowered = intent_text.lower()
    return any(keyword.lower() in lowered or normalize_key(keyword) in intent_key for keyword in keywords)


def missing_frontend_capabilities(action_spec: dict, frontend_profile: dict) -> list[str]:
    capabilities = frontend_profile.get("capabilities", {})
    missing = []
    for requirement in action_spec.get("frontend_requirements", []):
        if not capabilities.get(str(requirement), False):
            missing.append(str(requirement))
    return missing


def detect_named_selector(intent_text: str, intent_key: str, selectors: dict[str, list[str]]) -> Optional[Tuple[str, str]]:
    for name, keywords in selectors.items():
        if contains_keyword(intent_text, intent_key, keywords):
            return name, f"检测到 `{name}` 子目标语义。"
    return None


def evaluate_action(
    action_spec: dict,
    intent_text: str,
    intent_key: str,
    facts: dict,
    frontend_profile: dict,
    lifecycle: Optional[dict] = None,
) -> dict:
    action_id = action_spec["id"]
    score = 0
    reasons: list[str] = []
    blocked: list[str] = []
    selected_profile = ""
    selected_workflow = ""
    selected_skill_candidate = ""
    selected_skill_operation = ""

    if lifecycle and lifecycle.get("action") == action_id:
        candidate = lifecycle.get("candidate") or {}
        score += 18
        reasons.extend(lifecycle.get("reasons") or [])
        blocked.extend(lifecycle.get("blocked") or [])
        selected_skill_candidate = str(candidate.get("candidate_ref", "")).strip()
        selected_skill_operation = str(lifecycle.get("operation", "")).strip()

    if action_id == "init":
        if contains_keyword(intent_text, intent_key, NEW_PROJECT_KEYWORDS):
            score += 12
            reasons.append("检测到新项目或初始化语义。")
        if facts["project_kind"] == "empty":
            score += 8
            reasons.append("目标目录接近空目录。")
        else:
            blocked.append("目录非空，当前不适合直接初始化。")
    elif action_id == "state-doctor":
        docs_hit = contains_keyword(intent_text, intent_key, DOCS_KEYWORDS)
        onboarding_hit = contains_keyword(intent_text, intent_key, ONBOARDING_KEYWORDS)
        if contains_keyword(intent_text, intent_key, DIAGNOSTIC_KEYWORDS):
            score += 10
            reasons.append("检测到诊断、检查或下一步建议语义。")
        if onboarding_hit and facts["project_kind"] == "historical":
            score += 12
            reasons.append("检测到已有仓库接入语义，先以诊断方式确认当前结构。")
        if docs_hit:
            score += 8
            reasons.append("检测到 docs 维护语义；当前 docs 流程改由 `document-templates` skill 配合 `docs-stratego` CLI 完成，先做状态诊断与缺口确认。")
        if not any(
            contains_keyword(intent_text, intent_key, keywords)
            for keywords in (
                ONBOARDING_KEYWORDS,
                NEW_PROJECT_KEYWORDS,
                SESSION_KEYWORDS,
                RULE_KEYWORDS,
                FRONTEND_KEYWORDS,
                MULTI_AGENT_KEYWORDS,
                WORKFLOW_KEYWORDS,
                PROFILE_KEYWORDS,
            )
        ):
            score += 4
            reasons.append("没有出现更强的专项语义，适合作为默认诊断入口。")
    elif action_id == "agent-session":
        if contains_keyword(intent_text, intent_key, SESSION_KEYWORDS):
            score += 12
            reasons.append("检测到会话启动或上下文整理语义。")
        if not facts["managed"] and not facts["docs_exists"]:
            blocked.append("项目缺少平台骨架和 docs 入口，先执行 state-doctor 更稳妥。")
    elif action_id == "project-rules-refresh":
        if contains_keyword(intent_text, intent_key, RULE_KEYWORDS):
            score += 12
            reasons.append("检测到规则文件刷新语义。")
        if not facts["managed"] and not facts["docs_exists"]:
            blocked.append("项目既未纳管也缺少 docs/，规则刷新边界不明确。")
    elif action_id == "frontend-capabilities":
        if contains_keyword(intent_text, intent_key, FRONTEND_KEYWORDS):
            score += 12
            reasons.append("检测到前台能力画像查询语义。")
    elif action_id == "multi-agent-board":
        if contains_keyword(intent_text, intent_key, MULTI_AGENT_KEYWORDS):
            score += 12
            reasons.append("检测到多代理协作和分工看板语义。")
        if not facts["managed"]:
            blocked.append("多代理协作看板要求项目已纳入软件工厂。")
    elif action_id == "workflow-runner":
        selected = detect_named_selector(intent_text, intent_key, WORKFLOW_SELECTORS)
        if selected:
            selected_workflow = selected[0]
            score += 14
            reasons.append(selected[1])
        elif contains_keyword(intent_text, intent_key, WORKFLOW_KEYWORDS):
            score += 4
            reasons.append("检测到高层工作流语义，但还没有识别出具体 workflow 名称。")
            blocked.append("缺少明确 workflow 名称，无法直接执行 workflow-runner。")
        if not facts["managed"]:
            blocked.append("高层工作流要求项目已纳入软件工厂。")
    elif action_id == "command-profiles":
        selected = detect_named_selector(intent_text, intent_key, PROFILE_SELECTORS)
        if selected:
            selected_profile = selected[0]
            score += 14
            reasons.append(selected[1])
            if contains_keyword(intent_text, intent_key, SESSION_OUTPUT_KEYWORDS):
                score += 2
                reasons.append("该 profile 会附带生成会话入口。")
            if contains_keyword(intent_text, intent_key, WORKFLOW_KEYWORDS):
                score -= 4
                reasons.append("输入显式提到 workflow，优先让 workflow-runner 处理。")
        elif contains_keyword(intent_text, intent_key, PROFILE_KEYWORDS):
            score += 4
            reasons.append("检测到命令画像语义，但还没有识别出具体 profile 名称。")
            blocked.append("缺少明确 profile 名称，无法直接执行 command-profiles。")
        if not facts["managed"]:
            blocked.append("命令画像依赖软件工厂项目状态。")

    if contains_keyword(intent_text, intent_key, DIAGNOSTIC_KEYWORDS):
        if facts["project_kind"] == "empty" and action_id == "init":
            score += 4
        elif facts["managed"] and action_id == "state-doctor":
            score += 4

    missing = missing_frontend_capabilities(action_spec, frontend_profile)
    if missing:
        blocked.append("当前前台缺少能力：" + ", ".join(missing))

    policy = effective_action_policy(
        action_spec["id"],
        selected_profile=selected_profile,
        selected_workflow=selected_workflow,
    )

    return {
        "action": action_id,
        "description": action_spec["description"],
        "score": score,
        "reasons": reasons,
        "blocked": blocked,
        "frontend_supported": not missing,
        "policy": policy,
        "selected_profile": selected_profile,
        "selected_workflow": selected_workflow,
        "selected_skill_candidate": selected_skill_candidate,
        "selected_skill_operation": selected_skill_operation,
    }


def fallback_action(facts: dict) -> tuple[str, str]:
    if facts["project_kind"] == "empty":
        return "init", "目标目录接近空目录，默认推荐初始化项目。"
    if facts["project_kind"] == "historical":
        return "state-doctor", "目标目录非空，默认先诊断当前结构并确认接入方式。"
    return "state-doctor", "项目已纳管或已有明确骨架，默认先做状态诊断。"


def command_hint(action_id: str, project_root: Path, intent_text: str, candidate: Optional[dict] = None) -> str:
    dispatch = factory_workspace_root() / "scripts" / "factory-dispatch"
    selected_skill_candidate = (candidate or {}).get("selected_skill_candidate", "").strip()
    if action_id == "init":
        return f"python3 {dispatch} {action_id} --path \"{project_root}\" --name \"{project_root.name}\" --idea \"{intent_text.strip()}\""
    if action_id == "state-doctor":
        return f"python3 {dispatch} {action_id} --project \"{project_root}\" --owner \"<owner>\" --scope full"
    if action_id == "agent-session":
        return f"python3 {dispatch} {action_id} --project \"{project_root}\" --owner \"<owner>\" --focus \"{intent_text.strip()}\""
    if action_id == "frontend-capabilities":
        return f"python3 {dispatch} {action_id} --list"
    if action_id == "command-profiles" and candidate and candidate.get("selected_profile"):
        return (
            f"python3 {dispatch} {action_id} {candidate['selected_profile']} --project \"{project_root}\" "
            f"--owner \"<owner>\" --focus \"{intent_text.strip()}\""
        )
    if action_id == "workflow-runner" and candidate and candidate.get("selected_workflow"):
        return (
            f"python3 {dispatch} {action_id} --project \"{project_root}\" --workflow {candidate['selected_workflow']} "
            f"--owner \"<owner>\" --focus \"{intent_text.strip()}\""
        )
    if action_id == "skill-eval" and selected_skill_candidate:
        return f"python3 {dispatch} {action_id} \"{selected_skill_candidate}\" --owner \"<owner>\""
    if action_id == "skill-eval":
        return f"python3 {dispatch} {action_id} <candidate> --owner \"<owner>\""
    if action_id == "skill-approval" and selected_skill_candidate:
        return f"python3 {dispatch} {action_id} \"{selected_skill_candidate}\" --request --owner \"<owner>\""
    if action_id == "skill-approval":
        return f"python3 {dispatch} {action_id} <candidate> --request --owner \"<owner>\""
    if action_id == "skill-delete-approval" and selected_skill_candidate:
        return f"python3 {dispatch} {action_id} \"{selected_skill_candidate}\" --request --owner \"<owner>\""
    if action_id == "skill-delete-approval":
        return f"python3 {dispatch} {action_id} <candidate> --request --owner \"<owner>\""
    if action_id == "skill-promote" and selected_skill_candidate:
        return f"python3 {dispatch} {action_id} \"{selected_skill_candidate}\" --owner \"<owner>\""
    if action_id == "skill-promote":
        return f"python3 {dispatch} {action_id} <candidate> --owner \"<owner>\""
    if action_id == "skill-rollback" and selected_skill_candidate:
        return f"python3 {dispatch} {action_id} \"{selected_skill_candidate}\" --owner \"<owner>\""
    if action_id == "skill-rollback":
        return f"python3 {dispatch} {action_id} <candidate> --owner \"<owner>\""
    return f"python3 {dispatch} {action_id} --project \"{project_root}\""


def derive_doctor_scope(intent_text: str, intent_key: str) -> str:
    if contains_keyword(intent_text, intent_key, ["gate", "pre gate", "阶段放行"]):
        return "gate"
    if contains_keyword(intent_text, intent_key, ["发布", "交付", "release", "delivery"]):
        return "delivery"
    if contains_keyword(intent_text, intent_key, ["docs", "文档", "目录", "索引", "规范"]):
        return "docs"
    return "full"


def infer_approval_ownership(result: dict, owner: str) -> dict:
    primary = result.get("primary") or {}
    action_id = str(primary.get("action", "")).strip()
    selected_profile = str(primary.get("selected_profile", "")).strip()
    selected_workflow = str(primary.get("selected_workflow", "")).strip()
    role_id = (
        PROFILE_OWNERSHIP_ROLES.get(selected_profile)
        or WORKFLOW_OWNERSHIP_ROLES.get(selected_workflow)
        or ACTION_OWNERSHIP_ROLES.get(action_id)
        or "coordinator"
    )
    write_targets = (
        PROFILE_OWNERSHIP_TARGETS.get(selected_profile)
        or WORKFLOW_OWNERSHIP_TARGETS.get(selected_workflow)
        or ACTION_OWNERSHIP_TARGETS.get(action_id)
        or []
    )
    project_root = Path(result["project"]["path"])
    return {
        "role_id": role_id,
        "role_title": ROLE_TITLES.get(role_id, role_id),
        "execution_owner": owner,
        "write_targets": normalize_write_targets(project_root, write_targets),
        "source": "inferred",
    }


def snapshot_ownership_conflicts(result: dict, ownership: dict) -> list[dict]:
    facts = result.get("project", {})
    if not facts.get("managed"):
        return []
    write_targets = list(ownership.get("write_targets", []))
    role_id = str(ownership.get("role_id", "")).strip()
    if not role_id or not write_targets:
        return []
    project_root = Path(facts["path"])
    config = load_project_config(project_root)
    candidate_assignment = {
        "owner": ownership.get("execution_owner", ""),
        "tool": result.get("frontend", {}).get("id", "generic"),
        "items": [],
        "status": "进行中",
        "focus": result.get("intent", ""),
        "note": "intent approval ownership snapshot",
        "write_targets": write_targets,
    }
    return role_assignment_conflicts(
        project_root,
        config,
        candidate_role_id=role_id,
        candidate_assignment=candidate_assignment,
    )


def build_execution_plan(result: dict, *, owner: str, note: str, focus: str, strict: bool) -> dict:
    candidate = result.get("primary") or {}
    action_id = candidate.get("action", "")
    project = result["project"]
    project_root = Path(project["path"])
    project_name = project.get("project_name", project_root.name) or project_root.name
    intent_text = result.get("intent", "")
    intent_key = normalize_key(intent_text)
    note_text = note.strip() or intent_text
    focus_text = focus.strip() or intent_text

    plan = {
        "action": action_id,
        "script_name": "",
        "arguments": [],
        "label": "",
    }

    if action_id == "state-doctor":
        plan.update(
            script_name="factory-state-doctor",
            arguments=["--project", str(project_root), "--owner", owner, "--scope", derive_doctor_scope(intent_text, intent_key), "--note", note_text],
            label="按意图执行状态诊断",
        )
    elif action_id == "init":
        plan.update(
            script_name="factory-init",
            arguments=["--path", str(project_root), "--name", project_name, "--idea", note_text, "--stack", "auto", "--owner", owner],
            label="按意图初始化项目骨架",
        )
    elif action_id == "agent-session":
        plan.update(
            script_name="factory-agent-session",
            arguments=["--project", str(project_root), "--owner", owner, "--focus", focus_text],
            label="按意图生成会话入口",
        )
    elif action_id == "project-rules-refresh":
        plan.update(
            script_name="factory-project-rules-refresh",
            arguments=["--project", str(project_root), "--owner", owner, "--note", note_text],
            label="按意图刷新项目规则",
        )
    elif action_id == "frontend-capabilities":
        requested_tool = result.get("frontend", {}).get("id", "generic")
        plan.update(
            script_name="factory-frontend-capabilities",
            arguments=["--tool", requested_tool],
            label="按意图查询前台能力画像",
        )
    elif action_id == "multi-agent-board":
        plan.update(
            script_name="factory-multi-agent-board",
            arguments=["--project", str(project_root), "--owner", owner, "--focus", focus_text],
            label="按意图生成多代理协作看板",
        )
    elif action_id == "command-profiles":
        selected_profile = candidate.get("selected_profile", "").strip()
        if not selected_profile:
            raise RuntimeError("命令画像缺少具体 profile，无法自动执行。")
        arguments = [selected_profile, "--project", str(project_root), "--owner", owner, "--note", note_text, "--focus", focus_text]
        if strict:
            arguments.append("--strict")
        plan.update(
            script_name="factory-command-profiles",
            arguments=arguments,
            label=f"按意图执行命令画像 {selected_profile}",
        )
    elif action_id == "workflow-runner":
        selected_workflow = candidate.get("selected_workflow", "").strip()
        if not selected_workflow:
            raise RuntimeError("工作流入口缺少具体 workflow，无法自动执行。")
        arguments = ["--project", str(project_root), "--workflow", selected_workflow, "--owner", owner, "--note", note_text, "--focus", focus_text]
        if strict:
            arguments.append("--strict")
        plan.update(
            script_name="factory-workflow-runner",
            arguments=arguments,
            label=f"按意图执行工作流 {selected_workflow}",
        )
    elif action_id == "skill-eval":
        selected_candidate = candidate.get("selected_skill_candidate", "").strip()
        if not selected_candidate:
            raise RuntimeError("skill-eval 缺少候选 skill 目标，无法自动执行。")
        arguments = [selected_candidate, "--owner", owner, "--note", note_text]
        if strict:
            arguments.append("--strict")
        plan.update(
            script_name="factory-skill-eval",
            arguments=arguments,
            label=f"按意图评估候选 skill {selected_candidate}",
        )
    elif action_id == "skill-approval":
        selected_candidate = candidate.get("selected_skill_candidate", "").strip()
        if not selected_candidate:
            raise RuntimeError("skill-approval 缺少候选 skill 目标，无法自动执行。")
        plan.update(
            script_name="factory-skill-approval",
            arguments=[selected_candidate, "--request", "--owner", owner, "--note", note_text],
            label=f"按意图申请候选 skill 审批 {selected_candidate}",
        )
    elif action_id == "skill-delete-approval":
        selected_candidate = candidate.get("selected_skill_candidate", "").strip()
        if not selected_candidate:
            raise RuntimeError("skill-delete-approval 缺少候选 skill 目标，无法自动执行。")
        plan.update(
            script_name="factory-skill-delete-approval",
            arguments=[selected_candidate, "--request", "--owner", owner, "--note", note_text],
            label=f"按意图申请首次发布 skill 删除回退审批 {selected_candidate}",
        )
    elif action_id == "skill-promote":
        selected_candidate = candidate.get("selected_skill_candidate", "").strip()
        if not selected_candidate:
            raise RuntimeError("skill-promote 缺少候选 skill 目标，无法自动执行。")
        plan.update(
            script_name="factory-skill-promote",
            arguments=[selected_candidate, "--owner", owner, "--note", note_text],
            label=f"按意图晋升候选 skill {selected_candidate}",
        )
    elif action_id == "skill-rollback":
        selected_candidate = candidate.get("selected_skill_candidate", "").strip()
        if not selected_candidate:
            raise RuntimeError("skill-rollback 缺少候选 skill 目标，无法自动执行。")
        plan.update(
            script_name="factory-skill-rollback",
            arguments=[selected_candidate, "--owner", owner, "--note", note_text],
            label=f"按意图回退候选 skill {selected_candidate}",
        )
    else:
        raise RuntimeError(f"当前动作 `{action_id}` 还没有接入安全自动执行。")

    return plan


def request_primary_approval(result: dict, *, owner: str, note: str, focus: str, strict: bool) -> dict:
    primary = result.get("primary")
    if not primary:
        payload = {
            "status": "blocked",
            "summary": "没有可申请审批的主推荐动作。",
            "next_actions": ["补充更明确的目标语义后重试。"],
            "artifacts": [],
        }
        payload["reply_summary"] = build_reply_summary("intent-resolver", {"approval_request": payload, **result})
        return payload
    if primary.get("blocked"):
        payload = {
            "status": "blocked",
            "summary": "主推荐动作当前存在阻塞条件，无法创建审批票据。",
            "next_actions": primary["blocked"],
            "artifacts": [],
        }
        payload["reply_summary"] = build_reply_summary("intent-resolver", {"approval_request": payload, **result})
        return payload

    policy = primary.get("policy", {})
    if policy.get("approval") == "auto" and policy.get("execution") == "auto":
        payload = {
            "status": "not_required",
            "summary": f"主推荐动作 `{primary['action']}` 已属于 auto 策略，不需要审批票据。",
            "next_actions": ["如需直接执行，请改用 `--execute-safe`。"],
            "artifacts": [],
        }
        payload["reply_summary"] = build_reply_summary("intent-resolver", {"approval_request": payload, **result})
        return payload

    plan = build_execution_plan(result, owner=owner, note=note, focus=focus, strict=strict)
    ownership = infer_approval_ownership(result, owner)
    ownership_conflicts = snapshot_ownership_conflicts(result, ownership)
    action_id = primary["action"]
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    ticket_id = new_intent_approval_id(action_id)
    record = {
        "id": ticket_id,
        "status": "pending",
        "created_at": now,
        "updated_at": now,
        "requested_by": owner,
        "intent": result.get("intent", ""),
        "project_path": result["project"]["path"],
        "project_kind": result["project"]["project_kind"],
        "frontend_id": result.get("frontend", {}).get("id", "generic"),
        "action": action_id,
        "risk_level": policy.get("risk_level", "L3"),
        "approval": policy.get("approval", "explicit_confirm"),
        "execution": policy.get("execution", "blocked_until_approved"),
        "reasons": list(primary.get("reasons", [])),
        "artifacts": list(load_action_registry().get(action_id, {}).get("artifacts", [])),
        "command_hint": primary.get("command_hint", ""),
        "note": note.strip(),
        "focus": focus.strip(),
        "strict": strict,
        "selected_profile": primary.get("selected_profile", ""),
        "selected_workflow": primary.get("selected_workflow", ""),
        "ownership": ownership,
        "ownership_conflicts": ownership_conflicts,
        "plan": plan,
    }
    records = load_intent_approval_records()
    records.append(record)
    save_intent_approval_records(records)
    write_intent_approval_views(records)
    append_log_line(
        intent_control_root() / EXECUTION_LOG_RELATIVE,
        f"- {datetime.now().strftime('%Y-%m-%d')}: 创建 intent 审批票据 `{ticket_id}`，动作 `{action_id}`，项目 `{result['project']['path']}`。",
    )
    payload = {
        "status": "pending_approval",
        "summary": f"已为 `{action_id}` 创建审批票据 `{ticket_id}`。",
        "artifacts": [
            ".factory/process/intent-approvals.json",
            ".factory/process/intent-approvals.md",
            ".factory/memory/intent-approvals.summary.md",
        ],
        "next_actions": ([
            f"运行 `python3 {factory_workspace_root() / 'scripts' / 'factory-dispatch'} intent-approval {ticket_id} --approve --owner \"<owner>\"` 执行审批。",
            f"或运行 `python3 {factory_workspace_root() / 'scripts' / 'factory-dispatch'} intent-approval {ticket_id} --reject --owner \"<owner>\"` 拒绝票据。",
        ] + ([f"当前票据冻结的 ownership 与现有角色分派存在 {len(ownership_conflicts)} 组写集冲突，批准前需先消除冲突。"] if ownership_conflicts else [])),
        "ticket": ticket_id,
        "plan": plan,
        "record": record,
    }
    payload["reply_summary"] = build_reply_summary("intent-resolver", {"approval_request": payload, **result})
    return payload


def execute_primary_safe(result: dict, *, owner: str, note: str, focus: str, strict: bool) -> dict:
    primary = result.get("primary")
    if not primary:
        payload = {
            "status": "blocked",
            "summary": "没有可执行的主推荐动作。",
            "next_actions": ["补充更明确的目标语义后重试。"],
            "artifacts": [],
        }
        payload["reply_summary"] = build_reply_summary("intent-resolver", {"execution": payload, **result})
        return payload
    if primary.get("blocked"):
        payload = {
            "status": "blocked",
            "summary": "主推荐动作当前存在阻塞条件，未执行。",
            "next_actions": primary["blocked"],
            "artifacts": [],
        }
        payload["reply_summary"] = build_reply_summary("intent-resolver", {"execution": payload, **result})
        return payload

    policy = primary.get("policy", {})
    if policy.get("approval") != "auto" or policy.get("execution") != "auto":
        payload = {
            "status": "policy_denied",
            "summary": f"主推荐动作 `{primary['action']}` 的默认策略不是 auto，停止在审批边界。",
            "next_actions": [command_hint(primary["action"], Path(result["project"]["path"]), result["intent"], primary)],
            "artifacts": [],
        }
        payload["reply_summary"] = build_reply_summary("intent-resolver", {"execution": payload, **result})
        return payload

    plan = build_execution_plan(result, owner=owner, note=note, focus=focus, strict=strict)
    step = run_script(plan["script_name"], *plan["arguments"], label=plan["label"])
    artifacts = list(load_action_registry().get(primary["action"], {}).get("artifacts", []))
    next_actions = []
    if step["returncode"] == 0:
        next_actions.append("如需继续自动推进，可基于本轮结果再次调用 intent-resolver。")
        status = "success"
        summary = f"已按安全策略执行 `{primary['action']}`。"
    else:
        next_actions.append("先查看 stderr 和相关产物，再决定是否改为手工入口或补充上下文。")
        status = "error"
        summary = f"`{primary['action']}` 执行失败，返回码 {step['returncode']}。"

    payload = {
        "status": status,
        "summary": summary,
        "artifacts": artifacts,
        "verification": [f"returncode={step['returncode']}"] + ([step["stdout"]] if step["stdout"] else []),
        "next_actions": next_actions,
        "step": step,
        "plan": plan,
    }
    payload["reply_summary"] = build_reply_summary("intent-resolver", {"execution": payload, **result})
    return payload


def approval_guidance(result: dict) -> dict:
    primary = result.get("primary") or {}
    policy = primary.get("policy") or {}
    contract = action_reply_contract("intent-resolver")
    approval_contract = contract.get("approval_ticket", {}) if isinstance(contract, dict) else {}
    risk_levels = {str(item).strip() for item in approval_contract.get("risk_levels", []) if str(item).strip()}
    approval_modes = {str(item).strip() for item in approval_contract.get("approval_modes", []) if str(item).strip()}
    execution_modes = {str(item).strip() for item in approval_contract.get("execution_modes", []) if str(item).strip()}
    risk_level = str(policy.get("risk_level", "")).strip()
    approval_mode = str(policy.get("approval", "")).strip()
    execution_mode = str(policy.get("execution", "")).strip()
    ticket_required = bool(primary) and (
        risk_level in risk_levels or approval_mode in approval_modes or execution_mode in execution_modes
    )
    next_actions = []
    if ticket_required:
        project_path = Path(result["project"]["path"])
        next_actions.append(
            f"运行 `python3 {factory_workspace_root() / 'scripts' / 'factory-dispatch'} intent \"{result['intent']}\" --project \"{project_path}\" --tool {result['frontend']['id']} --request-approval --owner \"<owner>\"` 生成审批票据。"
        )
    return {
        "ticket_required": ticket_required,
        "reason": (
            f"主推荐动作 `{primary.get('action', '')}` 处于 `{risk_level or 'L3'}` 风险级别，需通过审批票据推进。"
            if ticket_required
            else "主推荐动作当前不需要审批票据。"
        ),
        "next_actions": next_actions,
    }


def resolve_intent(intent_text: str, project_root: Path, tool: str = "generic", top: int = 3) -> dict:
    facts = inspect_project(project_root)
    frontend_profile = resolve_frontend_profile(tool.strip(), default_id="generic")
    registry = load_action_registry()
    intent_key = normalize_key(intent_text)
    skill_lifecycle = resolve_skill_lifecycle(intent_text, intent_key, project_root)

    candidates = [
        evaluate_action(spec, intent_text, intent_key, facts, frontend_profile, lifecycle=skill_lifecycle)
        for action_id, spec in registry.items()
        if action_id != "intent-resolver"
    ]

    if not any(item["score"] > 0 for item in candidates):
        fallback_id, fallback_reason = fallback_action(facts)
        for item in candidates:
            if item["action"] == fallback_id:
                item["score"] += 10
                item["reasons"].append(fallback_reason)
                break

    ordered = sorted(
        candidates,
        key=lambda item: (
            -item["score"],
            1 if item["blocked"] else 0,
            item["action"],
        ),
    )

    primary = ordered[0] if ordered else None
    if primary is not None:
        primary["command_hint"] = command_hint(primary["action"], project_root, intent_text, primary)
    for item in ordered[: max(1, top)]:
        item.setdefault("command_hint", command_hint(item["action"], project_root, intent_text, item))

    blocked = [item for item in ordered if item["blocked"] and item["score"] > 0][:2]
    for item in blocked:
        item.setdefault("command_hint", command_hint(item["action"], project_root, intent_text, item))

    payload = {
        "intent": intent_text.strip(),
        "project": facts,
        "frontend": {
            "id": frontend_profile.get("id", "generic"),
            "label": frontend_profile.get("label", "通用 CLI 模型"),
        },
        "primary": primary,
        "candidates": ordered[: max(1, top)],
        "blocked_candidates": blocked,
    }
    payload["approval_guidance"] = approval_guidance(payload)
    payload["reply_summary"] = build_reply_summary("intent-resolver", payload)
    return payload


def render_markdown(result: dict) -> str:
    facts = result["project"]
    primary = result["primary"]
    candidate_lines = []
    for item in result["candidates"]:
        policy = item["policy"]
        reasons = "；".join(item["reasons"]) or "未提供额外理由。"
        blocked = f" | 阻塞：{'；'.join(item['blocked'])}" if item["blocked"] else ""
        subtarget = ""
        if item.get("selected_profile"):
            subtarget = f" | profile：`{item['selected_profile']}`"
        if item.get("selected_workflow"):
            subtarget = f" | workflow：`{item['selected_workflow']}`"
        if item.get("selected_skill_candidate"):
            subtarget = (
                f"{subtarget} | skill：`{item['selected_skill_candidate']}`"
                f" | operation：`{item.get('selected_skill_operation', '') or 'unknown'}`"
            )
        candidate_lines.append(
            f"- `{item['action']}` [{policy.get('risk_level', 'L3')} | {policy.get('approval', 'explicit_confirm')}]"
            f"：{item['description']} | 评分：{item['score']} | 理由：{reasons}{subtarget}{blocked}"
        )

    blocked_lines = []
    for item in result["blocked_candidates"]:
        blocked_lines.append(
            f"- `{item['action']}`：{'；'.join(item['blocked'])}"
        )

    lines = [
        "# 意图解析结果",
        "",
        f"- 输入：{result['intent']}",
        f"- 项目：`{facts['path']}`",
        f"- 项目类型：`{facts['project_kind']}`",
        f"- 当前阶段：`{facts['stage'] or '未知'}`",
        f"- docs 入口：{'有' if facts['docs_exists'] else '无'}",
        f"- 前台：`{result['frontend']['id']}` ({result['frontend']['label']})",
        "",
        "## 主推荐动作",
        "",
        f"- 动作：`{primary['action']}`",
        f"- 风险：`{primary['policy'].get('risk_level', 'L3')}`",
        f"- 审批：`{primary['policy'].get('approval', 'explicit_confirm')}`",
        *([f"- 子目标：`{primary['selected_profile']}`"] if primary.get("selected_profile") else []),
        *([f"- 子目标：`{primary['selected_workflow']}`"] if primary.get("selected_workflow") else []),
        *([f"- 候选 skill：`{primary['selected_skill_candidate']}`"] if primary.get("selected_skill_candidate") else []),
        *([f"- 生命周期动作：`{primary['selected_skill_operation']}`"] if primary.get("selected_skill_operation") else []),
        f"- 理由：{'；'.join(primary['reasons']) or '未提供额外理由。'}",
        f"- 建议命令：`{primary['command_hint']}`",
        "",
        "## 候选动作",
        "",
        *candidate_lines,
    ]
    guidance = result.get("approval_guidance") or {}
    if guidance:
        lines.extend(
            [
                "",
                "## 审批指引",
                "",
                f"- 是否需要票据：`{'yes' if guidance.get('ticket_required') else 'no'}`",
                f"- 说明：{guidance.get('reason', '无')}",
            ]
        )
        for item in guidance.get("next_actions", []):
            lines.append(f"- 下一步：{item}")
    execution = result.get("execution")
    if execution:
        lines.extend(
            [
                "",
                "## 安全执行",
                "",
                f"- 状态：`{execution.get('status', 'unknown')}`",
                f"- 摘要：{execution.get('summary', '无')}",
            ]
        )
        plan = execution.get("plan") or {}
        if plan.get("script_name"):
            lines.append(
                f"- 执行入口：`{plan['script_name']} {' '.join(plan.get('arguments', []))}`"
            )
        step = execution.get("step") or {}
        if step:
            lines.append(f"- 返回码：`{step.get('returncode', 'unknown')}`")
        artifacts = execution.get("artifacts") or []
        if artifacts:
            lines.extend(["- 产物："] + [f"  - `{item}`" for item in artifacts])
        next_actions = execution.get("next_actions") or []
        if next_actions:
            lines.extend(["- 下一步："] + [f"  - {item}" for item in next_actions])
    approval_request = result.get("approval_request")
    if approval_request:
        lines.extend(
            [
                "",
                "## 审批票据",
                "",
                f"- 状态：`{approval_request.get('status', 'unknown')}`",
                f"- 摘要：{approval_request.get('summary', '无')}",
            ]
        )
        if approval_request.get("ticket"):
            lines.append(f"- 票据：`{approval_request['ticket']}`")
        plan = approval_request.get("plan") or {}
        if plan.get("script_name"):
            lines.append(f"- 待执行入口：`{plan['script_name']} {' '.join(plan.get('arguments', []))}`")
        next_actions = approval_request.get("next_actions") or []
        if next_actions:
            lines.extend(["- 下一步："] + [f"  - {item}" for item in next_actions])
    if blocked_lines:
        lines.extend(["", "## 已排除动作", "", *blocked_lines])
    reply_summary = result.get("reply_summary") or {}
    items = reply_summary.get("items") or []
    if items:
        lines.extend(["", "## 对话摘要", ""])
        for item in items:
            value = item.get("value")
            if isinstance(value, list):
                rendered = "；".join(str(part) for part in value)
            else:
                rendered = str(value)
            lines.append(f"- {item.get('label', item.get('path', ''))}：{rendered}")
    return "\n".join(lines).rstrip() + "\n"


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    intent_text = " ".join(args.intent).strip()

    try:
        if args.execute_safe and args.request_approval:
            raise RuntimeError("`--execute-safe` 与 `--request-approval` 不能同时使用。")
        result = resolve_intent(intent_text, project_root, tool=args.tool, top=args.top)
        if args.execute_safe:
            result["execution"] = execute_primary_safe(
                result,
                owner=args.owner.strip(),
                note=args.note.strip(),
                focus=args.focus.strip(),
                strict=args.strict,
            )
        if args.request_approval:
            result["approval_request"] = request_primary_approval(
                result,
                owner=args.owner.strip(),
                note=args.note.strip(),
                focus=args.focus.strip(),
                strict=args.strict,
            )
        result["reply_summary"] = build_reply_summary("intent-resolver", result)
    except Exception as exc:
        print(f"意图解析失败：{exc}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return 0

    print(render_markdown(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
