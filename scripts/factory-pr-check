#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    git_branch_exists,
    is_git_repo,
    load_pr_records,
    load_project_config,
    pr_status_text,
    project_lock,
    save_project_config,
    selected_pr_records,
    upsert_section,
    write_text,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="对 PR 做预检查，判断是否准备好进入评审、合并或 Gate。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--prs", default="", help="要检查的 PR，逗号分隔；默认检查活跃 PR。")
    parser.add_argument("--owner", default="项目协调者", help="检查执行人。")
    parser.add_argument(
        "--mode",
        choices=["review-ready", "merge-ready", "gate-ready"],
        default="review-ready",
        help="检查模式。",
    )
    parser.add_argument("--strict", action="store_true", help="若结果不是通过，则返回非 0。")
    return parser.parse_args()


def evaluate_record(record: dict, mode: str, git_repo: bool, project_root: Path) -> tuple[str, list[str]]:
    checks: list[str] = []
    failures = 0
    warnings = 0

    if record.get("items"):
        checks.append(f"- 关联工作项：通过，{len(record.get('items', []))} 个。")
    else:
        checks.append("- 关联工作项：未通过，缺少关联工作项。")
        failures += 1

    if record.get("docs") or record.get("tests") or record.get("code"):
        checks.append("- 变更资产：通过，已记录代码/文档/测试资产。")
    else:
        checks.append("- 变更资产：关注，尚未记录代码/文档/测试资产。")
        warnings += 1

    if git_repo and record.get("provider") == "git-local":
        branch = record.get("branch", "")
        target = record.get("base_branch", "main")
        if branch and git_branch_exists(project_root, branch):
            checks.append(f"- 本地分支：通过，源分支 `{branch}` 存在。")
        elif record.get("status") == "merged":
            checks.append("- 本地分支：通过，PR 已合并，允许源分支不存在。")
        else:
            checks.append(f"- 本地分支：未通过，源分支 `{branch or '未记录'}` 不存在。")
            failures += 1
        checks.append(f"- 目标分支：{'通过' if target and git_branch_exists(project_root, target) else '未通过'}，`{target or '未记录'}`。")
        if not target or not git_branch_exists(project_root, target):
            failures += 1

    if mode == "review-ready":
        if record.get("status") == "draft":
            checks.append("- 评审准备：关注，当前仍是草稿 PR。")
            warnings += 1
        else:
            checks.append(f"- 评审准备：通过，当前状态 `{pr_status_text(record)}`。")
    elif mode == "merge-ready":
        if record.get("review_result") == "通过" and record.get("checks_result") == "通过":
            checks.append("- 合并准备：通过，评审结果和检查结果均已通过。")
        else:
            checks.append(
                f"- 合并准备：未通过，评审 `{record.get('review_result', '待评审')}`，检查 `{record.get('checks_result', '待检查')}`。"
            )
            failures += 1
    elif mode == "gate-ready":
        if record.get("status") == "merged":
            checks.append("- Gate 准备：通过，PR 已合并。")
        else:
            checks.append(f"- Gate 准备：未通过，当前状态 `{pr_status_text(record)}`。")
            failures += 1

    if failures:
        return "未通过", checks
    if warnings:
        return "关注", checks
    return "通过", checks


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    result = "未通过"

    try:
        with project_lock(project_root, reason="执行 PR 检查"):
            config = load_project_config(project_root)
            records = load_pr_records(project_root)
            selected = selected_pr_records(records, args.prs, default_active=True)
            git_repo = is_git_repo(project_root)
            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

            if not selected and args.mode == "gate-ready":
                result = "通过"
                latest_lines = [
                    f"- 时间：{now_text}",
                    f"- 模式：{args.mode}",
                    f"- 检查人：{args.owner.strip()}",
                    "- 结果：通过",
                    "- 说明：当前没有活跃 PR，可进入 Gate。",
                ]
                detail_lines = ["- 当前无活跃 PR。"]
            else:
                per_lines: list[str] = []
                results: list[str] = []
                for record in selected:
                    status, checks = evaluate_record(record, args.mode, git_repo, project_root)
                    results.append(status)
                    per_lines.append(f"### {record.get('id', '未知 PR')} {record.get('title', '未命名 PR')}")
                    per_lines.append(f"- 当前状态：{pr_status_text(record)}")
                    per_lines.append(f"- 检查结果：{status}")
                    per_lines.extend(checks)
                    per_lines.append("")
                detail_lines = per_lines[:-1] if per_lines else ["- 无"]
                if "未通过" in results:
                    result = "未通过"
                elif "关注" in results:
                    result = "关注"
                else:
                    result = "通过"
                latest_lines = [
                    f"- 时间：{now_text}",
                    f"- 模式：{args.mode}",
                    f"- 检查人：{args.owner.strip()}",
                    f"- 结果：{result}",
                    f"- PR 数：{len(selected)}",
                ]

            doc_path = project_root / ".factory" / "process" / "pr-check-report.md"
            upsert_section(doc_path, "## 最新检查", latest_lines, default_title="# PR 检查报告")
            upsert_section(doc_path, "## 检查详情", detail_lines, default_title="# PR 检查报告")

            write_text(
                project_root / ".factory" / "memory" / "pr-check.summary.md",
                "\n".join(
                    [
                        "# PR 检查摘要",
                        "",
                        *latest_lines,
                        "",
                        "## 检查详情",
                        "",
                        *detail_lines,
                    ]
                ),
            )

            config["last_pr_check_at"] = now_text
            config["last_pr_check_result"] = result
            config["last_pr_check_mode"] = args.mode
            config.setdefault("pr_checks", []).append(
                {
                    "mode": args.mode,
                    "owner": args.owner.strip(),
                    "result": result,
                    "prs": [record.get("id") for record in selected],
                    "checked_at": now_text,
                }
            )
            save_project_config(project_root, config)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 执行 PR 检查，模式：{args.mode}，结果：{result}。",
            )
    except Exception as exc:
        print(f"PR 检查失败：{exc}", file=sys.stderr)
        return 1

    print(f"已完成 PR 检查：{args.mode} -> {result}")
    if args.strict and result != "通过":
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
