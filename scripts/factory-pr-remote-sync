#!/usr/bin/env python3

import argparse
import json
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    infer_remote_tool,
    json_step,
    load_pr_records,
    load_project_config,
    normalize_remote_tool,
    parse_list,
    project_lock,
    refresh_ai_memory,
    remote_checks_result_from_states,
    remote_review_result_from_value,
    remote_status_from_state,
    pr_status_text,
    save_pr_records,
    save_project_config,
    selected_pr_records,
    unique_preserve,
    upsert_item_pr_section,
    write_pr_tracker,
    write_remote_pr_tracker,
    write_text,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="从远程仓库同步 PR 状态、检查结果和远端地址。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--pr", default="", help="单个 PR，例如 PR-001。")
    parser.add_argument("--prs", default="", help="多个 PR，逗号分隔；默认同步活跃 PR。")
    parser.add_argument("--owner", default="项目协调者", help="执行人。")
    parser.add_argument(
        "--tool",
        choices=["auto", "gh", "glab", "record-only"],
        default="auto",
        help="远程工具类型。",
    )
    parser.add_argument("--remote-id", default="", help="手工记录模式下使用的远端编号。")
    parser.add_argument("--remote-url", default="", help="手工记录模式下使用的远端地址。")
    parser.add_argument("--remote-state", default="", help="手工记录模式下使用的远端状态，例如 open/merged。")
    parser.add_argument("--review-state", default="", help="手工记录模式下使用的远端评审状态。")
    parser.add_argument("--checks-state", default="", help="手工记录模式下使用的远端检查状态。")
    parser.add_argument("--strict", action="store_true", help="若存在同步失败则返回非 0。")
    return parser.parse_args()


def collect_pr_queries(args: argparse.Namespace) -> str:
    values = []
    if args.pr.strip():
        values.append(args.pr.strip())
    values.extend(parse_list(args.prs))
    return ",".join(unique_preserve(values))


def gh_identifier(record: dict) -> str:
    return str(record.get("remote_id") or record.get("branch") or record.get("remote_url") or record.get("id"))


def glab_identifier(record: dict) -> str:
    return str(record.get("remote_id") or record.get("branch") or record.get("id"))


def sync_from_gh(project_root: Path, record: dict) -> tuple[dict, dict]:
    identifier = gh_identifier(record)
    step, payload = json_step(
        [
            "gh",
            "pr",
            "view",
            identifier,
            "--json",
            "number,url,state,isDraft,reviewDecision,mergeStateStatus,headRefName,baseRefName,statusCheckRollup",
        ],
        f"同步远端 PR {identifier}",
        cwd=project_root,
    )
    if not isinstance(payload, dict):
        raise RuntimeError("GitHub 返回了非对象 JSON。")

    rollup = payload.get("statusCheckRollup") or []
    states: list[str] = []
    if isinstance(rollup, list):
        for item in rollup:
            if not isinstance(item, dict):
                continue
            states.append(str(item.get("conclusion") or item.get("state") or item.get("status") or ""))

    review_result = remote_review_result_from_value(str(payload.get("reviewDecision", "")))
    checks_result = remote_checks_result_from_states(states)
    remote_state = "draft" if payload.get("isDraft") else str(payload.get("state", "open")).lower()
    updated = dict(record)
    updated["remote_provider"] = "gh"
    updated["remote_id"] = str(payload.get("number") or updated.get("remote_id", "")).strip()
    updated["remote_url"] = str(payload.get("url") or updated.get("remote_url", "")).strip()
    updated["remote_state"] = remote_state
    updated["remote_review_state"] = str(payload.get("reviewDecision", "")).strip()
    updated["remote_checks_state"] = checks_result
    updated["remote_branch"] = str(payload.get("headRefName") or updated.get("branch", "")).strip()
    updated["remote_base_branch"] = str(payload.get("baseRefName") or updated.get("base_branch", "main")).strip()
    updated["review_result"] = review_result
    updated["checks_result"] = checks_result
    updated["status"] = remote_status_from_state(remote_state, draft=payload.get("isDraft", False), review_result=review_result)
    if updated["status"] == "merged":
        updated["merge_status"] = "已合并"
    updated["remote_synced_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    updated["updated_at"] = updated["remote_synced_at"]
    return updated, step


def sync_from_glab(project_root: Path, record: dict) -> tuple[dict, dict]:
    identifier = glab_identifier(record)
    step, payload = json_step(
        ["glab", "mr", "view", identifier, "--output", "json"],
        f"同步远端 MR {identifier}",
        cwd=project_root,
    )
    if not isinstance(payload, dict):
        raise RuntimeError("GitLab 返回了非对象 JSON。")

    approvals = payload.get("approved_by") or []
    approved_count = len(approvals) if isinstance(approvals, list) else 0
    raw_state = str(payload.get("state") or ("merged" if payload.get("merged_at") else "open")).lower()
    review_result = remote_review_result_from_value(str(payload.get("review_decision", "")), approved_count=approved_count)
    checks_result = remote_checks_result_from_states(
        [
            str(payload.get("detailed_merge_status", "") or ""),
            str(payload.get("merge_status", "") or ""),
        ]
    )
    updated = dict(record)
    updated["remote_provider"] = "glab"
    updated["remote_id"] = str(payload.get("iid") or payload.get("id") or updated.get("remote_id", "")).strip()
    updated["remote_url"] = str(payload.get("web_url") or updated.get("remote_url", "")).strip()
    updated["remote_state"] = raw_state
    updated["remote_review_state"] = str(payload.get("review_decision", "") or "").strip()
    updated["remote_checks_state"] = checks_result
    updated["remote_branch"] = str(payload.get("source_branch") or updated.get("branch", "")).strip()
    updated["remote_base_branch"] = str(payload.get("target_branch") or updated.get("base_branch", "main")).strip()
    updated["review_result"] = review_result
    updated["checks_result"] = checks_result
    updated["status"] = remote_status_from_state(raw_state, draft=bool(payload.get("draft")), review_result=review_result)
    if updated["status"] == "merged":
        updated["merge_status"] = "已合并"
    updated["remote_synced_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    updated["updated_at"] = updated["remote_synced_at"]
    return updated, step


def sync_record_only(record: dict, args: argparse.Namespace) -> tuple[dict, dict]:
    now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    review_result = remote_review_result_from_value(args.review_state.strip())
    checks_result = args.checks_state.strip() or record.get("checks_result", "待检查")
    remote_state = args.remote_state.strip() or record.get("remote_state", "open")
    updated = dict(record)
    updated["remote_provider"] = "record-only"
    if args.remote_id.strip():
        updated["remote_id"] = args.remote_id.strip()
    if args.remote_url.strip():
        updated["remote_url"] = args.remote_url.strip()
    updated["remote_state"] = remote_state
    updated["remote_review_state"] = args.review_state.strip()
    updated["remote_checks_state"] = checks_result
    updated["review_result"] = review_result if review_result != "待评审" else updated.get("review_result", "待评审")
    updated["checks_result"] = checks_result
    updated["status"] = remote_status_from_state(
        remote_state,
        draft=remote_state.strip().lower() == "draft",
        review_result=updated.get("review_result", "待评审"),
    )
    if updated["status"] == "merged":
        updated["merge_status"] = "已合并"
    updated["remote_synced_at"] = now_text
    updated["updated_at"] = now_text
    return updated, {
        "label": "手工记录远端状态",
        "command": "record-only",
        "returncode": 0,
        "stdout": "已按手工参数写入远端状态。",
        "stderr": "",
    }


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    result = 0

    try:
        with project_lock(project_root, reason="同步远端 PR 状态"):
            config = load_project_config(project_root)
            records = load_pr_records(project_root)
            selected = selected_pr_records(records, collect_pr_queries(args), default_active=True)
            if not selected:
                raise RuntimeError("没有找到要同步的 PR。")

            updated_lookup: dict[str, dict] = {}
            step_lines: list[str] = []
            latest_lines: list[str] = []
            failures: list[str] = []
            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

            for record in selected:
                tool = normalize_remote_tool(
                    args.tool if args.tool != "auto" else record.get("remote_provider") or infer_remote_tool(project_root)
                )
                try:
                    if tool == "gh":
                        updated, step = sync_from_gh(project_root, record)
                    elif tool == "glab":
                        updated, step = sync_from_glab(project_root, record)
                    else:
                        updated, step = sync_record_only(record, args)
                    updated.setdefault("history", []).append(
                        {"action": "remote-sync", "owner": args.owner.strip(), "time": now_text, "tool": tool}
                    )
                    updated_lookup[updated["id"]] = updated
                    step_lines.append(f"- {step['label']}：成功")
                    if step["stdout"]:
                        step_lines.append(f"  输出：{step['stdout']}")
                    latest_lines.append(
                        f"- {updated['id']}：状态 {pr_status_text(updated)}，远端 {updated.get('remote_provider', '未记录')}#{updated.get('remote_id', '无') or '无'}"
                    )
                except Exception as exc:
                    failures.append(f"{record.get('id', '未知 PR')}: {exc}")
                    step_lines.append(f"- 同步 `{record.get('id', '未知 PR')}`：失败，{exc}")

            normalized_records = [updated_lookup.get(item.get("id"), item) for item in records]
            save_pr_records(project_root, normalized_records)
            for record in updated_lookup.values():
                for item_id in record.get("items", []):
                    upsert_item_pr_section(project_root, item_id, record)

            latest_header_lines = [
                f"- 时间：{now_text}",
                f"- 执行人：{args.owner.strip()}",
                f"- 同步 PR 数：{len(selected)}",
                f"- 失败数：{len(failures)}",
            ]
            latest_header_lines.extend(latest_lines or ["- 无"])
            history_line = f"- {now_text}: 远端同步 {len(selected)} 个 PR，执行人：{args.owner.strip()}。"
            write_pr_tracker(project_root, "## 最新远端同步", latest_header_lines, step_lines, normalized_records, history_line)
            write_remote_pr_tracker(project_root, "## 最新远端同步", latest_header_lines, step_lines, normalized_records, history_line)
            write_text(
                project_root / ".factory" / f"pr-remote-sync.{datetime.now().strftime('%Y%m%d-%H%M%S-%f')}.json",
                json.dumps({"updated": list(updated_lookup.keys()), "failures": failures}, ensure_ascii=False, indent=2),
            )

            config["last_pr_remote_action_at"] = now_text
            config["last_pr_remote_action"] = "sync"
            config["last_pr_remote_result"] = "失败" if failures else "成功"
            config.setdefault("pr_remote_actions", []).append(
                {
                    "action": "sync",
                    "owner": args.owner.strip(),
                    "prs": [record.get("id") for record in selected],
                    "time": now_text,
                    "failures": failures,
                }
            )
            save_project_config(project_root, config)
            refresh_ai_memory(project_root)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 远端同步 PR {len(selected)} 个，失败 {len(failures)} 个，执行人：{args.owner.strip()}。",
            )

            if failures and args.strict:
                result = 2
    except Exception as exc:
        print(f"远端 PR 同步失败：{exc}", file=sys.stderr)
        return 1

    print("已完成远端 PR 同步。")
    return result


if __name__ == "__main__":
    raise SystemExit(main())
