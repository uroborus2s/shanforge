#!/usr/bin/env python3

import argparse
import json
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    find_item_file,
    git_branch_exists,
    git_current_branch,
    git_head_commit,
    is_git_repo,
    load_pr_records,
    load_project_config,
    next_sequence_id,
    parse_list,
    parse_work_item,
    pr_status_text,
    project_lock,
    refresh_ai_memory,
    run_step,
    save_pr_records,
    save_project_config,
    slugify,
    unique_preserve,
    upsert_item_pr_section,
    write_text,
    write_pr_tracker,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="为工作项创建或登记一个 PR，并可选创建本地分支。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--item", default="", help="单个工作项编号，例如 TASK-001。")
    parser.add_argument("--items", default="", help="多个工作项编号，逗号分隔。")
    parser.add_argument("--title", default="", help="PR 标题。")
    parser.add_argument("--owner", default="待记录", help="PR 发起人。")
    parser.add_argument("--reviewers", default="", help="评审人，逗号分隔。")
    parser.add_argument("--docs", default="", help="本次 PR 涉及的文档，逗号分隔。")
    parser.add_argument("--tests", default="", help="本次 PR 涉及的测试，逗号分隔。")
    parser.add_argument("--code", default="", help="本次 PR 涉及的代码文件，逗号分隔。")
    parser.add_argument("--summary", default="", help="PR 摘要。")
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--base-branch", default="", help="目标分支。")
    parser.add_argument("--branch", default="", help="源分支名称。")
    parser.add_argument(
        "--provider",
        choices=["auto", "record-only", "git-local"],
        default="auto",
        help="PR 执行模式。auto 会在 git 仓库中优先使用 git-local。",
    )
    parser.add_argument("--draft", action="store_true", help="将 PR 标记为草稿。")
    parser.add_argument("--no-checkout", action="store_true", help="仅记录 PR，不自动切换或创建分支。")
    return parser.parse_args()


def collect_item_ids(args: argparse.Namespace) -> list[str]:
    values = []
    if args.item.strip():
        values.append(args.item.strip())
    values.extend(parse_list(args.items))
    return unique_preserve(values)


def default_title_for_items(project_root: Path, item_ids: list[str]) -> str:
    primary = parse_work_item(find_item_file(project_root, item_ids[0]))
    return f"{primary['id']} {primary['title']}"


def default_branch_name(item_id: str, title: str) -> str:
    suffix = slugify(title, fallback="")
    return f"pr/{item_id.lower()}" + (f"-{suffix}" if suffix else "")


def determine_provider(requested: str, git_repo: bool) -> str:
    if requested == "auto":
        return "git-local" if git_repo else "record-only"
    if requested == "git-local" and not git_repo:
        return "record-only"
    return requested


def ensure_branch(project_root: Path, branch: str, base_branch: str) -> list[dict]:
    steps: list[dict] = []
    if git_branch_exists(project_root, branch):
        steps.append(run_step(["git", "checkout", branch], f"切换到 {branch}", cwd=project_root))
        return steps
    command = ["git", "checkout", "-b", branch]
    if base_branch:
        command.append(base_branch)
    steps.append(run_step(command, f"创建分支 {branch}", cwd=project_root))
    return steps


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason="创建 PR 记录"):
            load_project_config(project_root)
            item_ids = collect_item_ids(args)
            if not item_ids:
                raise RuntimeError("必须传入 --item 或 --items。")
            for item_id in item_ids:
                find_item_file(project_root, item_id)

            title = args.title.strip() or default_title_for_items(project_root, item_ids)
            git_repo = is_git_repo(project_root)
            provider = determine_provider(args.provider, git_repo)
            current_branch = git_current_branch(project_root) if git_repo else "main"
            base_branch = args.base_branch.strip() or current_branch or "main"
            branch = args.branch.strip() or default_branch_name(item_ids[0], title)
            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

            steps: list[dict] = []
            if provider == "git-local" and not args.no_checkout:
                steps.extend(ensure_branch(project_root, branch, base_branch))
                failures = [step for step in steps if step["returncode"] != 0]
                if failures:
                    failed = failures[0]
                    raise RuntimeError(failed["stderr"] or failed["stdout"] or f"{failed['label']}失败")

            records = load_pr_records(project_root)
            pr_id = next_sequence_id(records, "PR-")
            record = {
                "id": pr_id,
                "title": title,
                "items": item_ids,
                "owner": args.owner.strip(),
                "reviewers": parse_list(args.reviewers),
                "docs": parse_list(args.docs),
                "tests": parse_list(args.tests),
                "code": parse_list(args.code),
                "summary": args.summary.strip(),
                "note": args.note.strip(),
                "provider": provider,
                "base_branch": base_branch,
                "branch": branch,
                "status": "draft" if args.draft else "open",
                "review_result": "待评审",
                "checks_result": "待检查",
                "merge_status": "未合并",
                "created_at": now_text,
                "updated_at": now_text,
                "head_commit": git_head_commit(project_root) if git_repo else "",
                "history": [
                    {
                        "action": "start",
                        "owner": args.owner.strip(),
                        "time": now_text,
                        "note": args.note.strip() or args.summary.strip(),
                    }
                ],
            }
            records.append(record)
            save_pr_records(project_root, records)

            for item_id in item_ids:
                upsert_item_pr_section(project_root, item_id, record)

            latest_lines = [
                f"- 时间：{now_text}",
                f"- PR：{pr_id}",
                f"- 标题：{title}",
                f"- 发起人：{args.owner.strip()}",
                f"- 工作项：{'、'.join(item_ids)}",
                f"- 状态：{pr_status_text(record)}",
                f"- 源分支：{branch}",
                f"- 目标分支：{base_branch}",
                f"- 模式：{provider}",
                f"- 摘要：{args.summary.strip() or '无'}",
                f"- 备注：{args.note.strip() or '无'}",
            ]
            step_lines = []
            for step in steps:
                step_lines.append(f"- {step['label']}：{'成功' if step['returncode'] == 0 else f'失败({step['returncode']})'}")
                if step["stdout"]:
                    step_lines.append(f"  输出：{step['stdout']}")
                if step["stderr"]:
                    step_lines.append(f"  错误：{step['stderr']}")
            if not step_lines:
                step_lines = ["- 本次仅登记 PR 记录，没有执行本地 git 动作。"]

            history_line = f"- {now_text}: 创建 `{pr_id}`，工作项：{'、'.join(item_ids)}，发起人：{args.owner.strip()}。"
            write_pr_tracker(project_root, "## 最新 PR 动作", latest_lines, step_lines, records, history_line)
            write_text(project_root / f".factory/pr-start.{pr_id}.json", json.dumps(record, ensure_ascii=False, indent=2))

            config = load_project_config(project_root)
            config["last_pr_action_at"] = now_text
            config["last_pr_action"] = "start"
            config["last_pr_id"] = pr_id
            config.setdefault("pr_actions", []).append(
                {
                    "action": "start",
                    "pr": pr_id,
                    "items": item_ids,
                    "owner": args.owner.strip(),
                    "time": now_text,
                }
            )
            save_project_config(project_root, config)
            refresh_ai_memory(project_root)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 创建 `{pr_id}`，工作项 {len(item_ids)} 个，发起人：{args.owner.strip()}。",
            )
    except Exception as exc:
        print(f"创建 PR 失败：{exc}", file=sys.stderr)
        return 1

    print(f"已创建 PR：{pr_id}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
