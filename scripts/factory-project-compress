    runtime_protocol = software_factory_reference_path(project_root, "ai-runtime-protocol.md")
    role_charter = software_factory_reference_path(project_root, "ai-role-charter.md")
    return "\n".join(
        [
            "# Gemini 项目说明",
            "",
            "默认先读压缩入口，不要全文加载长篇说明。",
            "",
            "项目根目录：`.`",
            f"项目名称：`{config.get('project_name', project_root.name)}`",
            "",
            "优先读取顺序：",
            "- `.factory/memory/runtime-brief.md`",
            "- `.factory/memory/role-charter.project.md`",
            "- `.factory/memory/doc-map.md`",
            "- `.factory/project.json`",
            "- `.factory/memory/current-state.md`",
            "- `.factory/memory/motivation-state.md`",
            "- `.factory/memory/autonomy-rules.md`",
            "- `.factory/memory/evolution-baseline.md`",
            "- 相关 summary 文档",
            "- 必要时按 `doc-map.md` 单文件回源正式文档",
            "",
            "全局补充协议：",
            f"- `{runtime_protocol}`",
            f"- `{role_charter}`",
            "",
            "Gemini 默认职责：",
            "- 需求、分析、架构、影响分析、复核",
            "",
            "规则：",
            "- 默认只读压缩入口、项目事实和 summary。",
            "- 禁止默认把阶段 `docs/` 文档列入“先读”。",
            "- 禁止每次开工都去读 `project-charter.md`、`input.md`、`user-guide.md` 或其他人类长文。",
            "- 禁止跳过 `.factory/memory/*` 直接回源正式文档。",
            "- 禁止把 skill 当成命令目录；命令执行统一走 `factory-dispatch`、`action-registry` 和 `scripts/factory-*`。",
            "- `AGENTS.md` / `GEMINI.md` 只保留稳定协作入口，不写安装结果、测试状态或当天运行结论。",
            "- 编写需求后，如 summary 不足，再单文件回源 `requirements-verification.md`。",
            "- 进入实现前必须单文件回源 `technical-selection.md`。",
            "- 需要视觉交付时，先读设计相关 summary，不足时再回源 `ux-ui-design.md` 和设计资产。",
        ]
    ).rstrip() + "\n"


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason="生成项目压缩入口"):
            config = load_project_config(project_root)
            runtime_path = project_root / ".factory" / "memory" / "runtime-brief.md"
            role_path = project_root / ".factory" / "memory" / "role-charter.project.md"
            doc_map_path = project_root / ".factory" / "memory" / "doc-map.md"

            runtime_path.write_text(build_runtime_brief(project_root, config, args.owner.strip(), args.note.strip()), encoding="utf-8")
            role_path.write_text(build_role_charter_project(project_root, config, args.owner.strip()), encoding="utf-8")
            doc_map_path.write_text(build_doc_map(project_root), encoding="utf-8")
            (project_root / "AGENTS.md").write_text(build_agents_md(project_root, config), encoding="utf-8")
            (project_root / "GEMINI.md").write_text(build_gemini_md(project_root, config), encoding="utf-8")

            config["compressed_entry_docs"] = [
                str(runtime_path),
                str(role_path),
                str(doc_map_path),
            ]
            config["last_project_compress_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_project_compress_owner"] = args.owner.strip()
            save_project_config(project_root, config)

            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 生成项目压缩入口文档并刷新 `AGENTS.md` / `GEMINI.md`，负责人：{args.owner.strip()}，备注：{args.note.strip() or '无'}。",
            )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"生成项目压缩入口失败：{exc}", file=sys.stderr)
        return 1

    print(f"已生成项目压缩入口：{runtime_path}、{role_path}、{doc_map_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
