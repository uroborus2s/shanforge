#!/usr/bin/env python3

import argparse
import os
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    collect_items,
    current_tech_profile,
    latest_dir_id,
    load_project_config,
    project_lock,
    read_risks,
    refresh_ai_memory,
    save_project_config,
)


SUMMARY_MAP = {
    "docs/04-project-development/03-requirements/prd.md": [".factory/memory/prd.summary.md", ".factory/memory/requirements-verification.summary.md"],
    "docs/04-project-development/03-requirements/requirements-analysis.md": [".factory/memory/requirements-verification.summary.md"],
    "docs/04-project-development/04-design/system-architecture.md": [".factory/memory/architecture.summary.md"],
    "docs/04-project-development/04-design/backend-design.md": [".factory/memory/architecture.summary.md"],
    "docs/04-project-development/04-design/database-design.md": [".factory/memory/architecture.summary.md"],
    "docs/04-project-development/04-design/api-design.md": [".factory/memory/api.summary.md"],
    "docs/04-project-development/04-design/ux-ui-design.md": [".factory/memory/ui.summary.md", ".factory/memory/design-assets.summary.md"],
    "docs/04-project-development/04-design/technical-selection.md": [".factory/memory/tech-stack.summary.md"],
    "docs/04-project-development/06-testing-verification/test-plan.md": [".factory/memory/tests.summary.md"],
    "docs/04-project-development/06-testing-verification/test-report.md": [".factory/memory/tests.summary.md"],
    ".factory/process/stage-check-report.md": [".factory/memory/stage-check.summary.md"],
    ".factory/process/quality-check-report.md": [".factory/memory/quality-check.summary.md"],
    ".factory/process/state-doctor-report.md": [".factory/memory/state-doctor.summary.md"],
    ".factory/process/team-energy.md": [".factory/memory/motivation-state.md", ".factory/memory/autonomy-rules.md"],
    ".factory/process/recovery-review.md": [".factory/memory/recovery-playbook.md"],
    ".factory/process/pattern-fix-report.md": [".factory/memory/pattern-fix.summary.md", ".factory/memory/evolution-baseline.md"],
    "docs/04-project-development/10-traceability/requirements-matrix.md": [".factory/memory/traceability.summary.md", ".factory/memory/graph/traceability.json"],
}


def factory_workspace_root() -> Path:
    return Path(__file__).resolve().parent.parent


def relative_factory_path(project_root: Path, path: Path) -> str:
    return Path(os.path.relpath(path.resolve(), project_root.resolve())).as_posix()


def factory_dispatch_path(project_root: Path) -> str:
    return relative_factory_path(project_root, factory_workspace_root() / "scripts" / "factory-dispatch")


def software_factory_reference_path(project_root: Path, name: str) -> str:
    return relative_factory_path(project_root, factory_workspace_root() / "skills" / "software-factory-cli" / "references" / name)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="为项目生成更短的 AI 入口文档，并刷新 AGENTS.md / GEMINI.md 到项目级压缩入口。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--owner", default="项目协调者", help="负责人。")
    parser.add_argument("--note", default="", help="补充说明。")
    return parser.parse_args()


def project_docs(project_root: Path) -> list[Path]:
    return sorted(path for path in (project_root / "docs").rglob("*.md") if path.is_file())


def readable_stage_docs(config: dict) -> list[str]:
    stage = str(config.get("stage", "BRAINSTORM"))
    mapping = {
        "BRAINSTORM": ["docs/04-project-development/02-discovery/input.md", "docs/04-project-development/02-discovery/brainstorm-record.md"],
        "REQUIREMENTS": ["docs/04-project-development/03-requirements/prd.md", "docs/04-project-development/03-requirements/requirements-analysis.md", "docs/04-project-development/03-requirements/requirements-verification.md"],
        "ANALYSIS": ["docs/04-project-development/03-requirements/prd.md", "docs/04-project-development/03-requirements/requirements-analysis.md", "docs/04-project-development/03-requirements/requirements-verification.md"],
        "DESIGN": ["docs/04-project-development/04-design/technical-selection.md", "docs/04-project-development/04-design/system-architecture.md", "docs/04-project-development/04-design/api-design.md", "docs/04-project-development/04-design/backend-design.md", "docs/04-project-development/04-design/ux-ui-design.md"],
        "PLAN": ["docs/04-project-development/05-development-process/wbs.md", "docs/04-project-development/05-development-process/task-breakdown.md", "docs/04-project-development/05-development-process/implementation-plan.md"],
        "IMPLEMENTATION": ["docs/04-project-development/05-development-process/implementation-plan.md", "docs/04-project-development/04-design/technical-selection.md", "docs/04-project-development/04-design/api-design.md", "docs/04-project-development/04-design/backend-design.md"],
        "TESTING": ["docs/04-project-development/06-testing-verification/test-plan.md", "docs/04-project-development/06-testing-verification/test-report.md"],
        "ACCEPTANCE": [".factory/process/stage-check-report.md", ".factory/process/quality-check-report.md"],
        "RELEASE": ["docs/04-project-development/07-release-delivery/release-notes.md", "docs/04-project-development/08-operations-maintenance/deployment-guide.md", "docs/02-user-guide/user-guide.md"],
        "MAINTENANCE": ["docs/04-project-development/09-evolution/retrospective.md", "docs/04-project-development/10-traceability/requirements-matrix.md"],
    }
    return mapping.get(stage, [])


def stage_summary_candidates(stage_docs: list[str]) -> list[str]:
    ordered: list[str] = []
    seen: set[str] = set()
    for relative in stage_docs:
        for candidate in SUMMARY_MAP.get(relative, []):
            if candidate in seen:
                continue
            seen.add(candidate)
            ordered.append(candidate)
    return ordered


def build_runtime_brief(project_root: Path, config: dict, owner: str, note: str) -> str:
    dispatch_path = factory_dispatch_path(project_root)
    items = collect_items(project_root)
    active_items = [item for item in items if item["status"] not in {"已完成", "已关闭", "已发布", "已移交"}]
    blocked_items = [item for item in items if item["status"] == "阻塞"]
    open_risks, _ = read_risks(project_root)
    tech = current_tech_profile(config)
    stage_docs = readable_stage_docs(config)
    stage_summaries = stage_summary_candidates(stage_docs)
    latest_release = latest_dir_id(project_root, "releases", "REL-")
    latest_handover = latest_dir_id(project_root, "handover", "HO-")
    latest_snapshot = latest_dir_id(project_root, "snapshots", "SNAP-")
    lines = [
        "# 项目压缩运行卡",
        "",
        f"- 生成时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 负责人：{owner}",
        f"- 项目：{config.get('project_name', project_root.name)}",
        f"- 当前阶段：{config.get('stage', '未知')}",
        f"- 当前模式：{config.get('active_mode', '未知')}",
        f"- 技术画像：{tech.get('title', '未登记') or '未登记'}",
        f"- 技术栈：{tech.get('stack', config.get('stack', '未设置')) or '未设置'}",
        f"- 活跃工作项：{len(active_items)}",
        f"- 阻塞项：{len(blocked_items)}",
        f"- 开放风险：{len(open_risks)}",
        f"- 最近发布包：{latest_release}",
        f"- 最近交接包：{latest_handover}",
        f"- 最近快照：{latest_snapshot}",
        f"- 备注：{note or '无'}",
        "",
        "## AI 最小读取顺序",
        "",
        "1. 先读本文件 `/.factory/memory/runtime-brief.md`",
        "2. 再读 `/.factory/memory/role-charter.project.md`",
        "3. 再读 `/.factory/memory/doc-map.md`",
        "4. 再读 `/.factory/project.json`、`/.factory/memory/project-index.md`、`/.factory/memory/current-state.md`",
        "5. 再读 `/.factory/memory/motivation-state.md`、`/.factory/memory/autonomy-rules.md`、`/.factory/memory/evolution-baseline.md`",
        "6. 再读当前阶段相关 summary；禁止默认直读阶段 `docs/`",
        "7. 只有当 summary 不足以支撑当前任务时，才允许按 `doc-map.md` 单文件回源正式文档",
        "",
        "## 当前阶段优先摘要",
        "",
    ]
    lines.extend(f"- `{path}`" for path in stage_summaries or ["无"])
    lines.extend(
        [
            "",
            "## 必要时回源的正式文档",
            "",
        ]
    )
    lines.extend(f"- `{path}`" for path in stage_docs or ["无"])
    lines.extend(
        [
            "",
            "## 必守规则",
            "",
            "- 不跳阶段。",
            "- 代码类工作必须走 PR 闭环后再关单。",
            "- 任何已接受变更都要同步代码、文档、测试、`.factory/memory/`。",
            "- 遇到阻塞、空转或质量漂移时，优先执行 `factory-dispatch recovery`。",
            "- 发现问题时优先做模式级修复，再把有效做法沉淀到 `evolution-baseline.md`。",
            "- 任务单位是人天，最小精度 0.5，但不是默认拆分步长。",
            "- 禁止默认把阶段 `docs/` 列入“先读”。",
            "- 禁止每次开工都全文读取 `docs/`、`user-guide`、演进长文或设计长文。",
            "- 禁止跳过 `.factory/memory/*` 而直接回源人类文档。",
            "- 禁止把正式文档回源候选理解为默认运行时输入。",
            "- 禁止把 skill 当成动作注册表或命令目录；命令执行统一走 `factory-dispatch`、`action-registry` 和 `scripts/factory-*`。",
            "- 进入实现前必须回源核对 `docs/04-project-development/04-design/technical-selection.md` 的正式事实。",
            "",
            "## 当前推荐动作",
            "",
            f'- `python3 {dispatch_path} session --project "." --owner "{owner}"`',
            f'- `python3 {dispatch_path} board --project "." --owner "{owner}" --focus "当前协作焦点"`',
            f'- `python3 {dispatch_path} doctor --project "." --owner "{owner}" --scope full`',
        ]
    )
    if active_items:
        lines.extend(["", "## 当前前 5 个活跃工作项", ""])
        for item in active_items[:5]:
            lines.append(f"- `{item['id']}` {item['title']} | 状态：{item['status']} | 负责人：{item['owner']}")
    return "\n".join(lines).rstrip() + "\n"


def build_role_charter_project(project_root: Path, config: dict, owner: str) -> str:
    stage = str(config.get("stage", "BRAINSTORM"))
    role_focus = {
        "BRAINSTORM": ["coordinator", "product-manager"],
        "REQUIREMENTS": ["coordinator", "product-manager", "requirements-analyst"],
        "ANALYSIS": ["coordinator", "requirements-analyst"],
        "DESIGN": ["coordinator", "ux-designer", "solution-architect", "api-architect"],
        "PLAN": ["coordinator", "solution-architect", "documentation-librarian"],
        "IMPLEMENTATION": ["coordinator", "backend-engineer", "frontend-engineer", "documentation-librarian", "memory-librarian"],
        "TESTING": ["coordinator", "qa-engineer", "documentation-librarian"],
        "ACCEPTANCE": ["coordinator", "qa-engineer", "release-manager"],
        "RELEASE": ["coordinator", "release-manager", "memory-librarian"],
        "MAINTENANCE": ["coordinator", "requirements-analyst", "backend-engineer", "frontend-engineer", "qa-engineer"],
    }
    rules = {
        "coordinator": ("推进阶段、看板、Gate、交接、团队动能", "先读 `.factory/memory/runtime-brief.md`、`doc-map.md`、当前 summaries；必要时回源阶段检查/质量报告"),
        "product-manager": ("范围与优先级", "先读压缩入口和需求相关 summaries；必要时回源 `docs/04-project-development/02-discovery/*`、`docs/04-project-development/03-requirements/prd.md`"),
        "requirements-analyst": ("结构化 REQ/NFR、依赖、风险、建议测试点", "先读压缩入口和需求相关 summaries；必要时回源 `prd.md`、`requirements-analysis.md`、`requirements-verification.md`"),
        "ux-designer": ("用户旅程、页面与交互、设计交付物", "先读压缩入口和设计相关 summaries；必要时回源 `ux-ui-design.md` 与需求正式文档"),
        "solution-architect": ("技术画像、系统边界、分层", "先读压缩入口和技术/架构 summaries；必要时回源 `technical-selection.md`、`system-architecture.md`"),
        "api-architect": ("接口契约", "先读压缩入口和 API summary；必要时回源 `docs/04-project-development/04-design/api-design.md`"),
        "backend-engineer": ("后端代码、测试、PR", "先读压缩入口和技术 summaries；进入实现前必须回源 `technical-selection.md`，再按需回源 `backend-design.md`、`api-design.md`、`TASK-*`"),
        "frontend-engineer": ("前端代码、测试、PR", "先读压缩入口和技术/设计 summaries；进入实现前必须回源 `technical-selection.md`，再按需回源 `ux-ui-design.md`、`api-design.md`、`TASK-*`"),
        "qa-engineer": ("测试计划、回归、质量门禁", "先读压缩入口和测试 summaries；必要时回源 `docs/04-project-development/06-testing-verification/*`、`docs/04-project-development/07-release-delivery/*`"),
        "release-manager": ("发布、交付、上线检查", "先读压缩入口和发布相关 summaries；必要时回源 `release-notes.md`、`delivery-package.md`、`deployment-guide.md`、`user-guide.md`"),
        "documentation-librarian": ("文档同步与单文件版本演化", "先读压缩入口与 `doc-map.md`，再按受影响范围单文件回源 `docs/*`"),
        "memory-librarian": ("`.factory/memory/` 摘要、上下文压缩与基线沉淀", "先读全部压缩入口和执行记录；必要时回源最新正式文档核对事实"),
    }
    lines = [
        "# 项目角色压缩卡",
        "",
        f"- 生成时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 负责人：{owner}",
        f"- 当前阶段：{stage}",
        "",
        "## 使用边界",
        "",
        "- 禁止把下列“必要时回源”候选理解成默认先读。",
        "- 默认先读压缩入口和 summary，不足时再单文件回源正式文档。",
        "",
        "## 当前阶段主要角色",
        "",
    ]
    for role_id in role_focus.get(stage, ["coordinator"]):
        owns, reads = rules.get(role_id, ("待补充", "待补充"))
        lines.extend(
            [
                f"### {role_id}",
                f"- 负责：{owns}",
                f"- 优先读取：{reads}",
                f"- 交付要求：只改自己负责的产物，并在交接时说明输入、输出、未决问题、下一步。",
                "",
            ]
        )
    return "\n".join(lines).rstrip() + "\n"


def build_doc_map(project_root: Path) -> str:
    lines = [
        "# 文档压缩映射",
        "",
        "## 读取规则",
        "",
        "- 人类文档保留为正式说明层。",
        "- AI 默认先读压缩文档与 summary，再按需回看正式文档。",
        "- 禁止默认全文加载 `docs/`。",
        "- 禁止在没有事实缺口时回源人类长文档。",
        "- 禁止一次性并行加载多个阶段的正式文档。",
        "- 需要回源时，只允许按当前任务单文件回源。",
        "",
        "## 映射表",
        "",
    ]
    for path in project_docs(project_root):
        rel = path.relative_to(project_root).as_posix()
        summaries = SUMMARY_MAP.get(rel, [".factory/memory/runtime-brief.md"])
        lines.append(f"- `{rel}` -> {', '.join(f'`{item}`' for item in summaries)}")
    return "\n".join(lines).rstrip() + "\n"


def build_agents_md(project_root: Path, config: dict) -> str:
    runtime_protocol = software_factory_reference_path(project_root, "ai-runtime-protocol.md")
    role_charter = software_factory_reference_path(project_root, "ai-role-charter.md")
    return "\n".join(
        [
            "# AI 软件工厂规则",
            "",
            "默认不要散读整仓文档。",
            "",
            "项目根目录：`.`",
            f"项目名称：`{config.get('project_name', project_root.name)}`",
            "",
            "优先读取顺序：",
            "- `.factory/memory/runtime-brief.md`",
            "- `.factory/memory/role-charter.project.md`",
            "- `.factory/memory/doc-map.md`",
            "- `.factory/project.json`",
            "- `.factory/memory/current-state.md`",
            "- `.factory/memory/motivation-state.md`",
            "- `.factory/memory/autonomy-rules.md`",
            "- `.factory/memory/evolution-baseline.md`",
            "- 相关 summary 文档",
            "- 必要时按 `doc-map.md` 单文件回源正式文档",
            "",
            "补充协议：",
            f"- `{runtime_protocol}`",
            f"- `{role_charter}`",
            "",
            "规则：",
            "- 默认只读压缩入口、项目事实和 summary。",
            "- 禁止默认把阶段 `docs/` 文档列入“先读”。",
            "- 禁止每次开工都去读 `project-charter.md`、`input.md`、`user-guide.md` 或其他人类长文。",
            "- 禁止跳过 `.factory/memory/*` 直接回源正式文档。",
            "- 禁止把 skill 当成命令目录；命令执行统一走 `factory-dispatch`、`action-registry` 和 `scripts/factory-*`。",
            "- `AGENTS.md` / `GEMINI.md` 只保留稳定协作入口，不写安装结果、测试状态或当天运行结论。",
            "- 只在解释背景、方案原理、核对正式事实或用户明确要求时，才按 `doc-map.md` 单文件读取相关 `docs/*.md`。",
            "- 代码类工作必须走 PR 闭环。",
            "- 变更必须同步代码、文档、测试、`.factory/memory/`。",
        ]
    ).rstrip() + "\n"


