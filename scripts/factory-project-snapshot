#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    copy_relative_if_exists,
    latest_dir_id,
    load_project_config,
    next_dir_id,
    project_lock,
    refresh_ai_memory,
    save_project_config,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="生成项目内部快照，便于回溯当前阶段状态。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--owner", default="待记录", help="快照负责人。")
    parser.add_argument("--note", default="", help="快照说明。")
    return parser.parse_args()
def build_summary(snapshot_id: str, config: dict, owner: str, note: str, copied: list[str], release_id: str, handover_id: str) -> str:
    lines = [
        f"# {snapshot_id} 项目快照",
        "",
        f"- 快照编号：{snapshot_id}",
        f"- 生成时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 负责人：{owner}",
        f"- 当前阶段：{config.get('stage', '未知')}",
        f"- 当前模式：{config.get('active_mode', '未知')}",
        f"- 最近发布包：{release_id}",
        f"- 最近交接包：{handover_id}",
        f"- 说明：{note or '无'}",
        "",
        "## 包含文件",
        "",
    ]
    if copied:
        lines.extend(f"- `{item}`" for item in copied)
    else:
        lines.append("- 无")
    return "\n".join(lines)
def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    today = datetime.now().strftime("%Y-%m-%d")

    try:
        with project_lock(project_root, reason="生成项目快照"):
            config = load_project_config(project_root)
            snapshot_id = next_dir_id(project_root, "snapshots", "SNAP-")
            snapshot_dir = project_root / "snapshots" / snapshot_id
            snapshot_dir.mkdir(parents=True, exist_ok=True)

            copied: list[str] = []
            for relative in [
                ".factory/project.json",
                ".factory/process/daily-status.md",
                ".factory/process/risk-register.md",
                ".factory/process/stage-check-report.md",
                ".factory/process/quality-check-report.md",
                "docs/04-project-development/10-traceability/requirements-matrix.md",
                ".factory/memory/project-index.md",
                ".factory/memory/current-state.md",
                ".factory/memory/tasks.summary.md",
                ".factory/memory/change-summary.md",
                ".factory/memory/risk-summary.md",
                ".factory/memory/stage-check.summary.md",
                ".factory/memory/quality-check.summary.md",
                ".factory/memory/daily-status.summary.md",
                ".factory/memory/traceability.summary.md",
                ".factory/memory/graph/traceability.json",
            ]:
                copied.extend(copy_relative_if_exists(project_root, relative, snapshot_dir))

            release_id = latest_dir_id(project_root, "releases", "REL-")
            handover_id = latest_dir_id(project_root, "handover", "HO-")
            summary = build_summary(
                snapshot_id=snapshot_id,
                config=config,
                owner=args.owner.strip(),
                note=args.note.strip(),
                copied=copied,
                release_id=release_id,
                handover_id=handover_id,
            )
            (snapshot_dir / "snapshot-summary.md").write_text(summary + "\n", encoding="utf-8")

            config["last_project_snapshot_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_project_snapshot_id"] = snapshot_id
            config.setdefault("project_snapshots", []).append(
                {
                    "snapshot_id": snapshot_id,
                    "owner": args.owner.strip(),
                    "note": args.note.strip(),
                    "created_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                }
            )
            save_project_config(project_root, config)

            line = f"- {today}: 生成项目快照 `{snapshot_id}`，负责人：{args.owner.strip()}，备注：{args.note.strip() or '无'}。"
            append_log_line(project_root / ".factory" / "process" / "execution-log.md", line)
            append_log_line(project_root / "docs" / "04-project-development" / "07-release-delivery" / "delivery-package.md", line)
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"生成项目快照失败：{exc}", file=sys.stderr)
        return 1

    print(f"已生成项目快照：{snapshot_dir}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
