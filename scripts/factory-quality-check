#!/usr/bin/env python3

import argparse
import json
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    collect_items,
    current_tech_profile,
    file_readiness,
    load_project_config,
    project_lock,
    refresh_ai_memory,
    save_project_config,
    task_work_block_status,
)

STAGE_DOCS = {
    "BRAINSTORM": [
        "docs/04-project-development/01-governance/project-charter.md",
        "docs/04-project-development/02-discovery/input.md",
        "docs/04-project-development/02-discovery/brainstorm-record.md",
    ],
    "REQUIREMENTS": [
        "docs/04-project-development/03-requirements/prd.md",
        "docs/04-project-development/03-requirements/requirements-analysis.md",
        "docs/04-project-development/03-requirements/requirements-verification.md",
    ],
    "ANALYSIS": [
        "docs/04-project-development/03-requirements/requirements-verification.md",
        "docs/04-project-development/10-traceability/requirements-matrix.md",
    ],
    "DESIGN": [
        "docs/04-project-development/04-design/system-architecture.md",
        "docs/04-project-development/04-design/technical-selection.md",
        "docs/04-project-development/04-design/module-boundaries.md",
        "docs/04-project-development/04-design/api-design.md",
        "docs/04-project-development/04-design/backend-design.md",
        "docs/04-project-development/04-design/ux-ui-design.md",
    ],
    "PLAN": [
        "docs/04-project-development/05-development-process/wbs.md",
        "docs/04-project-development/05-development-process/task-breakdown.md",
        "docs/04-project-development/05-development-process/implementation-plan.md",
        ".factory/process/execution-log.md",
    ],
    "IMPLEMENTATION": [
        ".factory/process/execution-log.md",
    ],
    "TESTING": [
        "docs/04-project-development/06-testing-verification/test-plan.md",
        "docs/04-project-development/06-testing-verification/test-cases.md",
        "docs/04-project-development/06-testing-verification/test-report.md",
    ],
    "ACCEPTANCE": [
        "docs/04-project-development/07-release-delivery/acceptance-checklist.md",
        ".factory/process/stage-check-report.md",
        ".factory/process/quality-check-report.md",
    ],
    "RELEASE": [
        "docs/04-project-development/07-release-delivery/release-notes.md",
        "docs/04-project-development/08-operations-maintenance/deployment-guide.md",
        "docs/02-user-guide/user-guide.md",
    ],
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="执行项目级质量检查，输出质量报告和 AI 摘要。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--owner", default="待记录", help="检查人。")
    parser.add_argument("--scope", default="full", choices=["full", "docs", "trace", "delivery"], help="检查范围。")
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--strict", action="store_true", help="若结果不是通过，则返回非 0。")
    return parser.parse_args()


def docs_for_scope(config: dict, scope: str) -> list[str]:
    if scope == "trace":
        return ["docs/04-project-development/10-traceability/requirements-matrix.md"]
    if scope == "delivery":
        return [
            "docs/04-project-development/07-release-delivery/delivery-package.md",
            "docs/04-project-development/07-release-delivery/release-notes.md",
            "docs/04-project-development/08-operations-maintenance/deployment-guide.md",
            "docs/02-user-guide/user-guide.md",
        ]
    if scope == "docs":
        return [
            "docs/04-project-development/03-requirements/prd.md",
            "docs/04-project-development/03-requirements/requirements-analysis.md",
            "docs/04-project-development/03-requirements/requirements-verification.md",
            "docs/04-project-development/04-design/technical-selection.md",
            "docs/04-project-development/04-design/system-architecture.md",
            "docs/04-project-development/04-design/module-boundaries.md",
            "docs/04-project-development/04-design/api-design.md",
            "docs/04-project-development/06-testing-verification/test-report.md",
        ]

    stage = config.get("stage", "BRAINSTORM")
    order = config.get("stage_order", [])
    if stage not in order:
        return []
    docs: list[str] = []
    for stage_name in order[: order.index(stage) + 1]:
        docs.extend(STAGE_DOCS.get(stage_name, []))
    docs.append("docs/04-project-development/10-traceability/requirements-matrix.md")
    return list(dict.fromkeys(docs))


def trace_relation_count(project_root: Path) -> int:
    graph_path = project_root / ".factory" / "memory" / "graph" / "traceability.json"
    if not graph_path.exists():
        return 0
    try:
        graph = json.loads(graph_path.read_text(encoding="utf-8"))
        return len(graph.get("edges", []))
    except Exception:
        return 0


def open_risk_count(project_root: Path) -> int:
    path = project_root / ".factory" / "process" / "risk-register.md"
    if not path.exists():
        return 0
    count = 0
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("| RISK-"):
            parts = [part.strip() for part in line.split("|")]
            if len(parts) >= 8 and parts[4] not in {"已关闭", "已接受", "已消除"}:
                count += 1
    return count


def determine_result(
    doc_checks: list[tuple[str, str, str]],
    blocked_count: int,
    trace_count: int,
    risk_count: int,
    work_block_state: str,
) -> tuple[str, list[str]]:
    suggestions: list[str] = []
    if any(status in {"缺失", "占位"} for _, status, _ in doc_checks) or work_block_state in {"缺失", "占位"}:
        result = "未通过"
        suggestions.append("先补齐缺失或仍为占位的核心文档。")
        if work_block_state in {"缺失", "占位"}:
            suggestions.append("先把活跃任务细化为可执行的 0.5 人天工作块，再继续推进。")
    elif blocked_count > 0 or trace_count == 0 or work_block_state == "关注":
        result = "关注"
        if blocked_count > 0:
            suggestions.append("先解除阻塞工作项，再继续推进质量门。")
        if trace_count == 0:
            suggestions.append("先补齐追踪关系，确保需求到任务和测试可追踪。")
        if work_block_state == "关注":
            suggestions.append("当前仍有部分任务的人天工作块过于粗糙，建议先补细拆解。")
    elif risk_count > 0:
        result = "关注"
        suggestions.append("当前仍有开放风险，建议在 Gate 前确认接受或缓解策略。")
    else:
        result = "通过"
        suggestions.append("当前项目质量检查通过，可以继续推进评审或交付。")
    suggestions.append(f"当前追踪关系数：{trace_count}。")
    suggestions.append(f"当前开放风险数：{risk_count}。")
    return result, suggestions


def upsert_report(path: Path, latest_lines: list[str], check_lines: list[str], risk_lines: list[str], suggestion_lines: list[str], history_line: str) -> None:
    if path.exists():
        lines = path.read_text(encoding="utf-8").splitlines()
    else:
        lines = ["# 质量检查报告", ""]

    sections = {
        "## 最新检查": latest_lines,
        "## 检查项": check_lines,
        "## 风险与阻塞": risk_lines,
        "## 建议动作": suggestion_lines,
    }
    for header, content in sections.items():
        if header in lines:
            start = lines.index(header)
            end = len(lines)
            for index in range(start + 1, len(lines)):
                if lines[index].startswith("## "):
                    end = index
                    break
            lines = lines[: start + 1] + [""] + content + [""] + lines[end:]
        else:
            if lines and lines[-1] != "":
                lines.append("")
            lines.extend([header, "", *content, ""])

    history_header = "## 历史检查记录"
    if history_header in lines:
        start = lines.index(history_header)
        insert_at = start + 2 if start + 1 < len(lines) and lines[start + 1] == "" else start + 1
        if history_line not in lines:
            lines.insert(insert_at, history_line)
    else:
        if lines and lines[-1] != "":
            lines.append("")
        lines.extend([history_header, "", history_line, ""])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    today = datetime.now().strftime("%Y-%m-%d")

    try:
        with project_lock(project_root, reason=f"执行质量检查 {args.scope}"):
            config = load_project_config(project_root)
            items = collect_items(project_root)
            docs = docs_for_scope(config, args.scope)
            doc_checks = []
            for relative in docs:
                status, reason = file_readiness(project_root / relative)
                doc_checks.append((relative, status, reason))
            if args.scope in {"full", "docs"}:
                req_result = config.get("last_requirements_verification_result", "")
                if req_result:
                    doc_checks.append(("需求一致性校验结果", "就绪" if req_result == "通过" else "关注", f"最近结果：{req_result}"))
                else:
                    doc_checks.append(("需求一致性校验结果", "关注", "尚未执行 requirements-verify。"))
                required_skills = current_tech_profile(config).get("required_skills", [])
                if required_skills:
                    doc_checks.append(("技术画像技能约束", "就绪", f"当前要求：{'、'.join(required_skills)}"))
                else:
                    doc_checks.append(("技术画像技能约束", "关注", "尚未登记语言/框架对应的强制技能。"))
            blocked_items = [item for item in items if item["status"] == "阻塞"]
            trace_count = trace_relation_count(project_root)
            risk_count = open_risk_count(project_root)
            work_block_state = "就绪"
            work_block_lines: list[str] = []
            if args.scope in {"full", "docs", "delivery"}:
                work_block_state, work_block_lines = task_work_block_status(items)
            result, suggestions = determine_result(
                doc_checks,
                len(blocked_items),
                trace_count,
                risk_count,
                work_block_state,
            )

            latest_lines = [
                f"- 检查范围：{args.scope}",
                f"- 检查结果：{result}",
                f"- 检查时间：{now_text}",
                f"- 检查人：{args.owner.strip()}",
                f"- 备注：{args.note.strip() or '无'}",
            ]
            check_lines = [f"- `{name}`：{status}，{reason}" for name, status, reason in doc_checks]
            if work_block_lines:
                check_lines.append(f"- 任务工作块质量：{work_block_state}")
                check_lines.extend(work_block_lines)
            check_lines.append(f"- 追踪关系数：{trace_count}")
            check_lines.append(f"- 开放风险数：{risk_count}")
            risk_lines = (
                [f"- `{item['id']}` {item['title']} | 负责人：{item['owner']}" for item in blocked_items]
                if blocked_items
                else ["- 当前无阻塞工作项。"]
            )
            suggestion_lines = [f"- {item}" for item in suggestions]
            history_line = f"- {now_text}: 质量检查结果 `{result}`，范围：{args.scope}，检查人：{args.owner.strip()}。"

            report_path = project_root / ".factory" / "process" / "quality-check-report.md"
            upsert_report(report_path, latest_lines, check_lines, risk_lines, suggestion_lines, history_line)

            ai_lines = [
                "# 质量检查摘要",
                "",
                f"- 范围：{args.scope}",
                f"- 结果：{result}",
                f"- 检查人：{args.owner.strip()}",
                f"- 检查时间：{now_text}",
                "",
                "## 检查项",
                "",
                *check_lines,
                "",
                "## 风险与阻塞",
                "",
                *risk_lines,
                "",
                "## 建议动作",
                "",
                *suggestion_lines,
            ]
            (project_root / ".factory" / "memory" / "quality-check.summary.md").write_text("\n".join(ai_lines).rstrip() + "\n", encoding="utf-8")

            config["last_quality_check_at"] = now_text
            config["last_quality_check_result"] = result
            config.setdefault("quality_checks", []).append(
                {
                    "scope": args.scope,
                    "result": result,
                    "owner": args.owner.strip(),
                    "note": args.note.strip(),
                    "checked_at": now_text,
                }
            )
            save_project_config(project_root, config)

            line = f"- {today}: 执行质量检查，范围：{args.scope}，结果：{result}，检查人：{args.owner.strip()}。"
            append_log_line(project_root / ".factory" / "process" / "execution-log.md", line)
            append_log_line(project_root / "docs" / "04-project-development" / "07-release-delivery" / "acceptance-checklist.md", line)
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"执行质量检查失败：{exc}", file=sys.stderr)
        return 1

    print(f"已完成质量检查：{result}")
    if args.strict and result != "通过":
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
