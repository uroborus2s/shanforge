#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    RECOVERY_PLAYBOOK_RELATIVE,
    RECOVERY_REVIEW_RELATIVE,
    append_log_line,
    collect_items,
    current_role_assignment,
    ensure_role_catalog,
    find_item_file,
    infer_recovery_mode,
    load_project_config,
    parse_list,
    parse_work_item,
    prepend_history_entry,
    project_lock,
    read_recent_log_lines,
    recovery_mode_guide,
    refresh_ai_memory,
    resolve_role,
    save_project_config,
    upsert_section,
    write_text,
)


RECOVERY_MODES = [
    "auto",
    "blocked",
    "looping",
    "unverified",
    "premature-escalation",
    "path-exhausted",
    "quality-drift",
]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="在工作项受阻、空转或质量漂移时生成恢复教练方案。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--item", default="", help="关联工作项，例如 TASK-001。")
    parser.add_argument("--role", default="", help="关联角色。")
    parser.add_argument("--owner", default="恢复教练", help="负责人。")
    parser.add_argument("--mode", default="auto", choices=RECOVERY_MODES, help="恢复模式。")
    parser.add_argument("--attempts", type=int, default=0, help="已尝试次数。")
    parser.add_argument("--excluded", default="", help="已经排除的路径，逗号分隔。")
    parser.add_argument("--next-path", default="", help="下一条明显不同的路径。")
    parser.add_argument("--evidence", default="", help="本轮必须补齐的证据，逗号分隔。")
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--top", type=int, default=5, help="展示的重点数量。")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    try:
        with project_lock(project_root, reason="生成恢复教练方案"):
            config = load_project_config(project_root)
            ensure_role_catalog(config)
            source_item = None
            if args.item.strip():
                source_item = parse_work_item(find_item_file(project_root, args.item.strip()))

            role = resolve_role(config, args.role.strip(), default_id="coordinator") if args.role.strip() else None
            assignment = current_role_assignment(config, role["id"]) if role else {}
            mode = args.mode
            if mode == "auto":
                mode = infer_recovery_mode(
                    source_item,
                    note=args.note.strip(),
                    attempts=args.attempts,
                    blocked=bool(source_item and source_item.get("status") == "阻塞"),
                )
            guide = recovery_mode_guide(mode)
            items = collect_items(project_root)
            recent_logs = read_recent_log_lines(project_root, max(1, args.top))

            latest_lines = [
                f"- 时间：{now_text}",
                f"- 负责人：{args.owner.strip()}",
                f"- 当前阶段：{config.get('stage', '未知')}",
                f"- 恢复模式：{guide['title']} (`{mode}`)",
                f"- 关联工作项：{source_item['id'] if source_item else '无'}",
                f"- 关联角色：{role['title'] if role else '无'}",
                f"- 已尝试次数：{args.attempts}",
                f"- 备注：{args.note.strip() or '无'}",
            ]

            symptom_lines = [f"- {item}" for item in guide["signals"]]
            if source_item:
                symptom_lines.insert(
                    0,
                    f"- 当前工作项：`{source_item['id']}` {source_item['title']} | 状态：{source_item['status']} | 负责人：{source_item['owner']} | 关联：{source_item['links']}",
                )
            if role:
                symptom_lines.append(
                    f"- 当前角色状态：{assignment.get('status', '未分派') or '未分派'} | 焦点：{assignment.get('focus', '无') or '无'}"
                )

            excluded_lines = [f"- {item}" for item in parse_list(args.excluded)]
            if not excluded_lines and recent_logs:
                excluded_lines = [f"- 最近记录：{line[2:]}" for line in recent_logs[-args.top :]]
            if not excluded_lines:
                excluded_lines = ["- 请先补齐已排除路径，避免重复尝试旧解。"]

            next_lines = [f"- {args.next_path.strip()}"] if args.next_path.strip() else [f"- {item}" for item in guide["actions"]]
            evidence_lines = [f"- {item}" for item in parse_list(args.evidence)] or [f"- {item}" for item in guide["evidence"]]

            support_lines = [
                "- 先把“结论”降级成“假设”，再通过最小证据验证。",
                "- 当前恢复目标是重新建立推进路径，不是用更高压力强行堆尝试次数。",
                "- 一旦恢复成功，补一次 `factory-dispatch evolution --project <项目路径>` 把有效做法沉淀成基线。",
            ]

            review_path = project_root / RECOVERY_REVIEW_RELATIVE
            upsert_section(review_path, "## 本次恢复教练", latest_lines, default_title="# 恢复教练记录")
            upsert_section(review_path, "## 当前症状", symptom_lines, default_title="# 恢复教练记录")
            upsert_section(review_path, "## 已排除路径", excluded_lines, default_title="# 恢复教练记录")
            upsert_section(review_path, "## 下一条明显不同的路径", next_lines, default_title="# 恢复教练记录")
            upsert_section(review_path, "## 必要证据", evidence_lines, default_title="# 恢复教练记录")
            upsert_section(review_path, "## 支持策略", support_lines, default_title="# 恢复教练记录")
            prepend_history_entry(
                review_path,
                "## 历史恢复记录",
                f"- {now_text}: 启动 `{guide['title']}`，工作项：{source_item['id'] if source_item else '无'}，角色：{role['id'] if role else '无'}。",
                default_title="# 恢复教练记录",
            )

            write_text(
                project_root / RECOVERY_PLAYBOOK_RELATIVE,
                "\n".join(
                    [
                        "# 恢复教练摘要",
                        "",
                        *latest_lines,
                        "",
                        "## 当前症状",
                        "",
                        *symptom_lines,
                        "",
                        "## 下一条明显不同的路径",
                        "",
                        *next_lines,
                        "",
                        "## 必要证据",
                        "",
                        *evidence_lines,
                    ]
                ),
            )

            config["last_recovery_case_at"] = now_text
            config["last_recovery_mode"] = mode
            config.setdefault("recovery_cases", []).append(
                {
                    "created_at": now_text,
                    "owner": args.owner.strip(),
                    "item": source_item["id"] if source_item else "",
                    "role": role["id"] if role else "",
                    "mode": mode,
                    "attempts": args.attempts,
                    "note": args.note.strip(),
                }
            )
            save_project_config(project_root, config)
            refresh_ai_memory(project_root)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 启动恢复教练，模式：{guide['title']}，工作项：{source_item['id'] if source_item else '无'}，负责人：{args.owner.strip()}。",
            )
    except Exception as exc:
        print(f"生成恢复教练方案失败：{exc}", file=sys.stderr)
        return 1

    print(f"已生成恢复教练方案：{project_root / RECOVERY_REVIEW_RELATIVE}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
