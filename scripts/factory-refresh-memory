#!/usr/bin/env python3

import argparse
from pathlib import Path
import sys

from factory_core import project_lock, refresh_ai_memory


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="刷新 CLI 项目的 AI 记忆文件和历史快照。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason="刷新 AI 记忆"):
            snapshot_path = refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"刷新 AI 记忆失败：{exc}", file=sys.stderr)
        return 1

    print(f"已刷新 AI 记忆：{project_root / '.factory' / 'memory'}")
    print(f"已写入历史快照：{snapshot_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
