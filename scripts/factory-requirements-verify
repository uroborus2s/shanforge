#!/usr/bin/env python3

import argparse
import re
from datetime import datetime
from pathlib import Path
import sys

from factory_core import append_log_line, load_project_config, project_lock, refresh_ai_memory, save_project_config, write_text


REQ_PATTERN = re.compile(r"\bREQ-\d{3}\b")
NFR_PATTERN = re.compile(r"\bNFR-\d{3}\b")

PRD_FIELDS = [
    "目标：",
    "用户故事：",
    "前置条件：",
    "主流程：",
    "异常/边界：",
    "业务规则：",
    "数据约束：",
    "权限/角色：",
    "验收标准：",
    "关联设计：",
    "关联测试：",
]
ANALYSIS_FIELDS = [
    "业务价值：",
    "优先级理由：",
    "依赖关系：",
    "风险点：",
    "影响角色/系统：",
    "待澄清问题：",
    "建议拆分：",
    "建议测试点：",
]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="校验 PRD 与需求分析的一致性、覆盖率和字段完整性，避免遗漏需求。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--owner", default="需求负责人", help="校验负责人。")
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--strict", action="store_true", help="若结果不是通过则返回非 0。")
    return parser.parse_args()


def extract_ids(text: str, pattern: re.Pattern[str]) -> list[str]:
    return sorted(set(pattern.findall(text)))


def extract_section(text: str, item_id: str) -> str:
    heading_pattern = re.compile(rf"^##{{2,3}}\s+{re.escape(item_id)}(?:\b|[:：]|\s)")
    lines = text.splitlines()
    start = None
    for index, line in enumerate(lines):
        stripped = line.lstrip()
        if heading_pattern.match(stripped):
            start = index
            break
    if start is None:
        return ""
    end = len(lines)
    for index in range(start + 1, len(lines)):
        stripped = lines[index].lstrip()
        if stripped.startswith("### ") or stripped.startswith("## "):
            end = index
            break
    return "\n".join(lines[start:end])


def check_section_fields(section: str, fields: list[str]) -> list[str]:
    if not section:
        return fields
    missing = []
    for field in fields:
        if field not in section:
            missing.append(field)
            continue
        field_line = next((line.strip() for line in section.splitlines() if field in line), "")
        if any(token in field_line for token in ["待补充", "待分析", "_____", "_____，", "_____。"]):
            missing.append(field)
    return missing


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    prd_path = project_root / "docs" / "04-project-development" / "03-requirements" / "prd.md"
    analysis_path = project_root / "docs" / "04-project-development" / "03-requirements" / "requirements-analysis.md"

    try:
        with project_lock(project_root, reason="执行需求一致性校验"):
            config = load_project_config(project_root)
            prd_text = prd_path.read_text(encoding="utf-8") if prd_path.exists() else ""
            analysis_text = analysis_path.read_text(encoding="utf-8") if analysis_path.exists() else ""

            prd_reqs = extract_ids(prd_text, REQ_PATTERN)
            analysis_reqs = extract_ids(analysis_text, REQ_PATTERN)
            prd_nfrs = extract_ids(prd_text, NFR_PATTERN)

            missing_in_analysis = [item for item in prd_reqs if item not in analysis_reqs]
            missing_in_prd = [item for item in analysis_reqs if item not in prd_reqs]

            field_gaps: list[str] = []
            for req_id in prd_reqs:
                missing_fields = check_section_fields(extract_section(prd_text, req_id), PRD_FIELDS)
                if missing_fields:
                    field_gaps.append(f"`{req_id}` 缺少字段：{'、'.join(missing_fields)}")
            for req_id in analysis_reqs:
                missing_fields = check_section_fields(extract_section(analysis_text, req_id), ANALYSIS_FIELDS)
                if missing_fields:
                    field_gaps.append(f"`{req_id}` 分析缺少字段：{'、'.join(missing_fields)}")

            if not prd_reqs:
                result = "未通过"
            elif missing_in_analysis or missing_in_prd:
                result = "未通过"
            elif field_gaps:
                result = "关注"
            else:
                result = "通过"

            latest_lines = [
                f"- 校验结果：{result}",
                f"- 校验时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                f"- 校验人：{args.owner.strip()}",
                f"- 备注：{args.note.strip() or '无'}",
                f"- PRD REQ 数：{len(prd_reqs)}",
                f"- 分析 REQ 数：{len(analysis_reqs)}",
                f"- NFR 数：{len(prd_nfrs)}",
            ]
            coverage_lines = [
                f"- PRD 中的需求：{'、'.join(prd_reqs) or '无'}",
                f"- 需求分析中的需求：{'、'.join(analysis_reqs) or '无'}",
            ]
            issue_lines = []
            if missing_in_analysis:
                issue_lines.append(f"- 需求分析缺少：{'、'.join(missing_in_analysis)}")
            if missing_in_prd:
                issue_lines.append(f"- PRD 缺少：{'、'.join(missing_in_prd)}")
            issue_lines.extend(f"- {item}" for item in field_gaps)
            if not issue_lines:
                issue_lines = ["- 当前未发现需求遗漏或字段缺口。"]

            suggestion_lines = []
            if result == "未通过":
                suggestion_lines.append("- 先补齐 PRD 与需求分析的 REQ 对齐，再进入设计阶段。")
            if field_gaps:
                suggestion_lines.append("- 按缺口补齐字段，尤其是业务规则、边界、数据约束、权限和建议测试点。")
            if not suggestion_lines:
                suggestion_lines.append("- 需求覆盖校验通过，可继续设计或 Gate 评审。")

            report = "\n".join(
                [
                    "# 需求一致性校验报告",
                    "",
                    "## 最新校验",
                    "",
                    *latest_lines,
                    "",
                    "## 覆盖情况",
                    "",
                    *coverage_lines,
                    "",
                    "## 问题清单",
                    "",
                    *issue_lines,
                    "",
                    "## 建议动作",
                    "",
                    *suggestion_lines,
                ]
            ).rstrip() + "\n"
            write_text(project_root / "docs" / "04-project-development" / "03-requirements" / "requirements-verification.md", report)
            write_text(
                project_root / ".factory" / "memory" / "requirements-verification.summary.md",
                "\n".join(
                    [
                        "# 需求一致性校验摘要",
                        "",
                        *latest_lines,
                        "",
                        "## 问题清单",
                        "",
                        *issue_lines,
                    ]
                ),
            )

            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_requirements_verification_at"] = now_text
            config["last_requirements_verification_result"] = result
            config.setdefault("requirements_verifications", []).append(
                {
                    "result": result,
                    "owner": args.owner.strip(),
                    "note": args.note.strip(),
                    "verified_at": now_text,
                    "prd_req_count": len(prd_reqs),
                    "analysis_req_count": len(analysis_reqs),
                    "nfr_count": len(prd_nfrs),
                    "issue_count": 0 if issue_lines == ["- 当前未发现需求遗漏或字段缺口。"] else len(issue_lines),
                }
            )
            save_project_config(project_root, config)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 执行需求一致性校验，结果：{result}，负责人：{args.owner.strip()}。",
            )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"执行需求一致性校验失败：{exc}", file=sys.stderr)
        return 1

    print(f"已完成需求一致性校验：{result}")
    if args.strict and result != "通过":
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
