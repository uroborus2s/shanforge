#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import active_pr_records, append_log_line, load_pr_records, load_project_config, project_lock, refresh_ai_memory, run_script, save_project_config


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="记录阶段 Gate 评审结果，并可选自动推进阶段。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--gate", required=True, help="Gate 名称，例如 requirements/design/testing/release。")
    parser.add_argument("--result", choices=["通过", "驳回"], required=True, help="评审结果。")
    parser.add_argument("--reviewer", required=True, help="评审人。")
    parser.add_argument("--note", default="", help="评审说明。")
    parser.add_argument("--advance", action="store_true", help="当结果为通过时，自动推进到下一阶段。")
    parser.add_argument("--skip-pr-check", action="store_true", help="跳过代码阶段的 PR 完整性检查。")
    return parser.parse_args()


def gate_requires_pr_check(gate: str) -> bool:
    return gate.strip().lower() in {"implementation", "testing", "acceptance", "release"}


def assert_gate_pr_ready(project_root: Path, gate: str, skip_check: bool) -> None:
    if skip_check or not gate_requires_pr_check(gate):
        return
    active = active_pr_records(load_pr_records(project_root))
    if not active:
        return
    pending = "、".join(record.get("id", "未知 PR") for record in active)
    raise RuntimeError(f"Gate `{gate}` 通过前仍有未合并 PR：{pending}")
def append_gate_log(project_root: Path, gate: str, result: str, reviewer: str, note: str) -> None:
    acceptance = project_root / "docs" / "04-project-development" / "07-release-delivery" / "acceptance-checklist.md"
    execution = project_root / ".factory" / "process" / "execution-log.md"
    line = f"- {datetime.now().strftime('%Y-%m-%d')}: Gate `{gate}` 评审结果：{result}，评审人：{reviewer}。"
    if note:
        line += f" 说明：{note}"
    for path in [acceptance, execution]:
        append_log_line(path, line)


def advance_stage(project_root: Path, reviewer: str, note: str) -> None:
    result = run_script(
        "factory-next-stage",
        "--project",
        str(project_root),
        "--approver",
        reviewer,
        "--note",
        note or "Gate 通过，自动推进阶段",
        label="推进阶段",
    )
    if result["returncode"] != 0:
        raise RuntimeError(result["stderr"] or result["stdout"] or "推进阶段失败")


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason=f"记录 Gate {args.gate.strip()}"):
            if args.result == "通过":
                assert_gate_pr_ready(project_root, args.gate.strip(), args.skip_pr_check)
            config = load_project_config(project_root)
            gate_history = config.setdefault("gate_history", [])
            gate_history.append(
                {
                    "gate": args.gate.strip(),
                    "result": args.result,
                    "reviewer": args.reviewer.strip(),
                    "note": args.note.strip(),
                    "reviewed_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                }
            )
            save_project_config(project_root, config)
            append_gate_log(project_root, args.gate.strip(), args.result, args.reviewer.strip(), args.note.strip())
            if args.result == "通过" and args.advance:
                advance_stage(project_root, args.reviewer.strip(), args.note.strip())
            else:
                refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"Gate 评审记录失败：{exc}", file=sys.stderr)
        return 1

    print(f"已记录 Gate `{args.gate.strip()}` 的评审结果：{args.result}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
