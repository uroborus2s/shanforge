#!/usr/bin/env python3

import argparse
import json
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    collect_active_items,
    collect_items,
    ensure_role_catalog,
    format_item_brief,
    group_items_by_role,
    load_project_config,
    parse_list,
    prepend_history_entry,
    project_lock,
    resolve_role,
    role_document_reads,
    role_recommended_commands,
    save_project_config,
    upsert_section,
    write_text,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="记录角色之间的工作交接。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--from-role", required=True, help="交出角色。")
    parser.add_argument("--to-role", required=True, help="接手角色。")
    parser.add_argument("--from-tool", default="shared", help="交出方工具，例如 codex、gemini。")
    parser.add_argument("--to-tool", default="shared", help="接手方工具，例如 codex、gemini。")
    parser.add_argument("--owner", default="项目协调者", help="发起交接的人。")
    parser.add_argument("--items", default="", help="交接的工作项 ID，逗号分隔。")
    parser.add_argument("--focus", default="", help="交接焦点。")
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument(
        "--status",
        default="待接手",
        choices=["待接手", "接手中", "已接手", "阻塞"],
        help="交接状态。",
    )
    parser.add_argument("--next-command", default="", help="显式指定接手后第一条命令。")
    parser.add_argument("--top", type=int, default=5, help="默认展示的重点条目数量。")
    return parser.parse_args()


def select_items(project_root: Path, config: dict, role_id: str, raw_items: str, top: int) -> list[dict]:
    item_lookup = {item["id"]: item for item in collect_items(project_root)}
    requested = parse_list(raw_items)
    if requested:
        selected = []
        for item_id in requested:
            if item_id not in item_lookup:
                raise RuntimeError(f"未找到交接工作项：{item_id}")
            selected.append(item_lookup[item_id])
        return selected

    grouped = group_items_by_role(config, collect_active_items(project_root))
    role_items = grouped.get(role_id, [])
    if role_items:
        return role_items[:top]
    return list(item_lookup.values())[:top]


def build_summary_markdown(
    config: dict,
    from_role: dict,
    to_role: dict,
    args: argparse.Namespace,
    items: list[dict],
    reads: list[str],
    commands: list[str],
) -> str:
    item_lines = [format_item_brief(item) for item in items] or ["- 当前没有明确工作项。"]
    read_lines = [f"- `{item}`" for item in reads] or ["- 无"]
    command_lines = [f"- `{item}`" for item in commands] or ["- 无"]
    skill_lines = [
        f"- `{item['name']}`：{item.get('purpose', '无说明')}" for item in to_role.get("skills", [])
    ] or ["- 当前角色没有额外共享 skills。"]

    lines = [
        "# 角色交接摘要",
        "",
        f"- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 当前阶段：{config.get('stage', '未知')}",
        f"- 发起人：{args.owner.strip()}",
        f"- 从角色：{from_role['title']} ({args.from_tool.strip()})",
        f"- 到角色：{to_role['title']} ({args.to_tool.strip()})",
        f"- 状态：{args.status}",
        f"- 焦点：{args.focus.strip() or '无'}",
        f"- 备注：{args.note.strip() or '无'}",
        "",
        "## 待接手项",
        "",
        *item_lines,
        "",
        "## 角色共享能力",
        "",
        *skill_lines,
        "",
        "## 建议先读",
        "",
        *read_lines,
        "",
        "## 建议下一步",
        "",
        *command_lines,
    ]
    return "\n".join(lines).rstrip() + "\n"


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason="记录角色交接"):
            config = load_project_config(project_root)
            ensure_role_catalog(config)
            from_role = resolve_role(config, args.from_role.strip())
            to_role = resolve_role(config, args.to_role.strip())
            items = select_items(project_root, config, to_role["id"], args.items, max(1, args.top))
            reads = role_document_reads(project_root, config, to_role["id"])[: max(6, args.top + 3)]
            commands = role_recommended_commands(
                project_root,
                config,
                to_role["id"],
                args.owner.strip(),
                args.focus.strip() or f"{to_role['title']}接手当前工作",
            )
            if args.next_command.strip():
                commands = [args.next_command.strip(), *commands]

            markdown = build_summary_markdown(config, from_role, to_role, args, items, reads, commands)
            payload = {
                "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "from_role": from_role["id"],
                "to_role": to_role["id"],
                "from_tool": args.from_tool.strip(),
                "to_tool": args.to_tool.strip(),
                "status": args.status,
                "focus": args.focus.strip(),
                "note": args.note.strip(),
                "items": [item["id"] for item in items],
                "reads": reads,
                "commands": commands[:8],
            }

            doc_path = project_root / ".factory" / "process" / "role-handoffs.md"
            upsert_section(
                doc_path,
                "## 最新交接",
                [
                    f"- 时间：{payload['generated_at']}",
                    f"- 发起人：{args.owner.strip()}",
                    f"- 从角色：{from_role['title']} ({args.from_tool.strip()})",
                    f"- 到角色：{to_role['title']} ({args.to_tool.strip()})",
                    f"- 状态：{args.status}",
                    f"- 焦点：{args.focus.strip() or '无'}",
                    f"- 备注：{args.note.strip() or '无'}",
                ],
                default_title="# 角色交接记录",
            )
            upsert_section(
                doc_path,
                "## 待接手项",
                [format_item_brief(item) for item in items] or ["- 当前没有明确工作项。"],
                default_title="# 角色交接记录",
            )
            upsert_section(
                doc_path,
                "## 建议先读",
                [f"- `{item}`" for item in reads] or ["- 无"],
                default_title="# 角色交接记录",
            )
            upsert_section(
                doc_path,
                "## 建议下一步",
                [f"- `{item}`" for item in commands[:8]] or ["- 无"],
                default_title="# 角色交接记录",
            )
            prepend_history_entry(
                doc_path,
                "## 历史交接记录",
                (
                    f"- {payload['generated_at']}: `{from_role['title']}` -> `{to_role['title']}`，"
                    f"状态：{args.status}，发起人：{args.owner.strip()}。"
                ),
                default_title="# 角色交接记录",
            )

            write_text(project_root / ".factory" / "memory" / "role-handoffs.summary.md", markdown)
            write_text(
                project_root / ".factory" / "role-handoff.json",
                json.dumps(payload, ensure_ascii=False, indent=2),
            )

            now_text = payload["generated_at"]
            config["last_role_handoff_at"] = now_text
            config["last_role_handoff_from"] = from_role["id"]
            config["last_role_handoff_to"] = to_role["id"]
            config["last_role_handoff_status"] = args.status
            config["active_role"] = to_role["id"]
            config["active_role_tool"] = args.to_tool.strip()
            config.setdefault("role_handoffs", []).append(
                {
                    "from_role": from_role["id"],
                    "to_role": to_role["id"],
                    "from_tool": args.from_tool.strip(),
                    "to_tool": args.to_tool.strip(),
                    "status": args.status,
                    "focus": args.focus.strip(),
                    "note": args.note.strip(),
                    "items": [item["id"] for item in items],
                    "owner": args.owner.strip(),
                    "handoff_at": now_text,
                }
            )
            save_project_config(project_root, config)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                (
                    f"- {datetime.now().strftime('%Y-%m-%d')}: 角色交接 `{from_role['title']}` -> "
                    f"`{to_role['title']}`，状态：{args.status}，发起人：{args.owner.strip()}。"
                ),
            )
    except Exception as exc:
        print(f"记录角色交接失败：{exc}", file=sys.stderr)
        return 1

    print(f"已生成角色交接记录：{project_root / '.factory' / 'process' / 'role-handoffs.md'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
