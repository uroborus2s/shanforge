#!/usr/bin/env python3

import argparse
import json
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    assignment_write_targets,
    current_role_assignment,
    ensure_role_catalog,
    file_readiness,
    format_item_brief,
    load_project_config,
    prepend_history_entry,
    project_lock,
    read_recent_log_lines,
    read_risks,
    resolve_role,
    role_assignment_conflicts,
    role_assigned_items,
    role_document_reads,
    role_workbench_relative,
    save_project_config,
    upsert_section,
    write_text,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="复核某个角色当前执行状态。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--role", required=True, help="角色。")
    parser.add_argument("--reviewer", default="项目协调者", help="复核人。")
    parser.add_argument(
        "--scope",
        default="full",
        choices=["execution", "docs", "delivery", "full"],
        help="复核范围。",
    )
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--strict", action="store_true", help="若结果不是通过则返回非 0。")
    return parser.parse_args()


def determine_result(
    scope: str,
    assignment: dict,
    items: list[dict],
    doc_states: list[tuple[str, str, str]],
    workbench_ready: tuple[str, str],
    open_risks: list[str],
    ownership_conflicts: list[dict],
) -> tuple[str, list[str], list[str]]:
    issues: list[str] = []
    warnings: list[str] = []

    if not assignment:
        warnings.append("当前角色尚未建立显式分派记录。")
    if assignment.get("status") == "阻塞":
        issues.append("当前角色分派状态为阻塞。")

    blocked_items = [item for item in items if item["status"] == "阻塞"]
    active_items = [item for item in items if item["status"] not in {"已完成", "已关闭", "已取消", "已驳回"}]
    pending_items = [item for item in active_items if item["status"] in {"待开始", "待执行"}]

    if scope in {"execution", "full", "delivery"}:
        if blocked_items:
            issues.append(f"存在 {len(blocked_items)} 个阻塞工作项。")
        if ownership_conflicts:
            issues.append(f"当前角色存在 {len(ownership_conflicts)} 组写集冲突。")
        elif pending_items:
            warnings.append(f"存在 {len(pending_items)} 个尚未启动的工作项。")
        elif not active_items and items:
            warnings.append("当前角色工作项均已关闭，可准备进入交付或交接。")
        elif not items:
            warnings.append("当前角色没有明确工作项。")

    if scope in {"docs", "full", "delivery"}:
        missing_docs = [relative for relative, status, _ in doc_states if status == "缺失"]
        placeholder_docs = [relative for relative, status, _ in doc_states if status == "占位"]
        if missing_docs:
            issues.append(f"存在缺失文档：{', '.join(missing_docs[:3])}")
        if placeholder_docs:
            issues.append(f"存在占位文档：{', '.join(placeholder_docs[:3])}")

    if scope in {"execution", "full", "delivery"} and workbench_ready[0] != "就绪":
        warnings.append(f"角色工作台未就绪：{workbench_ready[1]}")

    if scope in {"full", "delivery"} and open_risks:
        warnings.append(f"存在 {len(open_risks)} 个开放风险。")

    if issues:
        return "未通过", issues, warnings
    if warnings:
        return "关注", issues, warnings
    return "通过", issues, warnings


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason="执行角色复核"):
            config = load_project_config(project_root)
            ensure_role_catalog(config)
            role = resolve_role(config, args.role.strip())
            assignment = current_role_assignment(config, role["id"])
            items = role_assigned_items(project_root, config, role["id"], include_closed=True)
            reads = role_document_reads(project_root, config, role["id"], include_ai=False)
            doc_states = [(relative, *file_readiness(project_root / relative)) for relative in reads[:10]]
            workbench_relative = role_workbench_relative(role["id"], config)
            doc_states = [
                entry
                for entry in doc_states
                if entry[0] not in {workbench_relative, ".factory/process/role-reviews.md"}
            ]
            workbench_ready = file_readiness(project_root / workbench_relative)
            open_risks, _ = read_risks(project_root)
            recent_logs = read_recent_log_lines(project_root, 5)
            all_conflicts = role_assignment_conflicts(project_root, config)
            ownership_conflicts = [
                item for item in all_conflicts if role["id"] in item.get("roles", [])
            ]
            result, issues, warnings = determine_result(
                args.scope,
                assignment,
                items,
                doc_states,
                workbench_ready,
                open_risks,
                ownership_conflicts,
            )
            suggestions = []
            if not assignment:
                suggestions.append("先执行 `factory-dispatch assign --role <角色>` 建立显式分派。")
            if workbench_ready[0] != "就绪":
                suggestions.append("先执行 `factory-dispatch workbench --role <角色>` 生成最新执行工作台。")
            if ownership_conflicts:
                suggestions.append("先调整角色写入集合，消除与其他角色的冲突，再继续并行推进。")
            if any(status in {"缺失", "占位"} for _, status, _ in doc_states):
                suggestions.append("补齐本角色相关正式文档，并完成单文件版本演化。")
            if any(item["status"] == "阻塞" for item in items):
                suggestions.append("优先解除阻塞工作项，再继续推进角色执行。")
            if open_risks:
                suggestions.append("检查开放风险是否已分配负责人并写入缓解措施。")
            if not suggestions:
                suggestions.append("当前角色执行状态健康，可继续推进下一步或准备 Gate。")

            item_lines = [format_item_brief(item) for item in items[:8]] or ["- 当前无明确工作项。"]
            doc_lines = [f"- `{relative}`：{status}，{reason}" for relative, status, reason in doc_states] or ["- 无"]
            write_targets = assignment_write_targets(project_root, assignment)
            write_target_lines = [f"- `{item}`" for item in write_targets] or ["- 当前未声明写入集合。"]
            conflict_lines = [
                f"- `{item['role_titles'][0]}` <-> `{item['role_titles'][1]}` | 重叠：{', '.join(item['overlaps'][:3])}"
                for item in ownership_conflicts
            ] or ["- 无"]
            issue_lines = [f"- {item}" for item in issues] or ["- 无"]
            warning_lines = [f"- {item}" for item in warnings] or ["- 无"]
            suggestion_lines = [f"- {item}" for item in suggestions]
            log_lines = recent_logs or ["- 暂无最近执行记录。"]
            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

            report = "\n".join(
                [
                    "# 角色执行复核报告",
                    "",
                    f"- 时间：{now_text}",
                    f"- 角色：{role['title']}",
                    f"- 复核人：{args.reviewer.strip()}",
                    f"- 范围：{args.scope}",
                    f"- 结果：{result}",
                    f"- 备注：{args.note.strip() or '无'}",
                    "",
                    "## 分派状态",
                    "",
                    f"- 当前负责人：{assignment.get('owner', '未分派') or '未分派'}",
                    f"- 当前工具：{assignment.get('tool', '未分配') or '未分配'}",
                    f"- 当前状态：{assignment.get('status', '未分派') or '未分派'}",
                    f"- 当前焦点：{assignment.get('focus', '无') or '无'}",
                    f"- 当前写入集合：{', '.join(write_targets) if write_targets else '无'}",
                    "",
                    "## 相关工作项",
                    "",
                    *item_lines,
                    "",
                    "## Ownership 与冲突",
                    "",
                    *write_target_lines,
                    "",
                    *conflict_lines,
                    "",
                    "## 文档与工作台状态",
                    "",
                    *doc_lines,
                    f"- `{workbench_relative}`：{workbench_ready[0]}，{workbench_ready[1]}",
                    "",
                    "## 问题",
                    "",
                    *issue_lines,
                    "",
                    "## 关注项",
                    "",
                    *warning_lines,
                    "",
                    "## 最近执行记录",
                    "",
                    *log_lines,
                    "",
                    "## 建议动作",
                    "",
                    *suggestion_lines,
                ]
            ).rstrip() + "\n"

            doc_path = project_root / ".factory" / "process" / "role-reviews.md"
            upsert_section(
                doc_path,
                "## 最新复核",
                [
                    f"- 时间：{now_text}",
                    f"- 角色：{role['title']}",
                    f"- 复核人：{args.reviewer.strip()}",
                    f"- 范围：{args.scope}",
                    f"- 结果：{result}",
                    f"- 备注：{args.note.strip() or '无'}",
                ],
                default_title="# 角色执行复核记录",
            )
            upsert_section(
                doc_path,
                "## 相关工作项",
                item_lines,
                default_title="# 角色执行复核记录",
            )
            upsert_section(
                doc_path,
                "## 问题与关注项",
                issue_lines + warning_lines,
                default_title="# 角色执行复核记录",
            )
            upsert_section(
                doc_path,
                "## 建议动作",
                suggestion_lines,
                default_title="# 角色执行复核记录",
            )
            prepend_history_entry(
                doc_path,
                "## 历史复核记录",
                f"- {now_text}: `{role['title']}` 复核完成，结果：{result}，复核人：{args.reviewer.strip()}。",
                default_title="# 角色执行复核记录",
            )

            write_text(project_root / f".factory/memory/role-review.{role['id']}.summary.md", report)
            write_text(
                project_root / f".factory/role-review.{role['id']}.json",
                json.dumps(
                    {
                        "reviewed_at": now_text,
                        "role": role["id"],
                        "reviewer": args.reviewer.strip(),
                        "scope": args.scope,
                        "result": result,
                        "note": args.note.strip(),
                        "issues": issues,
                        "warnings": warnings,
                        "suggestions": suggestions,
                    },
                    ensure_ascii=False,
                    indent=2,
                ),
            )

            config["last_role_review_at"] = now_text
            config["last_role_review_role"] = role["id"]
            config["last_role_review_result"] = result
            config.setdefault("role_reviews", []).append(
                {
                    "role": role["id"],
                    "reviewer": args.reviewer.strip(),
                    "scope": args.scope,
                    "result": result,
                    "note": args.note.strip(),
                    "reviewed_at": now_text,
                }
            )
            save_project_config(project_root, config)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                (
                    f"- {datetime.now().strftime('%Y-%m-%d')}: 复核角色 `{role['title']}`，"
                    f"范围：{args.scope}，结果：{result}，复核人：{args.reviewer.strip()}。"
                ),
            )
    except Exception as exc:
        print(f"执行角色复核失败：{exc}", file=sys.stderr)
        return 1

    print(f"已生成角色复核报告：{project_root / '.factory' / 'process' / 'role-reviews.md'}")
    if args.strict and result != "通过":
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
