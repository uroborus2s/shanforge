#!/usr/bin/env python3

import argparse
import json
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    current_role_assignment,
    ensure_role_catalog,
    load_project_config,
    parse_list,
    project_lock,
    role_assigned_items,
    run_script,
    save_project_config,
    set_current_role_assignment,
    upsert_section,
    write_text,
    prepend_history_entry,
    resolve_role,
)


SYNC_STATUSES = ["待执行", "进行中", "已同步", "阻塞", "已完成"]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="同步某个角色当前执行状态，并刷新角色视图。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--role", required=True, help="角色。")
    parser.add_argument("--owner", default="", help="角色负责人。")
    parser.add_argument("--tool", default="", help="角色当前工具。")
    parser.add_argument("--items", default="", help="要同步的工作项，逗号分隔。")
    parser.add_argument("--docs", default="", help="已更新文档，逗号分隔。")
    parser.add_argument("--tests", default="", help="已更新测试，逗号分隔。")
    parser.add_argument("--code", default="", help="已更新代码，逗号分隔。")
    parser.add_argument("--focus", default="", help="当前同步焦点。")
    parser.add_argument("--summary", default="", help="同步总结。")
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--status", default="已同步", choices=SYNC_STATUSES, help="角色同步后状态。")
    parser.add_argument("--daily-focus", default="", help="若传入则额外生成每日报告。")
    parser.add_argument("--snapshot", action="store_true", help="同步后额外生成项目快照。")
    return parser.parse_args()


def selected_item_ids(project_root: Path, config: dict, role_id: str, raw_items: str) -> list[str]:
    requested = parse_list(raw_items)
    if requested:
        return requested
    assignment = current_role_assignment(config, role_id)
    if assignment.get("items"):
        return list(assignment.get("items", []))
    return [item["id"] for item in role_assigned_items(project_root, config, role_id)]


def build_steps(project_root: Path, role_id: str, owner: str, tool: str, focus: str, item_ids: list[str], args: argparse.Namespace) -> list[tuple[str, list[str], str]]:
    project = str(project_root)
    docs = ",".join(parse_list(args.docs))
    tests = ",".join(parse_list(args.tests))
    code = ",".join(parse_list(args.code))
    note = args.note.strip() or args.summary.strip() or f"{role_id} role sync"

    steps: list[tuple[str, list[str], str]] = []
    for item_id in item_ids:
        if item_id.startswith(("CR-", "BUG-")):
            steps.append(
                (
                    "factory-sync-change",
                    [
                        "--project",
                        project,
                        "--item",
                        item_id,
                        "--docs",
                        docs,
                        "--tests",
                        tests,
                        "--code",
                        code,
                        "--note",
                        note,
                        "--status",
                        args.status,
                    ],
                    f"同步 {item_id}",
                )
            )

    steps.extend(
        [
            ("factory-refresh-memory", ["--project", project], "刷新 AI 记忆"),
            (
                "factory-role-workbench",
                ["--project", project, "--role", role_id, "--owner", owner, "--focus", focus, "--tool", tool],
                "刷新角色工作台",
            ),
            (
                "factory-multi-agent-board",
                ["--project", project, "--owner", owner, "--focus", focus],
                "刷新多 Agent 看板",
            ),
        ]
    )

    if args.daily_focus.strip():
        steps.append(
            (
                "factory-daily-status",
                ["--project", project, "--owner", owner, "--focus", args.daily_focus.strip()],
                "生成每日报告",
            )
        )
    if args.snapshot:
        steps.append(
            (
                "factory-project-snapshot",
                ["--project", project, "--owner", owner, "--note", note],
                "生成项目快照",
            )
        )
    return steps


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason="执行角色同步"):
            config = load_project_config(project_root)
            ensure_role_catalog(config)
            role = resolve_role(config, args.role.strip())
            assignment = current_role_assignment(config, role["id"])
            owner = args.owner.strip() or assignment.get("owner") or role["title"]
            tool = args.tool.strip() or assignment.get("tool") or "shared"
            focus = args.focus.strip() or assignment.get("focus") or f"{role['title']}角色同步"
            item_ids = selected_item_ids(project_root, config, role["id"], args.items)
            steps = [run_script(name, *command_args, label=label) for name, command_args, label in build_steps(project_root, role["id"], owner, tool, focus, item_ids, args)]
            result = "完成" if all(step["returncode"] == 0 for step in steps) else "失败"
            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

            assignment_payload = {
                "owner": owner,
                "tool": tool,
                "items": item_ids,
                "status": args.status,
                "focus": focus,
                "note": args.note.strip(),
                "assigned_at": assignment.get("assigned_at", now_text),
                "last_sync_at": now_text,
                "last_sync_result": result,
            }
            set_current_role_assignment(config, role["id"], assignment_payload)
            config["last_role_sync_at"] = now_text
            config["last_role_sync_role"] = role["id"]
            config["last_role_sync_result"] = result
            config.setdefault("role_sync_history", []).append(
                {
                    "role": role["id"],
                    "owner": owner,
                    "tool": tool,
                    "status": args.status,
                    "result": result,
                    "items": item_ids,
                    "docs": parse_list(args.docs),
                    "tests": parse_list(args.tests),
                    "code": parse_list(args.code),
                    "focus": focus,
                    "note": args.note.strip() or args.summary.strip(),
                    "synced_at": now_text,
                }
            )
            save_project_config(project_root, config)

            doc_path = project_root / ".factory" / "process" / "role-sync.md"
            latest_lines = [
                f"- 时间：{now_text}",
                f"- 角色：{role['title']}",
                f"- 负责人：{owner}",
                f"- 工具：{tool}",
                f"- 状态：{args.status}",
                f"- 结果：{result}",
                f"- 焦点：{focus}",
                f"- 总结：{args.summary.strip() or '无'}",
                f"- 备注：{args.note.strip() or '无'}",
            ]
            item_lines = [f"- `{item}`" for item in item_ids] or ["- 当前无绑定工作项。"]
            step_lines = []
            for step in steps:
                status_text = "成功" if step["returncode"] == 0 else f"失败({step['returncode']})"
                step_lines.append(f"- {step['label']}：{status_text}")
                if step["stdout"]:
                    step_lines.append(f"  输出：{step['stdout']}")
                if step["stderr"]:
                    step_lines.append(f"  错误：{step['stderr']}")
            upsert_section(doc_path, "## 最新同步", latest_lines, default_title="# 角色同步记录")
            upsert_section(doc_path, "## 关联工作项", item_lines, default_title="# 角色同步记录")
            upsert_section(doc_path, "## 步骤结果", step_lines or ["- 无"], default_title="# 角色同步记录")
            prepend_history_entry(
                doc_path,
                "## 历史同步记录",
                f"- {now_text}: `{role['title']}` 同步完成，结果：{result}，负责人：{owner}。",
                default_title="# 角色同步记录",
            )

            write_text(
                project_root / f".factory/memory/role-sync.{role['id']}.summary.md",
                "\n".join(
                    [
                        "# 角色同步摘要",
                        "",
                        *latest_lines,
                        "",
                        "## 关联工作项",
                        "",
                        *item_lines,
                        "",
                        "## 步骤结果",
                        "",
                        *(step_lines or ["- 无"]),
                    ]
                ),
            )
            write_text(
                project_root / f".factory/role-sync.{role['id']}.json",
                json.dumps(
                    {
                        "synced_at": now_text,
                        "role": role["id"],
                        "owner": owner,
                        "tool": tool,
                        "status": args.status,
                        "result": result,
                        "items": item_ids,
                        "focus": focus,
                    },
                    ensure_ascii=False,
                    indent=2,
                ),
            )
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 角色 `{role['title']}` 完成同步，结果：{result}，负责人：{owner}。",
            )
    except Exception as exc:
        print(f"角色同步失败：{exc}", file=sys.stderr)
        return 1

    print(f"已生成角色同步记录：{project_root / '.factory' / 'process' / 'role-sync.md'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
