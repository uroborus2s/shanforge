#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import append_log_line, find_item_file, format_effort_days, parse_effort_days, project_lock, refresh_ai_memory


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="更新任务/变更/缺陷的执行状态，并记录工作块进展。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--item", required=True, help="工作项编号，例如 TASK-001、CR-001、BUG-001。")
    parser.add_argument("--status", required=True, help="新的状态，例如 进行中/已完成/阻塞。")
    parser.add_argument("--work-block", default="", help="要更新的工作块编号，例如 WB-001-01。")
    parser.add_argument("--spent-days", default="0", help="本次实际投入人天，最小单位 0.5。")
    parser.add_argument("--spent-hours", default="", help="兼容旧参数：本次实际投入工时。")
    parser.add_argument("--note", default="", help="执行备注。")
    parser.add_argument("--owner", default="", help="执行人。")
    return parser.parse_args()


def resolve_spent_days(spent_days: str, spent_hours: str) -> float:
    if spent_days.strip() not in {"", "0", "0.0"}:
        return parse_effort_days(spent_days.strip())
    if spent_hours.strip() not in {"", "0", "0.0"}:
        return parse_effort_days(f"{spent_hours.strip()}h")
    return 0.0


def update_item(path: Path, status: str, work_block: str, spent_days: float, note: str, owner: str) -> str:
    lines = path.read_text(encoding="utf-8").splitlines()
    updated = []
    work_block_updated = not work_block
    original_status = ""
    top_status_updated = False

    for line in lines:
        if line.startswith("- 状态：") and not original_status:
            original_status = line.removeprefix("- 状态：").strip()
        if line.startswith("- 状态：") and not work_block and not top_status_updated:
            updated.append(f"- 状态：{status}")
            top_status_updated = True
            continue
        if work_block and line.startswith(f"| {work_block} |"):
            parts = [part.strip() for part in line.split("|")]
            if len(parts) >= 5:
                line = f"| {parts[1]} | {parts[2]} | {parts[3]} | {status} |"
                work_block_updated = True
        updated.append(line)

    if work_block and not work_block_updated:
        raise RuntimeError(f"未找到工作块：{work_block}")

    done_count = 0
    active_count = 0
    blocked_count = 0
    block_count = 0
    for line in updated:
        if line.startswith("| WB-"):
            block_count += 1
            columns = [part.strip() for part in line.split("|")]
            block_status = columns[-2] if len(columns) >= 5 else ""
            if block_status == "已完成":
                done_count += 1
            if block_status == "进行中":
                active_count += 1
            if block_status == "阻塞":
                blocked_count += 1

    aggregate_status = original_status or "待开始"
    if not work_block:
        aggregate_status = status
    elif block_count:
        if done_count == block_count:
            aggregate_status = "已完成"
        elif blocked_count > 0:
            aggregate_status = "阻塞"
        elif active_count > 0 or done_count > 0:
            aggregate_status = "进行中"
        else:
            aggregate_status = "待开始"

    final = []
    top_status_rewritten = False
    for line in updated:
        if line.startswith("- 状态：") and not top_status_rewritten:
            final.append(f"- 状态：{aggregate_status}")
            top_status_rewritten = True
            continue
        final.append(line)

    execution_header = "## 执行记录"
    if execution_header in final:
        index = final.index(execution_header)
        insert_at = index + 2
        final = [line for line in final if line.strip() != "- 待开始。"]
        index = final.index(execution_header)
        insert_at = index + 2
        if work_block:
            note_line = (
                f"- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: 工作块 `{work_block}` 状态更新为 `{status}`，"
                f"工作项当前状态：`{aggregate_status}`"
            )
        else:
            note_line = f"- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: 工作项状态更新为 `{aggregate_status}`"
        if work_block:
            pass
        if owner:
            note_line += f"，执行人：{owner}"
        if spent_days > 0:
            note_line += f"，本次投入：{format_effort_days(spent_days)}"
        if note:
            note_line += f"，备注：{note}"
        final.insert(insert_at, note_line)

    path.write_text("\n".join(final).rstrip() + "\n", encoding="utf-8")
    return aggregate_status


def append_execution_log(
    project_root: Path,
    item_id: str,
    status: str,
    aggregate_status: str,
    work_block: str,
    spent_days: float,
    note: str,
) -> None:
    path = project_root / ".factory" / "process" / "execution-log.md"
    if work_block:
        line = (
            f"- {datetime.now().strftime('%Y-%m-%d')}: `{item_id}` 的工作块 `{work_block}` 状态更新为 `{status}`，"
            f"工作项当前状态：`{aggregate_status}`。"
        )
    else:
        line = f"- {datetime.now().strftime('%Y-%m-%d')}: `{item_id}` 状态更新为 `{aggregate_status}`。"
    if work_block:
        pass
    if spent_days > 0:
        line += f" 本次投入：{format_effort_days(spent_days)}。"
    if note:
        line += f" 备注：{note}"
    append_log_line(path, line)


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason=f"推进工作项 {args.item.strip()}"):
            item_file = find_item_file(project_root, args.item.strip())
            spent_days = resolve_spent_days(args.spent_days, args.spent_hours)
            aggregate_status = update_item(
                item_file,
                status=args.status.strip(),
                work_block=args.work_block.strip(),
                spent_days=spent_days,
                note=args.note.strip(),
                owner=args.owner.strip(),
            )
            append_execution_log(
                project_root,
                item_id=args.item.strip(),
                status=args.status.strip(),
                aggregate_status=aggregate_status,
                work_block=args.work_block.strip(),
                spent_days=spent_days,
                note=args.note.strip(),
            )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"更新任务执行状态失败：{exc}", file=sys.stderr)
        return 1

    print(f"已更新工作项：{args.item.strip()}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
