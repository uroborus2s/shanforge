#!/usr/bin/env python3

import argparse
from datetime import datetime
import json
from pathlib import Path
import re
import sys
import uuid

from factory_core import (
    EXECUTION_LOG_RELATIVE,
    append_log_line,
    build_reply_summary,
    factory_workspace_root,
    load_json_document,
    skill_change_governance,
    write_text,
)

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
SKILL_CREATOR_SCRIPTS = REPO_ROOT / "skills" / "skill-creator" / "scripts"
if str(SKILL_CREATOR_SCRIPTS) not in sys.path:
    sys.path.insert(0, str(SKILL_CREATOR_SCRIPTS))

from quick_validate import validate_skill  # noqa: E402


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="将满足评估与批准条件的候选 skill 晋升到正式 skills/。")
    parser.add_argument("target", nargs="?", help="候选 skill 名称/目录，或晋升记录 ID。")
    parser.add_argument("--list", action="store_true", help="列出当前 skill 晋升记录。")
    parser.add_argument("--check", action="store_true", help="只检查候选 skill 是否满足晋升条件，不执行写入。")
    parser.add_argument("--owner", default="技能发布者", help="当前晋升责任人。")
    parser.add_argument("--note", default="", help="晋升备注。")
    parser.add_argument("--json", action="store_true", help="以 JSON 输出。")
    return parser.parse_args()


def skill_slug(value: str) -> str:
    normalized = re.sub(r"[^a-z0-9]+", "-", str(value or "").strip().lower()).strip("-")
    return normalized or "candidate-skill"


def candidate_root() -> Path:
    governance = skill_change_governance()
    root = str(governance.get("candidate_root", "skills-drafts")).strip() or "skills-drafts"
    return factory_workspace_root() / root


def skill_promotion_state_path() -> Path:
    return factory_workspace_root() / ".factory" / "process" / "skill-promotions.json"


def skill_promotion_report_path() -> Path:
    return factory_workspace_root() / ".factory" / "process" / "skill-promotions.md"


def skill_promotion_summary_path() -> Path:
    return factory_workspace_root() / ".factory" / "memory" / "skill-promotions.summary.md"


def load_skill_promotion_records() -> list[dict]:
    payload = load_json_document(skill_promotion_state_path())
    if not isinstance(payload, dict):
        return []
    records = payload.get("records", [])
    if not isinstance(records, list):
        return []
    return [dict(item) for item in records if isinstance(item, dict)]


def save_skill_promotion_records(records: list[dict]) -> None:
    payload = {
        "version": 1,
        "updated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "records": records,
    }
    write_text(skill_promotion_state_path(), json.dumps(payload, ensure_ascii=False, indent=2))


def new_skill_promotion_id(candidate_name: str) -> str:
    stamp = datetime.now().strftime("%Y%m%d%H%M%S")
    short = uuid.uuid4().hex[:6]
    return f"SP-{stamp}-{skill_slug(candidate_name)[:12]}-{short}"


def ordered_records(records: list[dict]) -> list[dict]:
    return sorted(records, key=lambda item: str(item.get("promoted_at", item.get("updated_at", ""))), reverse=True)


def render_skill_promotion_report(records: list[dict]) -> str:
    ordered = ordered_records(records)
    recent = ordered[:10]
    lines = [
        "# Skill 晋升记录",
        "",
        f"- 更新时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 全部记录：{len(ordered)}",
        "",
        "## 最近晋升",
        "",
    ]
    if recent:
        for item in recent:
            lines.append(
                f"- `{item.get('id', '')}` | 候选：`{item.get('candidate_name', '')}` | 正式目标：`{item.get('official_skill_path', '')}` | 发布者：{item.get('owner', '') or '无'}"
            )
    else:
        lines.append("- 当前还没有 skill 晋升记录。")
    return "\n".join(lines).rstrip() + "\n"


def write_skill_promotion_views(records: list[dict]) -> None:
    ordered = ordered_records(records)
    write_text(skill_promotion_report_path(), render_skill_promotion_report(records))
    write_text(
        skill_promotion_summary_path(),
        "\n".join(
            [
                "# Skill 晋升摘要",
                "",
                f"- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                f"- 总记录：{len(ordered)}",
                f"- 最近晋升：{ordered[0].get('candidate_name', '无') if ordered else '无'}",
            ]
        ),
    )


def resolve_candidate_dir(target: str) -> Path:
    raw = str(target or "").strip()
    if not raw:
        raise RuntimeError("必须提供候选 skill 名称或目录。")
    direct = Path(raw).expanduser()
    if direct.exists():
        return direct.resolve()
    workspace_relative = (factory_workspace_root() / raw).resolve()
    if workspace_relative.exists():
        return workspace_relative
    return (candidate_root() / skill_slug(raw)).resolve()


def load_candidate_record(target: str) -> tuple[Path, dict]:
    candidate_dir = resolve_candidate_dir(target)
    proposal_path = candidate_dir / "proposal.json"
    if not proposal_path.exists():
        raise RuntimeError(f"候选 skill 提案不存在：{proposal_path}")
    payload = load_json_document(proposal_path)
    if not isinstance(payload, dict):
        raise RuntimeError(f"候选 skill 提案无效：{proposal_path}")
    return candidate_dir, payload


def official_skill_path(proposal: dict) -> Path:
    official_relative = str(proposal.get("official_skill_path", "")).strip()
    if official_relative:
        return (factory_workspace_root() / official_relative).resolve()
    target_skill = str(proposal.get("target_skill", "")).strip() or str(proposal.get("name", "")).strip()
    return (factory_workspace_root() / "skills" / target_skill / "SKILL.md").resolve()


def candidate_artifacts(candidate_dir: Path) -> dict[str, str]:
    workspace_root = factory_workspace_root().resolve()
    return {
        "candidate_skill": str((candidate_dir / "SKILL.md").resolve().relative_to(workspace_root)),
        "proposal": str((candidate_dir / "proposal.json").resolve().relative_to(workspace_root)),
        "eval_cases": str((candidate_dir / "evals" / "evals.json").resolve().relative_to(workspace_root)),
        "eval_report": str((candidate_dir / "evals" / "eval-report.json").resolve().relative_to(workspace_root)),
        "change_summary": str((candidate_dir / "change-summary.md").resolve().relative_to(workspace_root)),
        "approval_record": str((candidate_dir / "approval.json").resolve().relative_to(workspace_root)),
    }


def artifact_status(artifacts: dict[str, str]) -> list[dict]:
    root = factory_workspace_root().resolve()
    return [{"name": name, "path": path, "exists": (root / path).exists()} for name, path in artifacts.items()]


def load_eval_report(candidate_dir: Path) -> dict:
    payload = load_json_document(candidate_dir / "evals" / "eval-report.json")
    return dict(payload) if isinstance(payload, dict) else {}


def load_approval_record(candidate_dir: Path) -> dict:
    payload = load_json_document(candidate_dir / "approval.json")
    return dict(payload) if isinstance(payload, dict) else {}


def readiness_payload(candidate_dir: Path, proposal: dict) -> dict:
    artifacts = candidate_artifacts(candidate_dir)
    artifact_items = artifact_status(artifacts)
    missing = [item["path"] for item in artifact_items if not item["exists"]]
    valid_skill, validation_message = validate_skill(candidate_dir)
    eval_report = load_eval_report(candidate_dir)
    eval_status = str(eval_report.get("status", "")).strip()
    approval_record = load_approval_record(candidate_dir)
    approval_decision = str(approval_record.get("decision", "")).strip()
    official_path = official_skill_path(proposal)
    official_relative = str(official_path.relative_to(factory_workspace_root().resolve()))
    target_skill = str(proposal.get("target_skill", "")).strip()
    name_mismatch = bool(target_skill and target_skill != str(proposal.get("name", "")).strip())

    blockers: list[str] = []
    if missing:
        blockers.append("缺少必要产物：" + "，".join(missing))
    if not valid_skill:
        blockers.append(f"候选 skill 结构校验未通过：{validation_message}")
    if eval_status != "passed":
        blockers.append("评估结果未通过；需要 `evals/eval-report.json` 标记为 `passed`")
    if approval_decision != "approve":
        blockers.append("候选 skill 尚未获得批准；需要 `approval.json` 的 decision 为 `approve`")
    if name_mismatch:
        blockers.append(
            f"候选 skill 名称 `{proposal.get('name', '')}` 与正式目标 `{target_skill}` 不一致，当前不允许直接晋升"
        )

    return {
        "candidate_name": str(proposal.get("name", "")).strip(),
        "candidate_dir": str(candidate_dir.resolve().relative_to(factory_workspace_root().resolve())),
        "official_skill_path": official_relative,
        "artifact_status": artifact_items,
        "eval_report": eval_report,
        "approval_record": approval_record,
        "skill_validation": {"valid": bool(valid_skill), "message": validation_message},
        "ready": not blockers,
        "blockers": blockers,
        "official_exists": official_path.exists(),
    }


def list_payload() -> dict:
    records = ordered_records(load_skill_promotion_records())
    payload = {
        "status": "success",
        "summary": f"当前共有 {len(records)} 条 skill 晋升记录。",
        "recent": records[:10],
        "total": len(records),
    }
    payload["reply_summary"] = build_reply_summary("skill-promote", payload)
    return payload


def inspect_target(target: str) -> dict:
    if str(target).startswith("SP-"):
        for item in load_skill_promotion_records():
            if item.get("id") == target:
                payload = {
                    "status": "success",
                    "summary": f"已读取 skill 晋升记录 `{target}`。",
                    "record": item,
                    "promotion": item,
                }
                payload["reply_summary"] = build_reply_summary("skill-promote", payload)
                return payload
        raise RuntimeError(f"未找到 skill 晋升记录：{target}")

    candidate_dir, proposal = load_candidate_record(target)
    readiness = readiness_payload(candidate_dir, proposal)
    payload = {
        "status": "ready" if readiness["ready"] else "blocked",
        "summary": f"已检查候选 skill `{readiness['candidate_name']}` 的晋升条件。",
        "candidate": readiness,
    }
    payload["reply_summary"] = build_reply_summary("skill-promote", payload)
    return payload


def write_candidate_promotion(candidate_dir: Path, proposal: dict, record: dict) -> None:
    write_text(candidate_dir / "promotion.json", json.dumps(record, ensure_ascii=False, indent=2))
    write_text(candidate_dir / "proposal.json", json.dumps(proposal, ensure_ascii=False, indent=2))


def promote_candidate(target: str, *, owner: str, note: str) -> dict:
    candidate_dir, proposal = load_candidate_record(target)
    if str(proposal.get("promotion_status", "")).strip() == "promoted":
        existing = load_json_document(candidate_dir / "promotion.json")
        payload = {
            "status": "already_promoted",
            "summary": f"候选 skill `{proposal.get('name', '')}` 已完成晋升。",
            "promotion": dict(existing) if isinstance(existing, dict) else {},
        }
        payload["reply_summary"] = build_reply_summary("skill-promote", payload)
        return payload

    readiness = readiness_payload(candidate_dir, proposal)
    if not readiness["ready"]:
        raise RuntimeError("候选 skill 未满足晋升条件：" + "；".join(readiness["blockers"]))

    records = load_skill_promotion_records()
    official_path = (factory_workspace_root().resolve() / readiness["official_skill_path"]).resolve()
    official_path.parent.mkdir(parents=True, exist_ok=True)

    backup_relative = ""
    if official_path.exists():
        backup_name = f"official-SKILL.before-promote-{datetime.now().strftime('%Y%m%d%H%M%S')}.md"
        backup_path = candidate_dir / "backups" / backup_name
        write_text(backup_path, official_path.read_text(encoding="utf-8"))
        backup_relative = str(backup_path.resolve().relative_to(factory_workspace_root().resolve()))

    write_text(official_path, (candidate_dir / "SKILL.md").read_text(encoding="utf-8"))

    promoted_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    promotion_id = new_skill_promotion_id(readiness["candidate_name"])
    record = {
        "version": 1,
        "id": promotion_id,
        "status": "promoted",
        "candidate_name": readiness["candidate_name"],
        "candidate_dir": readiness["candidate_dir"],
        "official_skill_path": readiness["official_skill_path"],
        "backup_path": backup_relative,
        "owner": owner,
        "note": note.strip(),
        "promoted_at": promoted_at,
        "eval_status": readiness["eval_report"].get("status", ""),
        "approval_ticket": readiness["approval_record"].get("ticket", ""),
        "approval_owner": readiness["approval_record"].get("owner", ""),
    }
    records.append(record)
    save_skill_promotion_records(records)
    write_skill_promotion_views(records)

    proposal["status"] = "promoted_candidate"
    proposal["promotion_status"] = "promoted"
    proposal["promoted_at"] = promoted_at
    proposal["promotion_record"] = record
    proposal["official_skill_path"] = readiness["official_skill_path"]
    write_candidate_promotion(candidate_dir, proposal, record)

    append_log_line(
        factory_workspace_root() / EXECUTION_LOG_RELATIVE,
        f"- {datetime.now().strftime('%Y-%m-%d')}: 执行 skill 晋升 `{promotion_id}`，候选 `{readiness['candidate_name']}` -> `{readiness['official_skill_path']}`，发布者 `{owner}`。",
    )

    artifacts = [
        readiness["official_skill_path"],
        readiness["candidate_dir"] + "/promotion.json",
        ".factory/process/skill-promotions.json",
        ".factory/process/skill-promotions.md",
        ".factory/memory/skill-promotions.summary.md",
    ]
    if backup_relative:
        artifacts.append(backup_relative)

    payload = {
        "status": "promoted",
        "summary": f"已将候选 skill `{readiness['candidate_name']}` 晋升到 `{readiness['official_skill_path']}`。",
        "promotion": record,
        "artifacts": artifacts,
        "next_actions": [
            "如该 skill 需要进一步演进，请从新的候选草案重新开始，不要直接覆盖正式 skill。",
            "如需回退，后续应复用候选目录中的 backup 产物，而不是手工覆盖。",
        ],
    }
    payload["reply_summary"] = build_reply_summary("skill-promote", payload)
    return payload


def render_markdown(payload: dict) -> str:
    status = payload.get("status", "unknown")
    if "recent" in payload:
        lines = [
            "# Skill 晋升记录",
            "",
            f"- 状态：`{status}`",
            f"- 摘要：{payload.get('summary', '无')}",
            f"- 总记录：`{payload.get('total', 0)}`",
            "",
            "## 最近记录",
            "",
        ]
        recent = payload.get("recent", [])
        if recent:
            for item in recent:
                lines.append(
                    f"- `{item.get('id', '')}` | 候选：`{item.get('candidate_name', '')}` | 正式目标：`{item.get('official_skill_path', '')}` | 发布者：{item.get('owner', '') or '无'}"
                )
        else:
            lines.append("- 当前还没有 skill 晋升记录。")
        items = (payload.get("reply_summary") or {}).get("items") or []
        if items:
            lines.extend(["", "## 对话摘要", ""])
            for item in items:
                lines.append(f"- {item.get('label', item.get('path', ''))}：{item.get('value')}")
        return "\n".join(lines).rstrip() + "\n"

    if "candidate" in payload:
        candidate = payload["candidate"]
        lines = [
            "# Skill 晋升检查",
            "",
            f"- 状态：`{status}`",
            f"- 摘要：{payload.get('summary', '无')}",
            f"- 候选：`{candidate.get('candidate_name', '')}`",
            f"- 目录：`{candidate.get('candidate_dir', '')}`",
            f"- 正式目标：`{candidate.get('official_skill_path', '')}`",
            f"- 是否就绪：`{'是' if candidate.get('ready') else '否'}`",
            "",
            "## 产物校验",
            "",
        ]
        for item in candidate.get("artifact_status", []):
            lines.append(f"- `{item['path']}` | {'存在' if item['exists'] else '缺失'}")
        blockers = candidate.get("blockers") or []
        if blockers:
            lines.extend(["", "## 阻断项", ""])
            lines.extend(f"- {item}" for item in blockers)
        items = (payload.get("reply_summary") or {}).get("items") or []
        if items:
            lines.extend(["", "## 对话摘要", ""])
            for item in items:
                lines.append(f"- {item.get('label', item.get('path', ''))}：{item.get('value')}")
        return "\n".join(lines).rstrip() + "\n"

    promotion = payload.get("promotion") or {}
    lines = [
        "# Skill 晋升结果",
        "",
        f"- 状态：`{status}`",
        f"- 摘要：{payload.get('summary', '无')}",
        f"- 晋升记录：`{promotion.get('id', '')}`",
        f"- 候选：`{promotion.get('candidate_name', '')}`",
        f"- 正式目标：`{promotion.get('official_skill_path', '')}`",
        f"- 发布者：`{promotion.get('owner', '')}`",
    ]
    if promotion.get("backup_path"):
        lines.append(f"- 备份：`{promotion.get('backup_path', '')}`")
    next_actions = payload.get("next_actions") or []
    if next_actions:
        lines.extend(["", "## 下一步", ""])
        lines.extend(f"- {item}" for item in next_actions)
    items = (payload.get("reply_summary") or {}).get("items") or []
    if items:
        lines.extend(["", "## 对话摘要", ""])
        for item in items:
            lines.append(f"- {item.get('label', item.get('path', ''))}：{item.get('value')}")
    return "\n".join(lines).rstrip() + "\n"


def main() -> int:
    args = parse_args()
    try:
        if args.list and args.check:
            raise RuntimeError("`--list` 与 `--check` 不能同时使用。")
        if args.list or (not args.target and not args.check):
            payload = list_payload()
        elif args.check:
            if not args.target:
                raise RuntimeError("检查晋升条件时必须提供候选 skill 名称或目录。")
            payload = inspect_target(args.target)
        else:
            if not args.target:
                raise RuntimeError("执行 skill 晋升时必须提供候选 skill 名称或目录。")
            payload = promote_candidate(args.target, owner=args.owner.strip(), note=args.note)
    except Exception as exc:
        print(f"skill 晋升失败：{exc}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0

    print(render_markdown(payload))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
