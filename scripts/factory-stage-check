#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    append_log_line,
    collect_items,
    current_tech_profile,
    file_readiness,
    load_project_config,
    project_lock,
    refresh_ai_memory,
    save_project_config,
    task_work_block_status,
)

STAGE_REQUIREMENTS = {
    "BRAINSTORM": [
        "docs/00-governance/project-charter.md",
        "docs/01-discovery/input.md",
        "docs/01-discovery/brainstorm-record.md",
    ],
    "REQUIREMENTS": [
        "docs/02-requirements/prd.md",
        "docs/02-requirements/requirements-analysis.md",
    ],
    "ANALYSIS": [
        "docs/02-requirements/requirements-analysis.md",
        "docs/02-requirements/requirements-verification.md",
        "docs/traceability/requirements-matrix.md",
    ],
    "DESIGN": [
        "docs/03-solution/system-architecture.md",
        "docs/03-solution/technical-selection.md",
        "docs/03-solution/module-boundaries.md",
        "docs/03-solution/api-design.md",
        "docs/03-solution/backend-design.md",
        "docs/03-solution/database-design.md",
        "docs/03-solution/ux-ui-design.md",
    ],
    "PLAN": [
        "docs/03-solution/technical-selection.md",
        "docs/03-solution/module-boundaries.md",
        "docs/04-delivery/wbs.md",
        "docs/04-delivery/task-breakdown.md",
        "docs/04-delivery/implementation-plan.md",
    ],
    "IMPLEMENTATION": [
        "docs/03-solution/technical-selection.md",
        ".factory/process/execution-log.md",
    ],
    "TESTING": [
        "docs/05-quality/test-plan.md",
        "docs/05-quality/test-cases.md",
        "docs/05-quality/test-report.md",
    ],
    "ACCEPTANCE": [
        "docs/06-release/acceptance-checklist.md",
        ".factory/process/stage-check-report.md",
        ".factory/process/quality-check-report.md",
    ],
    "RELEASE": [
        "docs/06-release/release-notes.md",
        "docs/06-release/delivery-package.md",
        "docs/07-operations/deployment-guide.md",
        "docs/08-handover/user-guide.md",
    ],
    "MAINTENANCE": [
        "docs/07-operations/operations-runbook.md",
        "docs/09-evolution/retrospective.md",
    ],
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="检查当前阶段所需文档和工作项状态，并生成阶段检查报告。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--stage", default="", help="检查的阶段；不传则使用当前阶段。")
    parser.add_argument("--owner", default="待记录", help="检查人。")
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--strict", action="store_true", help="若结果不是通过，则返回非 0。")
    return parser.parse_args()


def stage_dynamic_checks(project_root: Path, stage: str, items: list[dict]) -> list[tuple[str, str, str]]:
    checks = []
    config = load_project_config(project_root)
    if stage in {"REQUIREMENTS", "ANALYSIS"}:
        result = config.get("last_requirements_verification_result", "")
        checked_at = config.get("last_requirements_verification_at", "")
        if result == "通过":
            checks.append(("需求一致性校验", "就绪", f"最近结果：{result}，时间：{checked_at or '未记录'}"))
        elif result:
            checks.append(("需求一致性校验", "关注", f"最近结果：{result}，时间：{checked_at or '未记录'}"))
        else:
            checks.append(("需求一致性校验", "关注", "尚未执行 `factory-requirements-verify`。"))
    if stage == "DESIGN":
        design_assets = config.get("design_assets", [])
        asset_count = len(design_assets) if isinstance(design_assets, list) else 0
        status = "就绪" if asset_count else "关注"
        reason = f"已登记设计交付物：{asset_count} 个" if asset_count else "当前仅有文字设计说明，建议为关键页面补充可直观看到的设计交付物。"
        checks.append(("设计交付物", status, reason))
    if stage in {"DESIGN", "PLAN", "IMPLEMENTATION"}:
        required_skills = current_tech_profile(config).get("required_skills", [])
        skill_status = "就绪" if required_skills else "关注"
        skill_reason = f"当前技术画像要求 skills：{'、'.join(required_skills)}" if required_skills else "技术画像尚未声明强制技能，建议先登记语言/框架规范。"
        checks.append(("技术画像技能约束", skill_status, skill_reason))
    if stage in {"PLAN", "IMPLEMENTATION"}:
        block_state, block_lines = task_work_block_status(items)
        compact = "；".join(
            line.removeprefix("- ").replace("`", "")
            for line in block_lines[:2]
        ) or "当前未发现活跃实施任务。"
        if len(block_lines) > 2:
            compact += f"；另有 {len(block_lines) - 2} 条明细"
        checks.append(("任务工作块质量", block_state, compact))
    if stage == "IMPLEMENTATION":
        active_tasks = [item for item in items if item["id"].startswith("TASK-")]
        checks.append(
            (
                "实施任务",
                "就绪" if active_tasks else "缺失",
                f"当前任务数：{len(active_tasks)}",
            )
        )
    if stage == "RELEASE":
        release_root = project_root / "releases"
        count = len([path for path in release_root.iterdir() if path.is_dir()]) if release_root.exists() else 0
        checks.append(("发布包", "就绪" if count else "占位", f"当前发布包数：{count}"))
    return checks


def compute_result(doc_checks: list[tuple[str, str, str]], items: list[dict]) -> tuple[str, list[str]]:
    suggestions = []
    blocked = [item for item in items if item["status"] == "阻塞"]
    missing_or_placeholder = [item for item in doc_checks if item[1] in {"缺失", "占位"}]
    attention_items = [item for item in doc_checks if item[1] == "关注"]

    if missing_or_placeholder:
        result = "未通过"
        suggestions.append("先补齐缺失或仍为占位内容的阶段文档。")
    elif attention_items or blocked:
        result = "关注"
        if attention_items:
            suggestions.append("先细化任务的人天工作块或补充关键阶段细节，再进入下一阶段或提交 Gate 评审。")
        if blocked:
            suggestions.append("先处理阻塞项，再进入下一阶段或提交 Gate 评审。")
    else:
        result = "通过"
        suggestions.append("当前阶段检查通过，可以进入 Gate 评审或推进下一阶段。")

    if not blocked:
        suggestions.append("当前无阻塞工作项。")
    else:
        suggestions.append(f"当前阻塞项数量：{len(blocked)}。")
    return result, suggestions


def upsert_report(path: Path, latest_lines: list[str], doc_lines: list[str], risk_lines: list[str], suggestion_lines: list[str], history_line: str) -> None:
    if path.exists():
        lines = path.read_text(encoding="utf-8").splitlines()
    else:
        lines = ["# 阶段检查报告", ""]

    sections = {
        "## 最新检查": latest_lines,
        "## 文档与工件检查": doc_lines,
        "## 风险与阻塞": risk_lines,
        "## 建议动作": suggestion_lines,
    }

    for header, content_lines in sections.items():
        if header in lines:
            start = lines.index(header)
            end = len(lines)
            for index in range(start + 1, len(lines)):
                if lines[index].startswith("## "):
                    end = index
                    break
            lines = lines[: start + 1] + [""] + content_lines + [""] + lines[end:]
        else:
            if lines and lines[-1] != "":
                lines.append("")
            lines.extend([header, "", *content_lines, ""])

    history_header = "## 历史检查记录"
    if history_header in lines:
        start = lines.index(history_header)
        insert_at = start + 2 if start + 1 < len(lines) and lines[start + 1] == "" else start + 1
        if history_line not in lines:
            lines.insert(insert_at, history_line)
    else:
        if lines and lines[-1] != "":
            lines.append("")
        lines.extend([history_header, "", history_line, ""])

    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()

    try:
        with project_lock(project_root, reason="执行阶段检查"):
            config = load_project_config(project_root)
            stage = args.stage.strip() or config.get("stage", "BRAINSTORM")
            required_docs = STAGE_REQUIREMENTS.get(stage, [])
            items = collect_items(project_root)

            doc_checks = []
            for relative in required_docs:
                readiness, reason = file_readiness(project_root / relative)
                doc_checks.append((relative, readiness, reason))
            doc_checks.extend(stage_dynamic_checks(project_root, stage, items))

            result, suggestions = compute_result(doc_checks, items)
            blocked_items = [item for item in items if item["status"] == "阻塞"]
            latest_lines = [
                f"- 检查阶段：{stage}",
                f"- 检查结果：{result}",
                f"- 检查时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                f"- 检查人：{args.owner.strip()}",
                f"- 备注：{args.note.strip() or '无'}",
            ]
            doc_lines = [f"- `{name}`：{status}，{reason}" for name, status, reason in doc_checks] or ["- 无"]
            risk_lines = (
                [f"- `{item['id']}` {item['title']} | 负责人：{item['owner']}" for item in blocked_items]
                if blocked_items
                else ["- 当前无阻塞项。"]
            )
            suggestion_lines = [f"- {line}" for line in suggestions]
            history_line = (
                f"- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: 阶段 `{stage}` 检查结果 `{result}`，"
                f"检查人：{args.owner.strip()}。"
            )

            report_path = project_root / ".factory" / "process" / "stage-check-report.md"
            upsert_report(report_path, latest_lines, doc_lines, risk_lines, suggestion_lines, history_line)

            ai_summary = "\n".join(
                [
                    "# 阶段检查摘要",
                    "",
                    f"- 阶段：{stage}",
                    f"- 结果：{result}",
                    f"- 检查人：{args.owner.strip()}",
                    f"- 检查时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                    "",
                    "## 关键检查项",
                    "",
                    *doc_lines,
                    "",
                    "## 风险与阻塞",
                    "",
                    *risk_lines,
                    "",
                    "## 建议动作",
                    "",
                    *suggestion_lines,
                ]
            )
            (project_root / ".factory" / "memory" / "stage-check.summary.md").write_text(ai_summary.rstrip() + "\n", encoding="utf-8")

            stage_checks = config.setdefault("stage_checks", [])
            stage_checks.append(
                {
                    "stage": stage,
                    "result": result,
                    "owner": args.owner.strip(),
                    "note": args.note.strip(),
                    "checked_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                }
            )
            config["last_stage_check_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_stage_check_result"] = result
            save_project_config(project_root, config)

            log_line = f"- {datetime.now().strftime('%Y-%m-%d')}: 阶段 `{stage}` 检查完成，结果：{result}，检查人：{args.owner.strip()}。"
            append_log_line(project_root / ".factory" / "process" / "execution-log.md", log_line)
            append_log_line(project_root / "docs" / "06-release" / "acceptance-checklist.md", log_line)
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"阶段检查失败：{exc}", file=sys.stderr)
        return 1

    print(f"已完成阶段检查：{stage} -> {result}")
    if args.strict and result != "通过":
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
