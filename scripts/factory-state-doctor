#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import re
import sys

from factory_core import (
    CLOSED_STATUSES,
    append_log_line,
    collect_items,
    docs_stratego_validate_status,
    file_readiness,
    inspect_project_lock,
    load_project_config,
    project_lock,
    read_risks,
    save_project_config,
    stage_reference_docs,
    task_work_block_status,
    write_text,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="诊断项目当前状态、文档、AI 记忆和锁健康度。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--owner", default="项目医生", help="诊断负责人。")
    parser.add_argument(
        "--scope",
        default="full",
        choices=["full", "docs", "memory", "locks", "gate", "delivery"],
        help="诊断范围。",
    )
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--strict", action="store_true", help="若结果不是通过则返回非 0。")
    return parser.parse_args()


def latest_source_mtime(project_root: Path) -> float:
    roots = [
        project_root / "docs",
        project_root / ".factory" / "workitems",
        project_root / ".factory" / "project.json",
    ]
    latest = 0.0
    for root in roots:
        if not root.exists():
            continue
        if root.is_file():
            latest = max(latest, root.stat().st_mtime)
            continue
        for path in root.rglob("*"):
            if path.is_file():
                latest = max(latest, path.stat().st_mtime)
    return latest


def ai_memory_status(project_root: Path) -> tuple[str, list[str], float]:
    ai_files = [
        project_root / ".factory" / "memory" / "project-index.md",
        project_root / ".factory" / "memory" / "current-state.md",
        project_root / ".factory" / "memory" / "tasks.summary.md",
        project_root / ".factory" / "memory" / "change-summary.md",
    ]
    missing = [str(path.relative_to(project_root)) for path in ai_files if not path.exists()]
    if missing:
        return "缺失", [f"- 缺少 AI 记忆文件：{item}" for item in missing], 0.0

    latest_ai = max(path.stat().st_mtime for path in ai_files)
    latest_source = latest_source_mtime(project_root)
    if latest_source > latest_ai + 1.0:
        return "滞后", [f"- AI 记忆晚于源文件更新时间不足，建议刷新 `factory-refresh-memory`。"], latest_ai
    return "就绪", ["- AI 记忆与当前项目资产时间线基本一致。"], latest_ai


def trace_status(project_root: Path) -> tuple[str, list[str], int]:
    graph_path = project_root / ".factory" / "memory" / "graph" / "traceability.json"
    if not graph_path.exists():
        return "缺失", ["- 缺少 `.factory/memory/graph/traceability.json`。"], 0
    try:
        import json

        graph = json.loads(graph_path.read_text(encoding="utf-8"))
        edge_count = len(graph.get("edges", []))
    except Exception:
        return "异常", ["- 追踪图谱文件无法解析。"], 0
    if edge_count == 0:
        return "空", ["- 当前追踪关系为 0。"], 0
    return "就绪", [f"- 当前追踪关系数：{edge_count}。"], edge_count


def doc_status(project_root: Path, stage: str) -> tuple[str, list[str]]:
    references = stage_reference_docs(stage)
    if not references:
        return "就绪", ["- 当前阶段未定义额外参考文档。"]
    lines = []
    severities = []
    for relative in references:
        status, reason = file_readiness(project_root / relative)
        lines.append(f"- `{relative}`：{status}，{reason}")
        severities.append(status)
    if "缺失" in severities:
        return "缺失", lines
    if "占位" in severities:
        return "占位", lines
    return "就绪", lines


RULE_ENTRY_PATTERNS: list[tuple[str, re.Pattern[str]]] = [
    (
        "状态快照章节标题",
        re.compile(r"^##\s*(当前真实状态|项目事实摘要|当前建议运行方式|当前默认动作)", re.MULTILINE),
    ),
    (
        "安装或锁文件瞬时结论",
        re.compile(r"pnpm install --frozen-lockfile|当前没有 `node_modules`|lockfile.*不一致", re.IGNORECASE),
    ),
    (
        "临时验证结论措辞",
        re.compile(r"已确认.+(失败|通过)|本地已验证可运行|可直接冷启动", re.MULTILINE),
    ),
]


def rules_entry_status(project_root: Path) -> tuple[str, list[str]]:
    targets = [
        project_root / "AGENTS.md",
        project_root / "GEMINI.md",
    ]
    missing = [str(path.relative_to(project_root)) for path in targets if not path.exists()]
    if missing:
        return "缺失", [f"- 缺少规则入口文件：`{item}`。 " for item in missing]

    findings: list[str] = []
    for path in targets:
        text = path.read_text(encoding="utf-8", errors="ignore")
        matched = [label for label, pattern in RULE_ENTRY_PATTERNS if pattern.search(text)]
        if matched:
            findings.append(
                f"- `{path.relative_to(project_root)}` 含有不应出现在规则入口中的瞬时状态信号：{', '.join(matched)}。"
            )
    if findings:
        findings.append(
            "- `AGENTS.md` / `GEMINI.md` 应只保留稳定协作规则、读取顺序和边界；把当前验证结果迁移到 `.factory/project.json`、`.factory/memory/current-state.md` 和阶段文档。"
        )
        return "污染", findings
    return "就绪", ["- `AGENTS.md` / `GEMINI.md` 当前更接近稳定协作入口，未发现明显的现状快照污染。"]


def determine_result(
    scope: str,
    rules_state: str,
    doc_state: str,
    docs_source_state: str,
    memory_state: str,
    lock_info: dict,
    trace_state: str,
    task_state: str,
    blocked_count: int,
    risk_count: int,
) -> tuple[str, list[str]]:
    issues: list[str] = []
    warnings: list[str] = []

    if scope in {"full", "docs", "gate", "delivery"}:
        if rules_state == "缺失":
            issues.append("规则入口文件缺失。")
        elif rules_state == "污染":
            issues.append("`AGENTS.md` / `GEMINI.md` 混入了瞬时状态，已偏离协作入口职责。")

    if scope in {"full", "docs", "gate", "delivery"}:
        if doc_state == "缺失":
            issues.append("存在缺失的阶段关键文档。")
        elif doc_state == "占位":
            issues.append("存在仍为占位内容的阶段关键文档。")

    if scope in {"full", "docs", "gate", "delivery"} and docs_source_state != "就绪":
        issues.append("`docs/` 尚未满足 docs-stratego 源文档标准。")

    if scope in {"full", "memory", "delivery"}:
        if memory_state == "缺失":
            issues.append("AI 记忆文件不完整。")
        elif memory_state == "滞后":
            warnings.append("AI 记忆相对源文件已滞后。")

    if scope in {"full", "gate", "delivery"}:
        if trace_state in {"缺失", "异常"}:
            issues.append("追踪图谱缺失或异常。")
        elif trace_state == "空":
            warnings.append("当前没有有效追踪关系。")

    if scope in {"full", "docs", "gate", "delivery"}:
        if task_state in {"缺失", "占位"}:
            issues.append("活跃任务的 0.5 人天工作块仍缺失或占位过多。")
        elif task_state == "关注":
            warnings.append("活跃任务中仍有部分人天工作块拆解不够细。")

    if scope in {"full", "locks", "gate", "delivery"} and lock_info.get("locked"):
        warnings.append("诊断开始时项目锁处于占用状态。")

    if scope in {"full", "gate", "delivery"} and blocked_count > 0:
        warnings.append(f"存在 {blocked_count} 个阻塞工作项。")
    if scope in {"full", "gate", "delivery"} and risk_count > 0:
        warnings.append(f"存在 {risk_count} 个开放风险。")

    if issues:
        result = "未通过"
    elif warnings:
        result = "关注"
    else:
        result = "通过"

    suggestions = []
    if rules_state in {"缺失", "污染"}:
        suggestions.append("刷新 `AGENTS.md` / `GEMINI.md`，并把安装、构建、测试、运行结论迁移到 `.factory/project.json`、`.factory/memory/current-state.md` 和阶段文档。")
    if doc_state in {"缺失", "占位"}:
        suggestions.append("优先补齐当前阶段关键文档，并完成单文件版本更新。")
    if docs_source_state != "就绪":
        suggestions.append(
            "改用 `document-templates` skill 修正文档结构，再执行 `uvx --from docs-stratego docs-stratego source validate --repo-path <项目路径>` 做合规校验。"
        )
    if memory_state in {"缺失", "滞后"}:
        suggestions.append("执行 `factory-dispatch memory --project <项目路径>` 刷新 AI 记忆。")
    if trace_state in {"缺失", "异常", "空"}:
        suggestions.append("执行 `factory-dispatch trace ...` 补齐需求到任务/测试/设计的追踪关系。")
    if task_state in {"缺失", "占位", "关注"}:
        suggestions.append("执行 `factory-dispatch workblock-refine --project <项目路径> --all-active` 修复活跃任务的 0.5 人天工作块。")
    if blocked_count > 0:
        suggestions.append("优先解除阻塞工作项，再推进 Gate 或交付动作。")
    if risk_count > 0:
        suggestions.append("逐条检查开放风险是否已分配负责人和缓解措施。")
    if lock_info.get("locked"):
        suggestions.append("如模型会话并发较多，等待当前操作完成后再继续。")
    if not suggestions:
        suggestions.append("当前状态健康，可继续推进下一阶段或高层 profile。")

    return result, suggestions


def build_report(
    project_root: Path,
    config: dict,
    owner: str,
    scope: str,
    note: str,
    lock_info: dict,
    rules_lines: list[str],
    doc_lines: list[str],
    docs_source_lines: list[str],
    memory_lines: list[str],
    trace_lines: list[str],
    task_lines: list[str],
    blocked_lines: list[str],
    risk_lines: list[str],
    result: str,
    suggestions: list[str],
) -> str:
    lines = [
        "# 项目状态诊断报告",
        "",
        f"- 诊断时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 诊断负责人：{owner}",
        f"- 诊断范围：{scope}",
        f"- 当前阶段：{config.get('stage', '未知')}",
        f"- 结果：{result}",
        f"- 备注：{note or '无'}",
        "",
        "## 锁状态",
        "",
        f"- 锁文件：`{lock_info.get('path', '未知')}`",
        f"- 检测开始时是否占用：{'是' if lock_info.get('locked') else '否'}",
        f"- 最近锁原因：{lock_info.get('payload', {}).get('reason', '无')}",
        f"- 最近锁时间：{lock_info.get('payload', {}).get('locked_at', '无')}",
        "",
        "## 规则入口状态",
        "",
        *rules_lines,
        "",
        "## 文档状态",
        "",
        *doc_lines,
        "",
        "## docs-stratego 源文档状态",
        "",
        *docs_source_lines,
        "",
        "## AI 记忆状态",
        "",
        *memory_lines,
        "",
        "## 追踪状态",
        "",
        *trace_lines,
        "",
        "## 任务拆解状态",
        "",
        *task_lines,
        "",
        "## 阻塞与风险",
        "",
        *(blocked_lines or ["- 当前无阻塞工作项。"]),
        *(risk_lines or ["- 当前无开放风险。"]),
        "",
        "## 建议动作",
        "",
        *[f"- {item}" for item in suggestions],
    ]
    return "\n".join(lines).rstrip() + "\n"


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    initial_lock = inspect_project_lock(project_root)

    try:
        config = load_project_config(project_root)
        stage = config.get("stage", "未知")
        items = collect_items(project_root)
        blocked_items = [item for item in items if item["status"] == "阻塞"]
        blocked_lines = [
            f"- `{item['id']}` {item['title']} | 负责人：{item['owner']}" for item in blocked_items[:10]
        ]
        open_risks, _ = read_risks(project_root)

        doc_state, doc_lines = doc_status(project_root, stage)
        rules_state, rules_lines = rules_entry_status(project_root)
        docs_source_state, docs_source_lines = docs_stratego_validate_status(
            project_root,
        )
        memory_state, memory_lines, _ = ai_memory_status(project_root)
        trace_state, trace_lines, _ = trace_status(project_root)
        if args.scope in {"full", "docs", "gate", "delivery"}:
            task_state, task_lines = task_work_block_status(items)
        else:
            task_state, task_lines = "就绪", ["- 本次范围未检查任务拆解。"]
        result, suggestions = determine_result(
            args.scope,
            rules_state,
            doc_state,
            docs_source_state,
            memory_state,
            initial_lock,
            trace_state,
            task_state,
            len(blocked_items),
            len(open_risks),
        )

        report = build_report(
            project_root,
            config,
            args.owner.strip(),
            args.scope,
            args.note.strip(),
            initial_lock,
            rules_lines,
            doc_lines,
            docs_source_lines,
            memory_lines,
            trace_lines,
            task_lines,
            blocked_lines,
            open_risks[:10],
            result,
            suggestions,
        )

        summary_lines = [
            "# 状态诊断摘要",
            "",
            f"- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
            f"- 范围：{args.scope}",
            f"- 结果：{result}",
            f"- 阶段：{stage}",
            f"- 锁占用：{'是' if initial_lock.get('locked') else '否'}",
            "",
            "## 关键发现",
            "",
            *rules_lines,
            *doc_lines,
            *docs_source_lines,
            *memory_lines,
            *trace_lines,
            *task_lines,
            "",
            "## 建议动作",
            "",
            *[f"- {item}" for item in suggestions],
        ]

        with project_lock(project_root, reason="写入状态诊断报告"):
            write_text(project_root / ".factory" / "process" / "state-doctor-report.md", report)
            write_text(project_root / ".factory" / "memory" / "state-doctor.summary.md", "\n".join(summary_lines))

            config = load_project_config(project_root)
            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_state_doctor_at"] = now_text
            config["last_state_doctor_result"] = result
            config.setdefault("state_doctor_runs", []).append(
                {
                    "scope": args.scope,
                    "result": result,
                    "owner": args.owner.strip(),
                    "note": args.note.strip(),
                    "checked_at": now_text,
                }
            )
            save_project_config(project_root, config)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 执行状态诊断，范围：{args.scope}，结果：{result}，负责人：{args.owner.strip()}。",
            )
    except Exception as exc:
        print(f"执行状态诊断失败：{exc}", file=sys.stderr)
        return 1

    print(f"已生成状态诊断报告：{project_root / '.factory' / 'process' / 'state-doctor-report.md'}")
    if args.strict and result != "通过":
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
