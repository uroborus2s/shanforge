#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import append_log_line, find_item_file, parse_list, project_lock, refresh_ai_memory


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="把变更或缺陷同步到日志、测试报告和 AI 记忆。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--item", required=True, help="变更或缺陷编号，例如 CR-001 或 BUG-001。")
    parser.add_argument("--docs", default="", help="本次更新的文档，相对路径逗号分隔。")
    parser.add_argument("--tests", default="", help="本次更新的测试文件或测试说明，逗号分隔。")
    parser.add_argument("--code", default="", help="本次更新的代码文件，逗号分隔。")
    parser.add_argument("--note", default="", help="本次同步说明。")
    parser.add_argument("--status", default="已同步", help="同步结果状态。")
    return parser.parse_args()
def append_section(path: Path, header: str, lines: list[str]) -> None:
    if not path.exists():
        return
    current = path.read_text(encoding="utf-8").rstrip()
    block = [f"## {header}", *lines]
    path.write_text(current + "\n\n" + "\n".join(block) + "\n", encoding="utf-8")
def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    today = datetime.now().strftime("%Y-%m-%d")
    docs = parse_list(args.docs)
    tests = parse_list(args.tests)
    code = parse_list(args.code)

    try:
        with project_lock(project_root, reason=f"同步变更 {args.item.strip()}"):
            item_file = find_item_file(project_root, args.item.strip(), allowed_prefixes={"CR-", "BUG-"})
            append_section(
                item_file,
                "同步记录",
                [
                    f"- 日期：{today}",
                    f"- 状态：{args.status.strip()}",
                    f"- 文档：{'、'.join(docs) if docs else '无'}",
                    f"- 测试：{'、'.join(tests) if tests else '无'}",
                    f"- 代码：{'、'.join(code) if code else '无'}",
                    f"- 备注：{args.note.strip() or '无'}",
                ],
            )

            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {today}: 同步 `{args.item.strip()}`，状态：{args.status.strip()}，文档 {len(docs)} 项，测试 {len(tests)} 项，代码 {len(code)} 项。",
            )
            append_log_line(
                project_root / "docs" / "02-requirements" / "changelog.md",
                f"- {today}: `{args.item.strip()}` 已同步，备注：{args.note.strip() or '无'}。",
            )
            append_log_line(
                project_root / "docs" / "05-quality" / "test-report.md",
                f"- {today}: `{args.item.strip()}` 关联测试同步，测试项：{'、'.join(tests) if tests else '无'}。",
            )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"变更同步失败：{exc}", file=sys.stderr)
        return 1

    print(f"已同步条目：{args.item.strip()}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
