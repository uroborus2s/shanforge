#!/usr/bin/env python3

import argparse
import json
from datetime import datetime
from pathlib import Path
import sys

from factory_core import append_log_line, parse_list, project_lock, refresh_ai_memory


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="维护需求追踪矩阵和 AI 可读追踪图谱。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--source", required=True, help="源项，例如 REQ-001。")
    parser.add_argument("--targets", required=True, help="目标项，逗号分隔，例如 TASK-001,TC-002,docs/03-solution/api-design.md。")
    parser.add_argument("--relation", default="关联", help="关系类型，例如 实现/验证/影响/依赖。")
    parser.add_argument("--owner", default="待记录", help="维护人。")
    parser.add_argument("--status", default="有效", help="关系状态。")
    parser.add_argument("--note", default="", help="补充说明。")
    return parser.parse_args()
def escape_cell(text: str) -> str:
    return text.replace("|", "/")


def infer_type(value: str) -> str:
    if "/" in value or "." in value:
        return "ARTIFACT"
    if "-" in value:
        return value.split("-")[0]
    return "ITEM"


def ensure_traceability_doc(path: Path) -> list[str]:
    if path.exists():
        lines = path.read_text(encoding="utf-8").splitlines()
    else:
        lines = []

    if "## 追踪关系" in lines and "## 更新记录" in lines:
        return lines

    intro = [
        "# 需求追踪矩阵",
        "",
        "把 REQ、NFR、ARCH、API、UI、TASK、TC、CR 和 BUG 记录关联到一个矩阵中。",
        "",
        "## 追踪关系",
        "",
        "| 源项 | 关系 | 目标项 | 状态 | 更新时间 | 负责人 | 备注 |",
        "|---|---|---|---|---|---|---|",
        "",
        "## 更新记录",
        "",
    ]
    return intro


def parse_existing_rows(lines: list[str]) -> tuple[dict[tuple[str, str, str], dict], list[str]]:
    rows = {}
    history_lines = []
    in_table = False
    in_history = False

    for line in lines:
        if line == "## 追踪关系":
            in_table = True
            in_history = False
            continue
        if line == "## 更新记录":
            in_table = False
            in_history = True
            continue
        if in_table and line.startswith("| ") and not line.startswith("|---"):
            parts = [part.strip() for part in line.split("|")]
            if len(parts) >= 8:
                if parts[1] == "源项" and parts[2] == "关系":
                    continue
                row = {
                    "source": parts[1],
                    "relation": parts[2],
                    "target": parts[3],
                    "status": parts[4],
                    "updated_at": parts[5],
                    "owner": parts[6],
                    "note": parts[7],
                }
                rows[(row["source"], row["relation"], row["target"])] = row
        if in_history and line.startswith("- "):
            history_lines.append(line)
    return rows, history_lines


def write_traceability_doc(path: Path, rows: dict, history_lines: list[str]) -> None:
    ordered = sorted(rows.values(), key=lambda item: (item["source"], item["relation"], item["target"]))
    lines = [
        "# 需求追踪矩阵",
        "",
        "把 REQ、NFR、ARCH、API、UI、TASK、TC、CR 和 BUG 记录关联到一个矩阵中。",
        "",
        "## 追踪关系",
        "",
        "| 源项 | 关系 | 目标项 | 状态 | 更新时间 | 负责人 | 备注 |",
        "|---|---|---|---|---|---|---|",
    ]
    for row in ordered:
        lines.append(
            "| {source} | {relation} | {target} | {status} | {updated_at} | {owner} | {note} |".format(
                source=escape_cell(row["source"]),
                relation=escape_cell(row["relation"]),
                target=escape_cell(row["target"]),
                status=escape_cell(row["status"]),
                updated_at=escape_cell(row["updated_at"]),
                owner=escape_cell(row["owner"]),
                note=escape_cell(row["note"] or "无"),
            )
        )
    lines.extend(["", "## 更新记录", ""])
    lines.extend(history_lines or ["- 暂无记录。"])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def update_graph(path: Path, source: str, targets: list[str], relation: str, owner: str, status: str, note: str) -> dict:
    if path.exists():
        graph = json.loads(path.read_text(encoding="utf-8"))
    else:
        graph = {"updated_at": "", "nodes": [], "edges": []}

    nodes = {node["id"]: node for node in graph.get("nodes", [])}
    edges = {(edge["source"], edge["relation"], edge["target"]): edge for edge in graph.get("edges", [])}

    nodes[source] = {"id": source, "type": infer_type(source)}
    for target in targets:
        nodes[target] = {"id": target, "type": infer_type(target)}
        edges[(source, relation, target)] = {
            "source": source,
            "relation": relation,
            "target": target,
            "status": status,
            "owner": owner,
            "note": note,
            "updated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        }

    graph["updated_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    graph["nodes"] = sorted(nodes.values(), key=lambda item: item["id"])
    graph["edges"] = sorted(edges.values(), key=lambda item: (item["source"], item["relation"], item["target"]))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(graph, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return graph


def write_summary(path: Path, graph: dict) -> None:
    lines = [
        "# 追踪摘要",
        "",
        f"- 更新时间：{graph.get('updated_at', '未知')}",
        f"- 节点数：{len(graph.get('nodes', []))}",
        f"- 关系数：{len(graph.get('edges', []))}",
        "",
        "## 最新追踪关系",
        "",
    ]
    edges = graph.get("edges", [])[-20:]
    if edges:
        for edge in edges:
            lines.append(
                f"- `{edge['source']}` --{edge['relation']}--> `{edge['target']}` | 状态：{edge['status']} | 负责人：{edge['owner']}"
            )
    else:
        lines.append("- 暂无追踪关系。")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")
def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    source = args.source.strip()
    targets = parse_list(args.targets)

    try:
        with project_lock(project_root, reason=f"更新追踪关系 {source}"):
            trace_path = project_root / "docs" / "traceability" / "requirements-matrix.md"
            lines = ensure_traceability_doc(trace_path)
            rows, history_lines = parse_existing_rows(lines)
            now_text = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            for target in targets:
                rows[(source, args.relation.strip(), target)] = {
                    "source": source,
                    "relation": args.relation.strip(),
                    "target": target,
                    "status": args.status.strip(),
                    "updated_at": now_text,
                    "owner": args.owner.strip(),
                    "note": args.note.strip() or "无",
                }
            history_line = (
                f"- {now_text}: 更新源项 `{source}` 的追踪关系，目标 {len(targets)} 项，"
                f"关系：{args.relation.strip()}，维护人：{args.owner.strip()}。"
            )
            history_lines = [line for line in history_lines if line != "- 暂无记录。"]
            if history_line not in history_lines:
                history_lines.insert(0, history_line)
            write_traceability_doc(trace_path, rows, history_lines)

            graph = update_graph(
                project_root / ".factory" / "memory" / "graph" / "traceability.json",
                source=source,
                targets=targets,
                relation=args.relation.strip(),
                owner=args.owner.strip(),
                status=args.status.strip(),
                note=args.note.strip(),
            )
            write_summary(project_root / ".factory" / "memory" / "traceability.summary.md", graph)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 更新追踪关系，源项 `{source}`，目标 {len(targets)} 项，关系：{args.relation.strip()}。",
            )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"更新追踪关系失败：{exc}", file=sys.stderr)
        return 1

    print(f"已更新追踪关系：{source} -> {len(targets)} 项")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
