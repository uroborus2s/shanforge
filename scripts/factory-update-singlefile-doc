#!/usr/bin/env python3

import argparse
import re
from datetime import datetime
from pathlib import Path
import sys

from factory_core import append_log_line, project_lock, refresh_ai_memory


VERSION_PATTERN = re.compile(r"\*\*当前版本：\*\*\s*(v(\d+)\.(\d+))")
STATUS_PATTERN = re.compile(r"\*\*当前状态：\*\*\s*(.*)")
UPDATED_PATTERN = re.compile(r"\*\*最后更新：\*\*\s*(.*)")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="按单文件版本演化规则更新正式文档。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--doc", required=True, help="要更新的文档相对路径，例如 docs/02-requirements/prd.md。")
    parser.add_argument("--summary", required=True, help="本次变更摘要。")
    parser.add_argument("--related", default="无", help="关联项，例如 REQ-001,CR-003。")
    parser.add_argument("--status", default="", help="文档状态，例如 草稿/评审中/已批准。")
    parser.add_argument("--approver", default="", help="审批人。")
    parser.add_argument("--bump", choices=["patch", "major"], default="patch", help="版本增长方式。")
    return parser.parse_args()


def ensure_doc(path: Path) -> None:
    if not path.exists():
        raise RuntimeError(f"文档不存在：{path}")


def bump_version(current: str, mode: str) -> str:
    match = re.match(r"v(\d+)\.(\d+)", current)
    if not match:
        return "v1.0"
    major = int(match.group(1))
    minor = int(match.group(2))
    if mode == "major":
        return f"v{major + 1}.0"
    return f"v{major}.{minor + 1}"


def bootstrap_doc(path: Path) -> list[str]:
    title = path.stem.replace("-", " ").strip() or "正式文档"
    today = datetime.now().strftime("%Y-%m-%d")
    return [
        f"# {title}",
        "",
        "**当前版本：** v1.0",
        "**当前状态：** 草稿",
        f"**最后更新：** {today}",
        "",
        "## 当前内容",
        "",
        "待补充。",
        "",
        "## 版本变更记录",
        "",
        "| 版本 | 日期 | 变更摘要 | 关联项 |",
        "|---|---|---|---|",
        f"| v1.0 | {today} | 初始建立 | 无 |",
        "",
        "## 审批记录",
        "",
        "- 待补充。",
    ]


def normalize_existing_doc(path: Path, lines: list[str]) -> tuple[list[str], bool]:
    today = datetime.now().strftime("%Y-%m-%d")
    if any(VERSION_PATTERN.match(line) for line in lines):
        return lines, False

    title_line = lines[0] if lines and lines[0].startswith("# ") else f"# {path.stem.replace('-', ' ').strip() or '正式文档'}"
    body_lines = lines[1:] if lines and lines[0].startswith("# ") else lines
    body = [line for line in body_lines if line.strip()]
    if not body:
        body = ["待补充。"]

    normalized = [
        title_line,
        "",
        "**当前版本：** v1.0",
        "**当前状态：** 草稿",
        f"**最后更新：** {today}",
        "",
        "## 当前内容",
        "",
        *body,
        "",
        "## 版本变更记录",
        "",
        "| 版本 | 日期 | 变更摘要 | 关联项 |",
        "|---|---|---|---|",
        f"| v1.0 | {today} | 初始整理为单文件版本文档 | 无 |",
        "",
        "## 审批记录",
        "",
        "- 待补充。",
    ]
    return normalized, True


def ensure_sections(lines: list[str]) -> list[str]:
    joined = "\n".join(lines)
    today = datetime.now().strftime("%Y-%m-%d")
    if "## 版本变更记录" not in joined:
        lines.extend(
            [
                "",
                "## 版本变更记录",
                "",
                "| 版本 | 日期 | 变更摘要 | 关联项 |",
                "|---|---|---|---|",
                f"| v1.0 | {today} | 初始建立 | 无 |",
            ]
        )
    if "## 审批记录" not in joined:
        lines.extend(["", "## 审批记录", "", "- 待补充。"])
    return lines


def update_lines(lines: list[str], summary: str, related: str, status: str, approver: str, bump: str) -> list[str]:
    today = datetime.now().strftime("%Y-%m-%d")
    version_found = False
    status_found = False
    updated_found = False
    current_version = "v1.0"

    for line in lines:
        match = VERSION_PATTERN.match(line)
        if match:
            current_version = match.group(1)
            version_found = True
            break

    next_version = bump_version(current_version, bump) if version_found else "v1.0"

    updated_lines = []
    for line in lines:
        if VERSION_PATTERN.match(line):
            updated_lines.append(f"**当前版本：** {next_version}")
            version_found = True
            continue
        if STATUS_PATTERN.match(line):
            updated_lines.append(f"**当前状态：** {status or STATUS_PATTERN.match(line).group(1)}")
            status_found = True
            continue
        if UPDATED_PATTERN.match(line):
            updated_lines.append(f"**最后更新：** {today}")
            updated_found = True
            continue
        updated_lines.append(line)

    if not version_found:
        updated_lines.insert(2, f"**当前版本：** {next_version}")
    if not status_found:
        updated_lines.insert(3, f"**当前状态：** {status or '草稿'}")
    if not updated_found:
        updated_lines.insert(4, f"**最后更新：** {today}")

    updated_lines = ensure_sections(updated_lines)

    record_header = "## 版本变更记录"
    header_index = updated_lines.index(record_header)
    table_separator_index = header_index + 3
    updated_lines.insert(table_separator_index + 1, f"| {next_version} | {today} | {summary} | {related} |")

    if approver:
        approval_header = "## 审批记录"
        approval_index = updated_lines.index(approval_header)
        updated_lines.insert(approval_index + 2, f"- {today}: 审批人 `{approver}`，说明：{summary}")

    return updated_lines


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    doc_path = (project_root / args.doc).resolve()

    try:
        with project_lock(project_root, reason=f"更新正式文档 {args.doc}"):
            if doc_path.exists():
                lines, bootstrapped = normalize_existing_doc(
                    doc_path,
                    doc_path.read_text(encoding="utf-8").splitlines(),
                )
            else:
                lines = bootstrap_doc(doc_path)
                bootstrapped = True
            updated = update_lines(
                lines,
                summary=args.summary.strip(),
                related=args.related.strip() or "无",
                status=args.status.strip(),
                approver=args.approver.strip(),
                bump="patch" if bootstrapped and args.bump == "patch" else args.bump,
            )
            doc_path.write_text("\n".join(updated).rstrip() + "\n", encoding="utf-8")

            relative = doc_path.relative_to(project_root)
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 更新正式文档 `{relative}`，摘要：{args.summary.strip()}。",
            )
            if str(relative).startswith("docs/02-requirements/"):
                append_log_line(
                    project_root / "docs" / "02-requirements" / "changelog.md",
                    f"- {datetime.now().strftime('%Y-%m-%d')}: 更新 `{relative.name}`，摘要：{args.summary.strip()}，关联：{args.related.strip() or '无'}。",
                )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"更新单文件文档失败：{exc}", file=sys.stderr)
        return 1

    print(f"已更新单文件文档：{doc_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
