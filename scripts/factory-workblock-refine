#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import (
    CLOSED_STATUSES,
    append_log_line,
    collect_items,
    find_item_file,
    format_effort_days,
    generate_work_blocks,
    parse_effort_days,
    parse_list,
    parse_work_blocks,
    parse_work_item,
    prepend_history_entry,
    project_lock,
    refresh_ai_memory,
    render_work_block_table,
    replace_section,
    write_text,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="修复已有工作项的人天工作块拆解质量。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument("--item", default="", help="单个工作项编号，例如 TASK-001。")
    parser.add_argument("--items", default="", help="多个工作项编号，逗号分隔。")
    parser.add_argument("--all-active", action="store_true", help="修复所有未关闭工作项。")
    parser.add_argument("--owner", default="待记录", help="执行人。")
    parser.add_argument("--note", default="", help="补充说明。")
    return parser.parse_args()


def infer_item_type(item_id: str) -> str:
    if item_id.startswith("CR-"):
        return "change"
    if item_id.startswith("BUG-"):
        return "bug"
    return "task"


def target_ids(project_root: Path, raw_item: str, raw_items: str, all_active: bool) -> list[str]:
    selected = parse_list(raw_items)
    if raw_item.strip():
        selected.insert(0, raw_item.strip())
    if all_active:
        selected.extend(
            item["id"]
            for item in collect_items(project_root)
            if item["status"] not in CLOSED_STATUSES
        )
    deduped: list[str] = []
    seen = set()
    for item_id in selected:
        normalized = item_id.strip()
        if not normalized or normalized in seen:
            continue
        seen.add(normalized)
        deduped.append(normalized)
    if not deduped:
        raise RuntimeError("请通过 --item、--items 或 --all-active 指定要修复的工作项。")
    return deduped


def replace_total_effort(path: Path, effort_days: float) -> None:
    lines = path.read_text(encoding="utf-8").splitlines()
    replacement = f"- 预估总人天：{format_effort_days(effort_days)}"
    for index, line in enumerate(lines):
        if line.startswith("- 预估总工时：") or line.startswith("- 预估总人天："):
            lines[index] = replacement
            write_text(path, "\n".join(lines))
            return
    insert_at = 0
    for index, line in enumerate(lines):
        if line.startswith("- 负责人："):
            insert_at = index + 1
            break
    lines.insert(insert_at, replacement)
    write_text(path, "\n".join(lines))


def build_refined_blocks(path: Path, item_id: str, item_type: str, effort_days: float, item_title: str) -> list[dict]:
    existing = parse_work_blocks(path)
    generated = generate_work_blocks(effort_days, item_id, item_type, item_title=item_title)
    preserve_details = len(existing) == len(generated)
    for index, block in enumerate(generated):
        if index >= len(existing):
            continue
        old = existing[index]
        if preserve_details and old.get("status") and old["status"] != "待开始":
            block["status"] = old["status"]
        if preserve_details and old.get("hours"):
            block["hours"] = old["hours"]
        old_title = old.get("title", "").strip()
        if preserve_details and old_title and not old_title.startswith("补充工作块 "):
            block["title"] = old_title
    return generated


def refine_item(path: Path, owner: str, note: str) -> tuple[str, int]:
    item = parse_work_item(path)
    item_id = item["id"]
    item_type = infer_item_type(item_id)
    effort_days = parse_effort_days(item.get("hours", 0.5))
    replace_total_effort(path, effort_days)
    refined_blocks = build_refined_blocks(path, item_id, item_type, effort_days, item.get("title", item_id))
    replace_section(path, "## 工作块", render_work_block_table(refined_blocks))
    history_line = (
        f"- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: 重构人天工作块，执行人：{owner}"
        f"{f'，备注：{note}' if note else ''}"
    )
    prepend_history_entry(path, "## 执行记录", history_line)
    return item_id, len(refined_blocks)


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    owner = args.owner.strip() or "待记录"
    note = args.note.strip()

    try:
        with project_lock(project_root, reason="修复人天工作块拆解质量"):
            ids = target_ids(project_root, args.item, args.items, args.all_active)
            updated: list[tuple[str, int]] = []
            for item_id in ids:
                item_path = find_item_file(project_root, item_id)
                updated.append(refine_item(item_path, owner, note))

            summary_ids = "、".join(item_id for item_id, _ in updated[:10])
            if len(updated) > 10:
                summary_ids += f" 等 {len(updated)} 项"
            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {datetime.now().strftime('%Y-%m-%d')}: 修复人天工作块拆解，覆盖 {len(updated)} 个工作项：{summary_ids}。",
            )
            refresh_ai_memory(project_root)
    except Exception as exc:
        print(f"修复工作块拆解失败：{exc}", file=sys.stderr)
        return 1

    print(f"已修复人天工作块拆解：{len(updated)} 个工作项")
    for item_id, block_count in updated:
        print(f"- {item_id}: {block_count} 个工作块")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
