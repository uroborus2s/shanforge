#!/usr/bin/env python3

import argparse
from datetime import datetime
from pathlib import Path
import sys

from factory_core import append_log_line, load_project_config, project_lock, run_script, save_project_config


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="执行高层工作流编排，供对话式 CLI Agent 直接触发。")
    parser.add_argument("--project", required=True, help="项目根目录。")
    parser.add_argument(
        "--workflow",
        required=True,
        choices=["pre_gate", "daily_close", "release_ready", "handover_ready"],
        help="要执行的高层工作流。",
    )
    parser.add_argument("--owner", default="待记录", help="发起人。")
    parser.add_argument("--note", default="", help="补充说明。")
    parser.add_argument("--focus", default="", help="日报或工作流重点说明。")
    parser.add_argument("--strict", action="store_true", help="若工作流结果不是通过，则返回非 0。")
    return parser.parse_args()
def determine_result(workflow: str, config: dict, steps: list[dict]) -> tuple[str, list[str]]:
    suggestions: list[str] = []
    if any(step["returncode"] == 1 for step in steps):
        return "失败", ["至少有一个底层命令执行失败，请先修复命令报错。"]

    if workflow == "pre_gate":
        stage_result = config.get("last_stage_check_result", "未知")
        quality_result = config.get("last_quality_check_result", "未知")
        if stage_result == "通过" and quality_result == "通过":
            result = "通过"
            suggestions.append("阶段检查和质量检查均通过，可以进入 Gate 评审。")
        elif "未通过" in {stage_result, quality_result}:
            result = "未通过"
            suggestions.append("至少一个检查未通过，应先补齐文档、解除阻塞或处理风险。")
        else:
            result = "关注"
            suggestions.append("检查结果为关注，建议先查看最新报告中的建议动作。")
    else:
        result = "完成"
        if workflow == "daily_close":
            suggestions.append("已生成当日收尾产物，可继续下一轮协作。")
        if workflow == "release_ready":
            suggestions.append("已生成交付与交接相关产物，建议人工复核后对外交付。")
        if workflow == "handover_ready":
            suggestions.append("已生成交接材料和快照，可用于换人或换 Agent 接手。")
    return result, suggestions


def build_steps(project_root: Path, workflow: str, owner: str, note: str, focus: str) -> list[tuple[str, list[str], str]]:
    project = str(project_root)
    focus_text = focus or note or "工作流自动收尾"
    steps: list[tuple[str, list[str], str]] = []

    if workflow == "pre_gate":
        steps.append(("factory-stage-check", ["--project", project, "--owner", owner, "--note", note or "workflow-runner: pre_gate"], "阶段检查"))
        steps.append(("factory-quality-check", ["--project", project, "--owner", owner, "--scope", "full", "--note", note or "workflow-runner: pre_gate"], "质量检查"))
    elif workflow == "daily_close":
        steps.append(("factory-refresh-memory", ["--project", project], "刷新 AI 记忆"))
        steps.append(("factory-daily-status", ["--project", project, "--owner", owner, "--focus", focus_text], "生成每日报告"))
        steps.append(("factory-project-snapshot", ["--project", project, "--owner", owner, "--note", note or "workflow-runner: daily_close"], "生成项目快照"))
    elif workflow == "release_ready":
        steps.extend(build_steps(project_root, "pre_gate", owner, note or "workflow-runner: release_ready", focus))
        steps.append(("factory-daily-status", ["--project", project, "--owner", owner, "--focus", focus_text or "发布前收尾"], "生成每日报告"))
        steps.append(("factory-release-pack", ["--project", project, "--owner", owner, "--note", note or "workflow-runner: release_ready"], "生成发布包"))
        steps.append(("factory-handover-pack", ["--project", project, "--owner", owner, "--note", note or "workflow-runner: release_ready"], "生成交接包"))
        steps.append(("factory-project-snapshot", ["--project", project, "--owner", owner, "--note", note or "workflow-runner: release_ready"], "生成项目快照"))
    elif workflow == "handover_ready":
        steps.append(("factory-daily-status", ["--project", project, "--owner", owner, "--focus", focus_text or "准备交接"], "生成每日报告"))
        steps.append(("factory-handover-pack", ["--project", project, "--owner", owner, "--note", note or "workflow-runner: handover_ready"], "生成交接包"))
        steps.append(("factory-project-snapshot", ["--project", project, "--owner", owner, "--note", note or "workflow-runner: handover_ready"], "生成项目快照"))

    return steps


def write_report(path: Path, workflow: str, owner: str, note: str, result: str, steps: list[dict], suggestions: list[str], history_line: str) -> None:
    if path.exists():
        lines = path.read_text(encoding="utf-8").splitlines()
    else:
        lines = ["# 工作流运行记录", ""]

    latest_lines = [
        f"- 工作流：{workflow}",
        f"- 运行结果：{result}",
        f"- 发起人：{owner}",
        f"- 运行时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 说明：{note or '无'}",
    ]
    step_lines = []
    for step in steps:
        status = "成功" if step["returncode"] == 0 else f"失败({step['returncode']})"
        step_lines.append(f"- {step['label']}：{status}")
        if step["stdout"]:
            step_lines.append(f"  输出：{step['stdout']}")
        if step["stderr"]:
            step_lines.append(f"  错误：{step['stderr']}")
    suggestion_lines = [f"- {item}" for item in suggestions]

    sections = {
        "## 最新运行": latest_lines,
        "## 步骤结果": step_lines or ["- 无"],
        "## 建议动作": suggestion_lines or ["- 无"],
    }
    for header, content in sections.items():
        if header in lines:
            start = lines.index(header)
            end = len(lines)
            for index in range(start + 1, len(lines)):
                if lines[index].startswith("## "):
                    end = index
                    break
            lines = lines[: start + 1] + [""] + content + [""] + lines[end:]
        else:
            if lines and lines[-1] != "":
                lines.append("")
            lines.extend([header, "", *content, ""])

    history_header = "## 历史运行记录"
    if history_header in lines:
        start = lines.index(history_header)
        insert_at = start + 2 if start + 1 < len(lines) and lines[start + 1] == "" else start + 1
        if history_line not in lines:
            lines.insert(insert_at, history_line)
    else:
        if lines and lines[-1] != "":
            lines.append("")
        lines.extend([history_header, "", history_line, ""])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def write_summary(path: Path, workflow: str, result: str, steps: list[dict], suggestions: list[str]) -> None:
    lines = [
        "# 工作流运行摘要",
        "",
        f"- 工作流：{workflow}",
        f"- 结果：{result}",
        f"- 运行时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        "",
        "## 步骤结果",
        "",
    ]
    for step in steps:
        lines.append(f"- {step['label']}：{'成功' if step['returncode'] == 0 else f'失败({step['returncode']})'}")
    lines.extend(["", "## 建议动作", ""])
    lines.extend(f"- {item}" for item in suggestions)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def main() -> int:
    args = parse_args()
    project_root = Path(args.project).expanduser().resolve()
    today = datetime.now().strftime("%Y-%m-%d")

    try:
        with project_lock(project_root, reason=f"执行工作流 {args.workflow}"):
            config = load_project_config(project_root)
            steps = []
            for script_name, command_args, label in build_steps(project_root, args.workflow, args.owner.strip(), args.note.strip(), args.focus.strip()):
                steps.append(run_script(script_name, *command_args, label=label))

            config = load_project_config(project_root)
            result, suggestions = determine_result(args.workflow, config, steps)
            history_line = f"- {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}: 工作流 `{args.workflow}` 执行结果 `{result}`，发起人：{args.owner.strip()}。"

            write_report(
                project_root / ".factory" / "process" / "workflow-runs.md",
                workflow=args.workflow,
                owner=args.owner.strip(),
                note=args.note.strip(),
                result=result,
                steps=steps,
                suggestions=suggestions,
                history_line=history_line,
            )
            write_summary(project_root / ".factory" / "memory" / "workflow-runner.summary.md", args.workflow, result, steps, suggestions)

            config.setdefault("workflow_runs", []).append(
                {
                    "workflow": args.workflow,
                    "result": result,
                    "owner": args.owner.strip(),
                    "note": args.note.strip(),
                    "ran_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                }
            )
            config["last_workflow_run_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            config["last_workflow_run_name"] = args.workflow
            config["last_workflow_run_result"] = result
            save_project_config(project_root, config)

            append_log_line(
                project_root / ".factory" / "process" / "execution-log.md",
                f"- {today}: 执行工作流 `{args.workflow}`，结果：{result}，发起人：{args.owner.strip()}。",
            )
    except Exception as exc:
        print(f"执行工作流失败：{exc}", file=sys.stderr)
        return 1

    print(f"已执行工作流：{args.workflow} -> {result}")
    if args.strict and result not in {"通过", "完成"}:
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
