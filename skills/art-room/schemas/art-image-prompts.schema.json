{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Art Room Image Prompts",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "prompts"],
  "properties": {
    "version": {
      "type": "string"
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "prompt_id",
          "asset_id",
          "asset_type",
          "output_path",
          "prompt",
          "negative_prompt_notes",
          "continuity_refs",
          "source_refs"
        ],
        "properties": {
          "prompt_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_type": {
            "type": "string",
            "enum": ["character", "location", "prop", "costume", "style", "reference_frame"]
          },
          "output_path": {
            "type": "string",
            "pattern": "^(assets/|[0-9]{2}/assets/)",
            "allOf": [
              {
                "not": {
                  "pattern": "(^|/)(v[0-9]+|versions?|drafts?)(/|$)"
                }
              },
              {
                "not": {
                  "pattern": "(^|/)history/"
                }
              },
              {
                "not": {
                  "pattern": "\\.v[0-9]{3}\\.[^/]+$"
                }
              }
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "negative_prompt_notes": {
            "type": "string"
          },
          "continuity_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
