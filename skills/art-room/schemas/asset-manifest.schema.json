{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Art Room Asset Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "assets"],
  "properties": {
    "version": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "asset_id",
          "asset_type",
          "name",
          "output_path",
          "source_refs",
          "continuity_refs",
          "usage"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_type": {
            "type": "string",
            "enum": ["character", "location", "prop", "costume", "style", "reference_frame"]
          },
          "name": {
            "type": "string"
          },
          "output_path": {
            "type": "string",
            "pattern": "^(assets/|[0-9]{2}/assets/)"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "continuity_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
