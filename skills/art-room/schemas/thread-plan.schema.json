{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Art Room Thread Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "batches"],
  "properties": {
    "version": {
      "type": "string"
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "batch_id",
          "batch_type",
          "prompt_ids",
          "output_paths",
          "thread_prompt"
        ],
        "properties": {
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "batch_type": {
            "type": "string",
            "enum": ["characters", "locations", "props-costumes", "style", "reference-frames"]
          },
          "prompt_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(assets/|[0-9]{2}/assets/)"
            }
          },
          "thread_prompt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
